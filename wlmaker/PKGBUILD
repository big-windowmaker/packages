# Maintainer: Big WindowMaker <https://github.com/big-windowmaker>
# Baseado no PKGBUILD do AUR (wlmaker), de Adrian Perez de Castro.

# Snapshot do `main` do upstream (desenvolvimento da 0.9), fixado no commit
# 7481afe, 80 commits depois da tag v0.8. O `pkgver` segue o estilo VCS do
# Arch (`git describe`, conferido em prepare()); como 0.8.r80 < 0.8.1 para o
# `vercmp`, o `epoch=1` evita que o pacote seja tratado como downgrade da
# 0.8.1.
#
# Os submódulos usados no build (libbase e inih) entram como fontes
# separadas, fixadas nos commits registrados na árvore do 7481afe, e são
# ligados via `git config` (padrão Arch).
#
# Patches: `git format-patch` da branch big-wm/protocols do fork
# big-windowmaker/wlmaker, um commit por mudança, a enviar ao upstream.
#   0001  xdg-activation-v1 (ativa e levanta a janela pedida)
#   0002  org_kde_kwin_server_decoration (decoração do wlmaker no GTK3)
#   0003  bloqueio de tela: um novo swaylock assume um bloqueio abandonado
#   0004  bloqueio de tela: encerra os grabs (menus/popups) ao bloquear
#   0005  foco de teclado também sem teclado no seat (hotplug, teclado virtual)
#   0006  presentation-time
#   0007  single-pixel-buffer-v1
#   0008  xdg-foreign v1 e v2 (diálogos do xdg-desktop-portal)
#   0009  ext-idle-notify-v1 (swayidle), respeitando idle-inhibit
#   0010  wlr-gamma-control-unstable-v1 (wlsunset, gammastep)
#   0011  wlr-output-power-management-unstable-v1 (DPMS, wlopm)
#   0012  relative-pointer-unstable-v1
#   0013  wlr-virtual-pointer-unstable-v1
#   0014  virtual-keyboard-unstable-v1
#   0015  menu de clique direito: um clique rápido não dispara mais o item
#         sob o ponteiro; o menu fica aberto, como no Window Maker
#   0016  dockapps não fecham mais quando o seat não tem ponteiro
#   0017  opção --lazy_xwayland (XWayland só sobe no primeiro cliente X11)
#   0018  wlmdock: AppID opcional nos lançadores (State.plist da 0.8)
#   0019  duplo clique na barra de título enrola a janela (shade)
#   0020  miniaturizar janelas (botão, menu da janela, pedido do cliente)
#   0021  menu da janela e miniaturizar também nas janelas XWayland
#   0022  ordem dos dockapps no Clip (Clip.Dockapps) e arrastar com Alt,
#         ordem salva em ~/.config/wlmaker/Dockapps.plist
#   0023  `wlmdock --clip`: lançadores (Clip.Launchers) logo abaixo do Clip
#   0024  correção de vazamento num teste do lock_mgr
pkgname=wlmaker
pkgver=0.8.r80.g7481afe
pkgrel=2
epoch=1
_commit=7481afe45a8beb8bf5c181fdb4034c00f6eba760
_libbase_commit=1a58652fd88fcca5d9f33d8d078434f2dc30c30b
_inih_commit=26254ee9de7681f8825433415443e7116ff24b98
pkgdesc='Wayland compositor inspired by Window Maker'
arch=(x86_64)
url='https://github.com/phkaeser/wlmaker'
license=('Apache-2.0 AND BSD-3-Clause')
depends=(
  cairo
  glibc
  hicolor-icon-theme
  libinput
  libxcb
  libxdg-basedir
  libxkbcommon
  wayland
  wlroots0.20
  xorg-xwayland  # suporte a XWayland (habilitado quando xwayland.pc existe)
)
makedepends=(
  cmake
  git
  librsvg  # exigido pelo CMake da 0.9; só os exemplos (não instalados) usam
  wayland-protocols
)
checkdepends=(desktop-file-utils)
_patches=(
  0001-server-Adds-support-for-xdg-activation-v1-protocol.patch
  0002-xdg_decoration-Adds-support-for-the-KDE-server-decor.patch
  0003-lock_mgr-Permits-a-new-session-lock-to-take-over-an-.patch
  0004-lock_mgr-Ends-seat-grabs-and-pointer-focus-when-lock.patch
  0005-toolkit-Sets-keyboard-focus-on-activation-also-if-th.patch
  0006-backend-Adds-support-for-presentation-time-protocol.patch
  0007-backend-Adds-support-for-single-pixel-buffer-v1-prot.patch
  0008-xdg_shell-Adds-support-for-xdg-foreign-unstable-v1-a.patch
  0009-idle-Adds-support-for-ext-idle-notify-v1-protocol.patch
  0010-backend-Adds-support-for-wlr-gamma-control-unstable-.patch
  0011-backend-Adds-support-for-wlr-output-power-management.patch
  0012-input-Adds-support-for-relative-pointer-unstable-v1-.patch
  0013-input-Adds-support-for-wlr-virtual-pointer-unstable-.patch
  0014-input-Adds-support-for-virtual-keyboard-unstable-v1-.patch
  0015-toolkit-Keeps-a-right-click-menu-open-when-it-was-op.patch
  0016-wlclient-Creates-the-pointer-observer-only-when-the-.patch
  0017-xwl-Adds-lazy_xwayland-to-start-XWayland-on-the-firs.patch
  0018-dock-Makes-AppID-optional-for-launchers.patch
  0019-toolkit-Toggles-shade-on-double-click-on-the-title-b.patch
  0020-toolkit-Implements-minimizing-miniaturizing-windows.patch
  0021-xwl-Adds-the-window-menu-and-minimizing-for-XWayland.patch
  0022-clip-Places-dock-apps-in-a-configurable-order-re-arr.patch
  0023-dock-Adds-wlmdock-clip-for-launchers-attached-below-.patch
  0024-lock_mgr-Fixes-a-leak-in-the-lock_ends_grabs-test.patch
)
source=(
  "git+https://github.com/phkaeser/wlmaker.git#commit=${_commit}"
  "git+https://github.com/phkaeser/libbase.git#commit=${_libbase_commit}"
  "git+https://github.com/benhoyt/inih.git#commit=${_inih_commit}"
  "${_patches[@]}"
)
