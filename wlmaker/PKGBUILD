arch=(x86_64)
url='https://github.com/phkaeser/wlmaker'
license=('Apache-2.0 AND BSD-3-Clause')
depends=(
  cairo
  glibc
  hicolor-icon-theme
  libglvnd  # libEGL e libGLESv2: o teste do renderizador (0100)
  libinput
  libpulse  # wlmmixer (fala com o pipewire-pulse ou com o PulseAudio)
  libxcb
  libxdg-basedir
  libxkbcommon
  pixman  # wlmdock (área transparente ao redor do menu)
  wayland
  wlroots0.20
  xorg-xwayland  # suporte a XWayland (habilitado quando xwayland.pc existe)
)
makedepends=(
  cmake
  git
  librsvg  # exigido pelo CMake da 0.9; só os exemplos (não instalados) usam
  wayland-protocols
)
checkdepends=(desktop-file-utils)
optdepends=(
  'pavucontrol: mixer completo, aberto pelo clique do meio ou pelo menu do wlmmixer'
  'pipewire-pulse: servidor de som para o wlmmixer'
)
