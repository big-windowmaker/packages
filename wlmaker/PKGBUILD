prepare() {
  cd wlmaker

  # O pkgver tem que bater com o `git describe` do commit fixado.
  local _ver
  _ver="$(git describe --long --tags --abbrev=7 | sed 's/^v//;s/-\([0-9]*\)-/.r\1./;s/-/./g')"
  if [[ ${_ver} != "${pkgver}" ]]; then
    echo "git describe dá ${_ver}, mas pkgver=${pkgver}" >&2
    return 1
  fi

  # Só os submódulos necessários ao build; "dependencies" e
  # "examples/gtk-layer-shell" não são usados no pacote.
  git submodule init submodules/libbase submodules/inih
  git config submodule.submodules/libbase.url "${srcdir}/libbase"
  git config submodule.submodules/inih.url "${srcdir}/inih"
  git -c protocol.file.allow=always submodule update submodules/libbase submodules/inih

  local _patch
  for _patch in "${_patches[@]}"; do
    echo "Aplicando ${_patch}"
    git apply "${srcdir}/${_patch}"
  done
}

build() {
  # config_OPTIM=ON troca o -O0 padrão do upstream por -O2; config_DEBUG=OFF
  # remove -ggdb -DDEBUG (o makepkg cuida dos símbolos de depuração).
  # "Restaurar lançadores padrão" usa o State.plist do big-wm (o que o
  # big-wm-firstrun copia para ~/.config/wlmaker), e o quadrado principal do
  # Dock mostra o logo do Big WindowMaker; o Clip, o clipe do tema Window
  # Maker em SVG (big-wm-wayland), quando o State.plist não tem Clip.Icon.
  # Sem o big-wm instalado, valem o /etc/xdg/wlmaker/State.plist (ou o
  # padrão embutido) e os ícones do wlmaker.
  cmake -S wlmaker -B build \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_BUILD_TYPE=None \
    -Dconfig_DEBUG=OFF \
    -Dconfig_OPTIM=ON \
    -DWLMAKER_DEFAULT_STATE_FILE=/usr/share/big-wm/wlmaker/State.plist \
    -DWLMDOCK_DEFAULT_ICON=/usr/share/WindowMaker/Icons/big-wm-logo.png \
    -DWLMAKER_CLIP_DEFAULT_ICON=big-wm-clip-56x56.png \
    -Wno-dev
  cmake --build build
}

check() {
  # O harness de testes da libbase aborta se tgetent() falhar para o $TERM
  # atual (em contêiner/sudo costuma ser "unknown"); "dumb" sempre existe.
  TERM=dumb ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build

  install -Dm644 -t "$pkgdir/usr/share/doc/$pkgname" wlmaker/etc/*.plist
  install -Dm644 wlmaker/submodules/inih/LICENSE.txt \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.inih"

  # Os dockapps do wlmaker (wlmclock, wlmbattery...) e o wlmdock são
  # clientes Wayland dos protocolos do wlmaker: na sessão X11 e nos outros
  # ambientes eles não abrem, então só aparecem nos menus da sessão wlmaker.
  local _desktop
  for _desktop in "$pkgdir"/usr/share/applications/{wlmaker.*,wlmdock}.desktop; do
    [[ -e $_desktop ]] || continue
    grep -q '^OnlyShowIn=' "$_desktop" ||
      sed -i '0,/^\[Desktop Entry\]$/s//[Desktop Entry]\nOnlyShowIn=wlmaker;/' "$_desktop"
  done

  # O wlmdock (Dock/Clip) e o próprio wlmaker são partes da sessão, não
  # aplicativos: abertos pelo rofi ou pelos menus, criavam um segundo Dock
  # ou um compositor aninhado (visto na VM: dois ladrilhos do logo no Dock).
  # A sessão "WaylandMaker" (wlmaker sem a configuração do Big WindowMaker:
  # sem Dock, dockapps nem bandeja) também sai da tela de login, ao lado de
  # "Big WindowMaker (Wayland)" ela só confundia (escolhida por engano na VM).
  for _desktop in "$pkgdir"/usr/share/applications/{wlmaker,wlmdock}.desktop \
    "$pkgdir"/usr/share/wayland-sessions/wlmaker.desktop; do
    [[ -e $_desktop ]] || continue
    grep -q '^NoDisplay=' "$_desktop" ||
      sed -i '0,/^\[Desktop Entry\]$/s//[Desktop Entry]\nNoDisplay=true/' "$_desktop"
  done
}
