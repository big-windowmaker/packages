  libxkbcommon
  pixman  # wlmdock (área transparente ao redor do menu)
  wayland
  wlroots0.20
  xorg-xwayland  # suporte a XWayland (habilitado quando xwayland.pc existe)
)
makedepends=(
  cmake
  git
  librsvg  # exigido pelo CMake da 0.9; só os exemplos (não instalados) usam
  wayland-protocols
)
checkdepends=(desktop-file-utils)
optdepends=(
  'pavucontrol: mixer completo, aberto pelo clique direito no wlmmixer'
  'pipewire-pulse: servidor de som para o wlmmixer'
)
