From 346982facd44241e86b794eeba278419efc08777 Mon Sep 17 00:00:00 2001
From: ruscher <rruscher@gmail.com>
Date: Tue, 24 Nov 2026 06:31:57 -0300
Subject: [PATCH 182/184] toolkit: Drag modifier moves (left) or resizes
 (right) from anywhere in the window.

wlmtk_window_set_drag_modifier() takes a combination (eg. Ctrl+Alt). With
it held, the left button begins a move and the right one a resize from the
nearest edge or corner; the click never reaches the client. Lock modifiers
(Caps, Num) do not count. The workspace now also ends a move or resize when
the right button is released (it only looked at the left one), so a resize
begun with the right button does not stay on until the next click.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 include/toolkit/window.h    | 12 ++++++++++
 include/toolkit/workspace.h | 11 +++++++++
 src/toolkit/window.c        | 48 +++++++++++++++++++++++++++++++++++++
 src/toolkit/workspace.c     | 17 ++++++++++++-
 4 files changed, 87 insertions(+), 1 deletion(-)

diff --git a/include/toolkit/window.h b/include/toolkit/window.h
index bfb911db..51b176fc 100644
--- a/include/toolkit/window.h
+++ b/include/toolkit/window.h
@@ -564,6 +564,18 @@ void wlmtk_window_set_options(
     wlmtk_window_t *window_ptr,
     uint32_t move_modifier);
 
+/**
+ * Sets a second drag modifier (a combination, eg. Ctrl+Alt): The left button
+ * moves the window, the right one resizes it from the nearest edge or
+ * corner, from anywhere in the window. The click does not reach the client.
+ *
+ * @param window_ptr
+ * @param drag_modifier       WLR_MODIFIER_* bits; 0 turns it off.
+ */
+void wlmtk_window_set_drag_modifier(
+    wlmtk_window_t *window_ptr,
+    uint32_t drag_modifier);
+
 /**
  * Sets @ref wlmtk_window_t::workspace_ptr.
  *
diff --git a/include/toolkit/workspace.h b/include/toolkit/workspace.h
index a1b1cca4..f00b3674 100644
--- a/include/toolkit/workspace.h
+++ b/include/toolkit/workspace.h
@@ -249,6 +249,17 @@ void wlmtk_workspace_begin_window_resize(
     wlmtk_window_t *window_ptr,
     uint32_t edges);
 
+/**
+ * Sets the button whose release ends the next move or resize (BTN_LEFT by
+ * default; back to it when the move or resize ends).
+ *
+ * @param workspace_ptr
+ * @param button              linux/input-event-codes.h
+ */
+void wlmtk_workspace_set_release_button(
+    wlmtk_workspace_t *workspace_ptr,
+    uint32_t button);
+
 /** Acticates `window_ptr`. Will de-activate an earlier window. */
 void wlmtk_workspace_activate_window(
     wlmtk_workspace_t *workspace_ptr,
diff --git a/src/toolkit/window.c b/src/toolkit/window.c
index 34a9e81e..c842b85a 100644
--- a/src/toolkit/window.c
+++ b/src/toolkit/window.c
@@ -110,6 +110,11 @@ struct _wlmtk_window_t {
     uint32_t                  tiled_edges;
     /** Modifier to trigger moving the window, on pointer drag. */
     uint32_t                  move_modifier;
+    /**
+     * Second modifier (combination): Left button moves, right button resizes
+     * from the nearest edge or corner, from anywhere in the window. 0: none.
+     */
+    uint32_t                  drag_modifier;
 
     /**
      * Position of the window, and size of the content window when not in
@@ -976,6 +981,14 @@ void wlmtk_window_set_options(
     window_ptr->move_modifier = move_modifier;
 }
 
+/* ------------------------------------------------------------------------- */
+void wlmtk_window_set_drag_modifier(
+    wlmtk_window_t *window_ptr,
+    uint32_t drag_modifier)
+{
+    window_ptr->drag_modifier = drag_modifier;
+}
+
 /* ------------------------------------------------------------------------- */
 void wlmtk_window_set_workspace(
     wlmtk_window_t *window_ptr,
@@ -1146,6 +1159,41 @@ bool _wlmtk_window_element_pointer_button(
         return rv;
     }
 
+    // Drag modifier (eg. Ctrl+Alt): Left moves, right resizes from the
+    // nearest edge, without the client seeing the click. Lock modifiers
+    // (Caps, Num) do not count.
+    uint32_t mods = button_event_ptr->keyboard_modifiers &
+        ~(uint32_t)(WLR_MODIFIER_CAPS | WLR_MODIFIER_MOD2);
+    if (0 != window_ptr->drag_modifier &&
+        mods == window_ptr->drag_modifier &&
+        NULL != wlmtk_window_get_workspace(window_ptr) &&
+        !window_ptr->fullscreen &&
+        (BTN_LEFT == button_event_ptr->button ||
+         BTN_RIGHT == button_event_ptr->button)) {
+        if (WLMTK_BUTTON_DOWN != button_event_ptr->type) return true;
+        wlmtk_workspace_t *ws_ptr = wlmtk_window_get_workspace(window_ptr);
+        wlmtk_workspace_activate_window(ws_ptr, window_ptr);
+        wlmtk_workspace_raise_window(ws_ptr, window_ptr);
+        if (BTN_LEFT == button_event_ptr->button) {
+            wlmtk_workspace_begin_window_move(ws_ptr, window_ptr);
+            return true;
+        }
+        if (!(window_ptr->properties & WLMTK_WINDOW_PROPERTY_RESIZABLE)) return true;
+        struct wlr_box b = wlmtk_window_get_bounding_box(window_ptr);
+        wlmtk_element_t *e = wlmtk_window_element(window_ptr);
+        double fx = b.width > 0 ? e->last_pointer_motion_event.x / b.width : 1.0;
+        double fy = b.height > 0 ? e->last_pointer_motion_event.y / b.height : 1.0;
+        uint32_t edges = 0;
+        if (fx < 1.0 / 3) edges |= WLR_EDGE_LEFT;
+        if (fx > 2.0 / 3) edges |= WLR_EDGE_RIGHT;
+        if (fy < 1.0 / 3) edges |= WLR_EDGE_TOP;
+        if (fy > 2.0 / 3) edges |= WLR_EDGE_BOTTOM;
+        if (0 == edges) edges = WLR_EDGE_RIGHT | WLR_EDGE_BOTTOM;
+        wlmtk_workspace_set_release_button(ws_ptr, BTN_RIGHT);
+        wlmtk_workspace_begin_window_resize(ws_ptr, window_ptr, edges);
+        return true;
+    }
+
     // Modifier-click initiates move.
     if (0 != window_ptr->move_modifier &&
         BTN_LEFT == button_event_ptr->button &&
diff --git a/src/toolkit/workspace.c b/src/toolkit/workspace.c
index 549ddab9..1ddcc280 100644
--- a/src/toolkit/workspace.c
+++ b/src/toolkit/workspace.c
@@ -94,6 +94,8 @@ struct _wlmtk_workspace_t {
     int                       initial_height;
     /** Edges currently active for resizing: `enum wlr_edges`. */
     uint32_t                  resize_edges;
+    /** Button whose release ends the move or resize (BTN_LEFT by default). */
+    uint32_t                  release_button;
     /** Whether the grab is a move (signals @ref wlmtk_desktop_events_t). */
     bool                      moving;
     /** Whether an interactive resize is going on (for window_resize_end). */
@@ -697,6 +699,14 @@ void wlmtk_workspace_begin_window_resize(
     wlmtk_fsm_event(&workspace_ptr->fsm, PFSME_BEGIN_RESIZE, window_ptr);
 }
 
+/* ------------------------------------------------------------------------- */
+void wlmtk_workspace_set_release_button(
+    wlmtk_workspace_t *workspace_ptr,
+    uint32_t button)
+{
+    workspace_ptr->release_button = button;
+}
+
 /* ------------------------------------------------------------------------- */
 /** Acticates `window_ptr`. Will de-activate an earlier window. */
 void wlmtk_workspace_activate_window(
@@ -967,7 +977,11 @@ bool _wlmtk_workspace_window_element_pointer_button(
     // the move, and then figure out the exit condition (button up? key? ...)
     // from there.
     // See xdg_toplevel::move doc at https://wayland.app/protocols/xdg-shell.
-    if (button_event_ptr->button == BTN_LEFT &&
+    // The button that began it ends it: the left one by default, the right
+    // one for a resize begun by the window's drag modifier (Ctrl+Alt).
+    uint32_t release = 0 != workspace_ptr->release_button ?
+        workspace_ptr->release_button : BTN_LEFT;
+    if (button_event_ptr->button == release &&
         button_event_ptr->type == WLMTK_BUTTON_UP) {
         wlmtk_fsm_event(&workspace_ptr->fsm, PFSME_RELEASED, NULL);
     }
@@ -1448,6 +1462,7 @@ bool pfsm_reset(wlmtk_fsm_t *fsm_ptr, __UNUSED__ void *ud_ptr)
         fsm_ptr, wlmtk_workspace_t, fsm);
 
     wlmtk_window_set_resize_edges(workspace_ptr->grabbed_window_ptr, 0);
+    workspace_ptr->release_button = BTN_LEFT;
 
     if (workspace_ptr->moving) {
         _wlmtk_workspace_emit_move(workspace_ptr, WLMTK_WS_MOVE_END);
-- 
