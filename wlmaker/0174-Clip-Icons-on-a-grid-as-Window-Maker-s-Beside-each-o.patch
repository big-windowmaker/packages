+    if (NULL == moved_dict_ptr) {
+        rv = false;
+        goto done;
+    }
+    moved_ptr = bspl_object_from_dict(moved_dict_ptr);
 
     bspl_array_t *without_ptr = _wlmaker_dock_launchers_edited(
