     if (!rv) goto done;
     bspl_object_t *moved_ptr = bspl_array_at(from_ptr, from_stored);
+    // Its cell on the Clip's grid: The new one there, none elsewhere.
+    moved_dict_ptr = wlmaker_dock_launcher_with_cell(
