From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ruscher <rruscher@gmail.com>
Date: Sat, 7 Nov 2026 03:38:37 -0300
Subject: [PATCH] layer, desktop: Exclusive zones count for the panels of all
 layers

Each layer arranged its panels within its own exclusive zones only:
Windows avoided all of them, but a panel without zone in another layer did
not (eg. the appicons, in the bottom layer, were placed under a dock across
the bottom of the screen, in the top layer). The layer shell protocol has
exclusive zones apply to all layers.

Each layer output keeps what its full-edge exclusive panels leave; the
other panels are placed within that area of all layers (given by the
desktop). When a usable area changes, the desktop rearranges the layers.
Also implements the declared wlmtk_layer_reconfigure().

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 include/toolkit/layer.h | 18 +++++++++++
 src/toolkit/desktop.c   | 17 +++++++---
 src/toolkit/layer.c     | 70 +++++++++++++++++++++++------------------
 3 files changed, 69 insertions(+), 36 deletions(-)

diff --git a/include/toolkit/layer.h b/include/toolkit/layer.h
index 73e3895..8ec00d7 100644
--- a/include/toolkit/layer.h
+++ b/include/toolkit/layer.h
@@ -97,6 +97,24 @@ void wlmtk_layer_reconfigure_output(
     struct wlr_output *wlr_output_ptr,
     struct wlr_box *usable_area_ptr);
 
+/**
+ * One pass of @ref wlmtk_layer_reconfigure_output: Only the panels that span
+ * a full edge with an exclusive zone (`full_edge`), or only the others. The
+ * desktop runs the first pass for all layers before the second, so a panel
+ * avoids the exclusive zones of the panels in every layer.
+ *
+ * @param layer_ptr
+ * @param wlr_output_ptr
+ * @param usable_area_ptr     In: the area left by the panels configured
+ *                            before. Out: minus the exclusive zones of these.
+ * @param full_edge
+ */
+void wlmtk_layer_reconfigure_output_pass(
+    wlmtk_layer_t *layer_ptr,
+    struct wlr_output *wlr_output_ptr,
+    struct wlr_box *usable_area_ptr,
+    bool full_edge);
+
 /**
  * Calls @ref wlmtk_panel_compute_dimensions for each contained panel.
  *
diff --git a/src/toolkit/desktop.c b/src/toolkit/desktop.c
index 5ba084f..033d066 100644
--- a/src/toolkit/desktop.c
+++ b/src/toolkit/desktop.c
@@ -694,11 +694,18 @@ void _wlmtk_desktop_element_layout(wlmtk_element_t *element_ptr)
         wlr_output_layout_get_box(
             desktop_ptr->wlr_output_layout_ptr,
             wlr_output_layout_output_ptr->output, &usable_area);
-        for (int i = 0; i < WLMTK_DESKTOP_LAYER_OVERLAY + 1; ++i) {
-            wlmtk_layer_reconfigure_output(
-                desktop_ptr->layer_ptrs[i],
-                wlr_output_layout_output_ptr->output,
-                &usable_area);
+        // As within a layer, first the panels that span a full edge, in all
+        // layers: Their exclusive zones count for the other panels of every
+        // layer (eg. the appicons, in the bottom layer, stay above a shelf
+        // across the bottom in the top layer).
+        for (int pass = 0; pass < 2; ++pass) {
+            for (int i = 0; i < WLMTK_DESKTOP_LAYER_OVERLAY + 1; ++i) {
+                wlmtk_layer_reconfigure_output_pass(
+                    desktop_ptr->layer_ptrs[i],
+                    wlr_output_layout_output_ptr->output,
+                    &usable_area,
+                    0 == pass);
+            }
         }
 
         // Signals usable_area_changed only when the area changed (a panel
diff --git a/src/toolkit/layer.c b/src/toolkit/layer.c
index d152604..74ae8f7 100644
--- a/src/toolkit/layer.c
+++ b/src/toolkit/layer.c
@@ -193,6 +193,22 @@ void wlmtk_layer_reconfigure_output(
     wlmtk_layer_t *layer_ptr,
     struct wlr_output *wlr_output_ptr,
     struct wlr_box *usable_area_ptr)
+{
+    // Two passes, like Window Maker: First the panels spanning a full edge
+    // of the output with an exclusive zone (eg. a shelf across the bottom),
+    // then the others (eg. the Clip and Dock), within what remains.
+    wlmtk_layer_reconfigure_output_pass(
+        layer_ptr, wlr_output_ptr, usable_area_ptr, true);
+    wlmtk_layer_reconfigure_output_pass(
+        layer_ptr, wlr_output_ptr, usable_area_ptr, false);
+}
+
+/* ------------------------------------------------------------------------- */
+void wlmtk_layer_reconfigure_output_pass(
+    wlmtk_layer_t *layer_ptr,
+    struct wlr_output *wlr_output_ptr,
+    struct wlr_box *usable_area_ptr,
+    bool full_edge)
 {
     wlmtk_layer_output_t *layer_output_ptr = wlmtk_output_tracker_get_output(
         layer_ptr->output_tracker_ptr,
@@ -209,41 +225,33 @@ void wlmtk_layer_reconfigure_output(
         wlr_output_ptr,
         &full_extents);
 
-    // Two passes, like Window Maker: First the panels spanning a full edge
-    // of the output with an exclusive zone (eg. a shelf across the bottom),
-    // then the others (eg. the Clip and Dock), within what remains. In the
-    // order they were added, within each pass. So the result does not depend
-    // on which client mapped first.
-    for (int pass = 0; pass < 2; ++pass) {
-        for (bs_dllist_node_t *dlnode_ptr = layer_output_ptr->panels.head_ptr;
-             dlnode_ptr != NULL;
-             dlnode_ptr = dlnode_ptr->next_ptr) {
-            wlmtk_panel_t *panel_ptr = wlmtk_panel_from_dlnode(dlnode_ptr);
-            if (wlmtk_panel_spans_full_edge(panel_ptr) != (0 == pass)) {
-                continue;
-            }
-
-            struct wlr_box new_usable_area = *usable_area_ptr;
-            struct wlr_box panel_dimensions = wlmtk_panel_compute_dimensions(
-                panel_ptr, &full_extents, &new_usable_area);
-
-            if (wlmtk_panel_element(panel_ptr)->visible) {
-                *usable_area_ptr = new_usable_area;
-            }
-
-            wlmtk_panel_request_size(
-                panel_ptr,
-                panel_dimensions.width,
-                panel_dimensions.height);
-            wlmtk_element_set_position(
-                wlmtk_panel_element(panel_ptr),
-                panel_dimensions.x,
-                panel_dimensions.y);
+    // In the order the panels were added: The result does not depend on
+    // which client mapped first.
+    for (bs_dllist_node_t *dlnode_ptr = layer_output_ptr->panels.head_ptr;
+         dlnode_ptr != NULL;
+         dlnode_ptr = dlnode_ptr->next_ptr) {
+        wlmtk_panel_t *panel_ptr = wlmtk_panel_from_dlnode(dlnode_ptr);
+        if (wlmtk_panel_spans_full_edge(panel_ptr) != full_edge) continue;
+
+        struct wlr_box new_usable_area = *usable_area_ptr;
+        struct wlr_box panel_dimensions = wlmtk_panel_compute_dimensions(
+            panel_ptr, &full_extents, &new_usable_area);
+
+        if (wlmtk_panel_element(panel_ptr)->visible) {
+            *usable_area_ptr = new_usable_area;
         }
+
+        wlmtk_panel_request_size(
+            panel_ptr,
+            panel_dimensions.width,
+            panel_dimensions.height);
+        wlmtk_element_set_position(
+            wlmtk_panel_element(panel_ptr),
+            panel_dimensions.x,
+            panel_dimensions.y);
     }
 }
 
-
 /* ------------------------------------------------------------------------- */
 // TODO(kaeser@gubbe.ch): Remove.
 void wlmtk_layer_output_reconfigure(
