From d003cc41181fab74a56fedf65fcff5237b2cf234 Mon Sep 17 00:00:00 2001
From: ruscher <rruscher@gmail.com>
Date: Mon, 26 Oct 2026 17:27:54 -0300
Subject: [PATCH 12/17] input: Adds support for relative-pointer-unstable-v1
 protocol.

Creates the relative pointer manager along with the cursor shape manager,
and sends relative motion (accelerated and unaccelerated deltas) to the
client with pointer focus, from the cursor's `motion` handler. Used by
games, 3D and remote desktop applications.

Pointer constraints (locking/confining) are not implemented yet.

Signed-off-by: ruscher <rruscher@gmail.com>
---
 doc/FEATURES.md    |  5 +++++
 doc/protocols.md   |  9 +++++++++
 src/input/cursor.c | 28 ++++++++++++++++++++++++++++
 3 files changed, 42 insertions(+)

diff --git a/doc/FEATURES.md b/doc/FEATURES.md
index a76b487..f9c2d97 100644
--- a/doc/FEATURES.md
+++ b/doc/FEATURES.md
@@ -239,6 +239,11 @@ TBD: Raise/Lower.
 
 * [x] :white_check_mark: Implemented, feedback provided by the wlroots scene graph.
 
+### `relative-pointer-unstable-v1`
+
+* [x] :white_check_mark: Implemented.
+* [ ] Add `pointer-constraints-unstable-v1`, to lock or confine the pointer.
+
 ### `single-pixel-buffer-v1`
 
 * [x] :white_check_mark: Implemented.
diff --git a/doc/protocols.md b/doc/protocols.md
index 8a61b65..9b24b78 100644
--- a/doc/protocols.md
+++ b/doc/protocols.md
@@ -31,6 +31,15 @@ Used by video players and toolkits for smooth animation and A/V sync.
 * Status: Supported. Feedback is sent by the wlroots scene graph.
 * Reference: https://wayland.app/protocols/presentation-time
 
+# Relative pointer
+
+Sends relative pointer motion (unaccelerated, and not limited by the screen
+edges) to the client that has pointer focus. Used by games and by 3D or
+remote desktop applications.
+
+* Status: Supported. Without pointer constraints, the cursor still moves.
+* Reference: https://wayland.app/protocols/relative-pointer-unstable-v1
+
 # Session lock
 
 Allows privileged Wayland clients to lock the session and display arbitrary
diff --git a/src/input/cursor.c b/src/input/cursor.c
index ed837ca..e8d193e 100644
--- a/src/input/cursor.c
+++ b/src/input/cursor.c
@@ -26,6 +26,7 @@
 #include <libbase/libbase.h>
 #include <libbase/plist.h>
 #include <linux/input-event-codes.h>
+#include <stdint.h>
 #include <stdlib.h>
 #include <string.h>
 #include <wayland-server-core.h>
@@ -35,6 +36,8 @@
 #include <wlr/types/wlr_cursor_shape_v1.h>
 #include <wlr/types/wlr_input_device.h>
 #include <wlr/types/wlr_keyboard.h>
+#include <wlr/types/wlr_pointer.h>
+#include <wlr/types/wlr_relative_pointer_v1.h>
 #include <wlr/types/wlr_seat.h>
 #include <wlr/types/wlr_xcursor_manager.h>
 #undef WLR_USE_UNSTABLE
@@ -83,6 +86,8 @@ struct _wlmim_cursor_t {
     wlmtk_root_t              *root_ptr;
     /** The cursor shape manager. */
     struct wlr_cursor_shape_manager_v1 *wlr_cursor_shape_manager_v1_ptr;
+    /** The relative pointer manager. Owned by wl_display. */
+    struct wlr_relative_pointer_manager_v1 *wlr_relative_pointer_manager_v1_ptr;
 
     /** Whether the current left-button press emulates a right button. */
     bool                      left_button_emulates_right;
@@ -216,6 +221,16 @@ wlmim_cursor_t *wlmim_cursor_create(
             &cursor_ptr->wlr_cursor_shape_manager_v1_ptr->events.request_set_shape,
             &cursor_ptr->cursor_shape_manager_v1_set_shape_listener,
             _wlmim_cursor_handle_cursor_shape_manager_v1_set_shape);
+
+        cursor_ptr->wlr_relative_pointer_manager_v1_ptr =
+            wlr_relative_pointer_manager_v1_create(wl_display_ptr);
+        if (NULL == cursor_ptr->wlr_relative_pointer_manager_v1_ptr) {
+            bs_log(BS_ERROR,
+                   "Failed wlr_relative_pointer_manager_v1_create(%p)",
+                   wl_display_ptr);
+            wlmim_cursor_destroy(cursor_ptr);
+            return NULL;
+        }
     }
 
     // tinywl: wlr_cursor *only* displays an image on screen. It does not move
@@ -429,6 +444,19 @@ void _wlmim_cursor_handle_motion(
 
     wlmim_report_activity(cursor_ptr->input_manager_ptr);
 
+    // Relative motion goes to the client with pointer focus, unaccelerated
+    // and not clipped by output boundaries.
+    if (NULL != cursor_ptr->wlr_relative_pointer_manager_v1_ptr) {
+        wlr_relative_pointer_manager_v1_send_relative_motion(
+            cursor_ptr->wlr_relative_pointer_manager_v1_ptr,
+            cursor_ptr->wlr_seat_ptr,
+            (uint64_t)wlr_pointer_motion_event_ptr->time_msec * 1000,
+            wlr_pointer_motion_event_ptr->delta_x,
+            wlr_pointer_motion_event_ptr->delta_y,
+            wlr_pointer_motion_event_ptr->unaccel_dx,
+            wlr_pointer_motion_event_ptr->unaccel_dy);
+    }
+
     wlr_cursor_move(
         cursor_ptr->wlr_cursor_ptr,
         &wlr_pointer_motion_event_ptr->pointer->base,
