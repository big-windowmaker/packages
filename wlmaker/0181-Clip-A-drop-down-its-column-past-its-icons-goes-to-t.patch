From e8196c58bed97070e1fb264c12f4405e5713f09e Mon Sep 17 00:00:00 2001
From: ruscher <rruscher@gmail.com>
Date: Mon, 23 Nov 2026 18:43:08 -0300
Subject: [PATCH] Clip: A drop down its column, past its icons, goes to the
 column's end.

With the grid (Window Maker's vicinity rule), a dock-app dropped a few
cells below the Clip's last icon had no neighbour, counted as dropped off
the docks, and was removed (kaboom, terminated, listed as Removed). The big-wm
integration test drops the tray "at the end of the Clip's column" and lost
it there. Window Maker would leave such a dock-app floating; wlmaker has none
floating. In the Clip's own column (lane 0), past its icons there and on the
output, the icon now goes to the cell right after the last one, as the
column did before the grid. Elsewhere off the icons, nothing changes.
---
 src/clip_grid.c | 51 +++++++++++++++++++++++++++++++++++++++++++++++++
 src/clip_grid.h | 16 ++++++++++++++++
 src/tile_drag.c |  6 +++++-
 3 files changed, 72 insertions(+), 1 deletion(-)

diff --git a/src/clip_grid.c b/src/clip_grid.c
index 9cd2a2b..b9c01b5 100644
--- a/src/clip_grid.c
+++ b/src/clip_grid.c
@@ -228,6 +228,27 @@ wlmaker_clip_grid_snap_t wlmaker_clip_grid_snap(
     return WLMAKER_CLIP_GRID_ATTACH;
 }
 
+/* ------------------------------------------------------------------------- */
+bool wlmaker_clip_grid_column_end(
+    const wlmaker_clip_grid_t *grid_ptr,
+    wlmaker_clip_cell_t *cell_ptr,
+    size_t own)
+{
+    if (0 != cell_ptr->lane || 0 >= cell_ptr->slot ||
+        !wlmaker_clip_grid_contains(grid_ptr, cell_ptr)) return false;
+    // The last icon of the column; the Clip's own tile is slot 0.
+    int last = 0;
+    for (size_t i = 0; i < grid_ptr->n; ++i) {
+        if (i == own || 0 != grid_ptr->cells_ptr[i].lane) continue;
+        last = BS_MAX(last, grid_ptr->cells_ptr[i].slot);
+    }
+    if (cell_ptr->slot <= last) return false;
+    wlmaker_clip_cell_t c = { .lane = 0, .slot = last + 1 };
+    if (!wlmaker_clip_grid_contains(grid_ptr, &c)) return false;
+    *cell_ptr = c;
+    return true;
+}
+
 /* ------------------------------------------------------------------------- */
 bool wlmaker_clip_grid_free_cell(
     const wlmaker_clip_grid_t *grid_ptr,
@@ -410,6 +431,7 @@ static void test_geometry(bs_test_t *test_ptr);
 static void test_snap(bs_test_t *test_ptr);
 static void test_resolve(bs_test_t *test_ptr);
 static void test_free_cell(bs_test_t *test_ptr);
+static void test_column_end(bs_test_t *test_ptr);
 
 /** Unit test cases. */
 static const bs_test_case_t _wlmaker_clip_grid_test_cases[] = {
@@ -418,9 +440,38 @@ static const bs_test_case_t _wlmaker_clip_grid_test_cases[] = {
     { true, "snap", test_snap },
     { true, "resolve", test_resolve },
     { true, "free_cell", test_free_cell },
+    { true, "column_end", test_column_end },
     BS_TEST_CASE_SENTINEL()
 };
 
+/* ------------------------------------------------------------------------- */
+/** A drop down the Clip's column, past its icons, goes to its end. */
+void test_column_end(bs_test_t *test_ptr)
+{
+    // The Clip, launchers at (0,1) and (0,2), a dock-app beside at (1,0).
+    wlmaker_clip_cell_t cells[] = { { 0, 1 }, { 0, 2 }, { 1, 0 } };
+    wlmaker_clip_grid_t g = { .n = 3, .cells_ptr = cells,
+                              .lanes = 4, .slots = 10 };
+    wlmaker_clip_cell_t c = { 0, 8 };
+    BS_TEST_VERIFY_EQ(test_ptr, WLMAKER_CLIP_GRID_OUTSIDE,
+                      wlmaker_clip_grid_snap(&g, &c, SIZE_MAX));
+    BS_TEST_VERIFY_TRUE(test_ptr, wlmaker_clip_grid_column_end(&g, &c, SIZE_MAX));
+    BS_TEST_VERIFY_EQ(test_ptr, 0, c.lane);
+    BS_TEST_VERIFY_EQ(test_ptr, 3, c.slot);
+    // The icon moved: Its own cell does not count.
+    c = (wlmaker_clip_cell_t){ 0, 8 };
+    BS_TEST_VERIFY_TRUE(test_ptr, wlmaker_clip_grid_column_end(&g, &c, 1));
+    BS_TEST_VERIFY_EQ(test_ptr, 2, c.slot);
+    // Not in the column, or off the output: Not taken.
+    c = (wlmaker_clip_cell_t){ 2, 8 };
+    BS_TEST_VERIFY_FALSE(test_ptr, wlmaker_clip_grid_column_end(&g, &c, SIZE_MAX));
+    c = (wlmaker_clip_cell_t){ 0, 12 };
+    BS_TEST_VERIFY_FALSE(test_ptr, wlmaker_clip_grid_column_end(&g, &c, SIZE_MAX));
+    // Between icons of the column: The grid's own rules.
+    c = (wlmaker_clip_cell_t){ 0, 1 };
+    BS_TEST_VERIFY_FALSE(test_ptr, wlmaker_clip_grid_column_end(&g, &c, SIZE_MAX));
+}
+
 const bs_test_set_t wlmaker_clip_grid_test_set = BS_TEST_SET(
     true, "clip_grid", _wlmaker_clip_grid_test_cases);
 
diff --git a/src/clip_grid.h b/src/clip_grid.h
index a359255..588288a 100644
--- a/src/clip_grid.h
+++ b/src/clip_grid.h
@@ -176,6 +176,22 @@ wlmaker_clip_grid_snap_t wlmaker_clip_grid_snap(
     const wlmaker_clip_cell_t *cell_ptr,
     size_t own);
 
+/**
+ * A drop in the Clip's own column (lane 0), past its last icon there and
+ * without a neighbour: The cell right after that icon, as the column took it
+ * before the grid. Window Maker would leave the dock-app floating there;
+ * wlmaker has no floating dock-apps, and a drop off the docks removes it.
+ *
+ * @param grid_ptr
+ * @param cell_ptr            The cell of the drop; set to the column's end.
+ * @param own                 The icon being moved (SIZE_MAX: none).
+ * @return true if `*cell_ptr` was such a drop, and is set.
+ */
+bool wlmaker_clip_grid_column_end(
+    const wlmaker_clip_grid_t *grid_ptr,
+    wlmaker_clip_cell_t *cell_ptr,
+    size_t own);
+
 /**
  * Finds a free cell for an icon newly attached to the Clip, without one: The
  * first free slot of the Clip's column, from the Clip on (the column is the
diff --git a/src/tile_drag.c b/src/tile_drag.c
index 4e2b89a..4d0c0bc 100644
--- a/src/tile_drag.c
+++ b/src/tile_drag.c
@@ -602,7 +602,11 @@ bool _wlmaker_tile_drag_try_column(
             tile_drag_ptr->over_taken = true;
             return false;
         default:
-            return false;
+            // Down the Clip's column, past its icons: At its end.
+            if (!wlmaker_clip_grid_column_end(g_ptr, &cell, own_icon)) {
+                return false;
+            }
+            break;
         }
         *target_ptr = (wlmaker_tile_drag_target_t){
             .column = id, .grid = true, .cell = cell };
-- 
