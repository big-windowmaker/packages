     wl_signal_init(&wlr_xwayland_surface_ptr->events.destroy);
     wl_signal_init(&wlr_xwayland_surface_ptr->events.request_configure);
     wl_signal_init(&wlr_xwayland_surface_ptr->events.request_minimize);
