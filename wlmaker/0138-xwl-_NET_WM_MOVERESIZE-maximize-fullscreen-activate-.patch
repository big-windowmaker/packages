From aa91c3ec833b7889b6a27ac523c7c445e0148531 Mon Sep 17 00:00:00 2001
From: ruscher <rruscher@gmail.com>
Date: Sat, 7 Nov 2026 18:37:01 -0300
Subject: [PATCH 138/139] xwl: _NET_WM_MOVERESIZE, maximize/fullscreen/activate
 requests; X knows the position

Programs that draw their own frame (Steam/CEF, Chromium and Electron with
their own title bar, GTK client-side decorations, SDL hit-tests) ask the
window manager to move or resize them with _NET_WM_MOVERESIZE, which
wlroots advertises: wlmaker ignored request_move and request_resize, so
such windows could neither be dragged nor resized. Their own maximize
button (_NET_WM_STATE), fullscreen and _NET_ACTIVE_WINDOW were ignored too.

The X server also believed every window was at 0,0 (or where the client
last asked): menus and popups of a moved window, placed in root
coordinates, opened at the old place. The toolkit window now emits
position_changed (placed, dragged, resized at the left/top), and the X
window is configured at the content's real position, also on size and
configure requests.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 include/toolkit/window.h |   7 ++
 src/toolkit/window.c     |   8 ++
 src/xwl_surface.c        | 178 ++++++++++++++++++++++++++++++++++++++-
 3 files changed, 189 insertions(+), 4 deletions(-)

diff --git a/include/toolkit/window.h b/include/toolkit/window.h
index 509bfb9..2927b6b 100644
--- a/include/toolkit/window.h
+++ b/include/toolkit/window.h
@@ -93,6 +93,13 @@ typedef struct {
      * Takes a `bool` as argument, specifying whether to enable maximized.
      */
     struct wl_signal          request_maximized;
+
+    /**
+     * Signals that the window moved on the workspace (placed, dragged, or
+     * resized at the left or top edge). Eg. for XWayland, which needs the
+     * X window's position to match, for the client's popups.
+     */
+    struct wl_signal          position_changed;
 } wlmtk_window_events_t;
 
 /** Style options for the window. */
diff --git a/src/toolkit/window.c b/src/toolkit/window.c
index 552c986..36629c3 100644
--- a/src/toolkit/window.c
+++ b/src/toolkit/window.c
@@ -250,6 +250,7 @@ wlmtk_window_t *wlmtk_window_create(
     window_ptr->menu_style_ref_ptr = menu_style_ref_ptr;
     wlmtk_menu_style_ref_retain(menu_style_ref_ptr);
     wl_signal_init(&window_ptr->events.state_changed);
+    wl_signal_init(&window_ptr->events.position_changed);
     wl_signal_init(&window_ptr->events.request_close);
     wl_signal_init(&window_ptr->events.set_activated);
     wl_signal_init(&window_ptr->events.request_size);
@@ -464,6 +465,7 @@ void wlmtk_window_get_min_bounding_size(
 /* ------------------------------------------------------------------------- */
 void wlmtk_window_position_changed(wlmtk_window_t *window_ptr)
 {
+    wl_signal_emit(&window_ptr->events.position_changed, window_ptr);
     if (window_ptr->inorganic_sizing) return;
     wlmtk_element_get_position(
         wlmtk_window_element(window_ptr),
@@ -1215,9 +1217,15 @@ void _wlmtk_window_element_layout(
         y += window_ptr->old_box.height - new_box.height;
     }
     // TODO: Should we rather use wlmtk_workspace_set_window_position ?
+    int old_x, old_y;
+    wlmtk_element_get_position(
+        wlmtk_bordered_element(&window_ptr->bordered), &old_x, &old_y);
     wlmtk_element_set_position(
         wlmtk_bordered_element(&window_ptr->bordered), x, y);
     window_ptr->old_box = new_box;
+    if (old_x != x || old_y != y) {
+        wl_signal_emit(&window_ptr->events.position_changed, window_ptr);
+    }
 }
 
