+            gaps_ptr[i] = v;
+            any |= 0 < v;
+        }
+    }
+    if (NULL != o) bspl_object_unref(o);
+    if (!any) {
+        if (NULL != gaps_ptr) free(gaps_ptr);
+        return NULL;
+    }
+    *len_ptr = n;
+    return gaps_ptr;
