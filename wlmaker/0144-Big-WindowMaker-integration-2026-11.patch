+    int size = server_ptr->style_ptr->tile.size;
+    int grab_x = layer_panel_ptr->press_tile_x, grab_y =
+        layer_panel_ptr->press_tile_y;
+    if (0 < b.height && size != b.height) {
+        grab_x = grab_x * size / b.height;
+        grab_y = grab_y * size / b.height;
