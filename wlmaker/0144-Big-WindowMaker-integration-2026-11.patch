+        wlmtk_tile_t *t_ptr = &dock_ptr->gap_tiles_ptr[i];
+        if (NULL != wlmtk_tile_element(t_ptr)->parent_container_ptr) {
+            wlmdock_tilebox_remove_tile(dock_ptr->tilebox_ptr, t_ptr);
+        }
