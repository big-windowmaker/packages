From 8c88a58e2cd3ee52bd95c2c8856af2b2cf5604f8 Mon Sep 17 00:00:00 2001
From: ruscher <rruscher@gmail.com>
Date: Tue, 27 Oct 2026 03:30:13 -0300
Subject: [PATCH] config: Defines the task list style descriptor with the
 config.

wlmaker_config_style_desc referenced wlmaker_task_list_style_desc, which
lived in task_list.c. Linking the config (as wlmdock does, to load the
state and the theme) therefore pulled task_list.c, and through it
server.c, XWayland and every compositor module into wlmdock. With LTO the
code was dropped again, but the linker had already recorded the shared
libraries: wlmdock had a DT_NEEDED on libxcb without using it (namcap:
"Unused shared library '/usr/lib/libxcb.so.1' by file usr/bin/wlmdock").

Defines the descriptor in config.c, next to the Clip's, and keeps its
declaration in task_list.h. wlmdock no longer links libxcb; wlmaker and
the tests are unchanged.
---
 src/config.c    | 16 ++++++++++++++++
 src/task_list.c | 15 +++------------
 2 files changed, 19 insertions(+), 12 deletions(-)

diff --git a/src/config.c b/src/config.c
index bb7da81..cc79b14 100644
--- a/src/config.c
+++ b/src/config.c
@@ -64,6 +64,22 @@ static const bspl_desc_t _wlmaker_clip_style_desc[] = {
     BSPL_DESC_SENTINEL()
 };
 
+/** Descriptor for the task list's style. Declared in task_list.h; defined
+ * here, so that loading the config does not require the task list (and,
+ * through it, the server, XWayland and the input devices). */
+const bspl_desc_t wlmaker_task_list_style_desc[] = {
+    BSPL_DESC_CUSTOM(
+        "Fill", true, struct wlmaker_task_list_style, fill, fill,
+        wlmtk_style_decode_fill, NULL, NULL, NULL),
+    BSPL_DESC_DICT(
+        "Font", true, struct wlmaker_task_list_style, font, font,
+        wlmtk_style_font_desc),
+    BSPL_DESC_ARGB32(
+        "TextColor", true, struct wlmaker_task_list_style,
+        text_color, text_color, 0),
+    BSPL_DESC_SENTINEL()
+};
+
 /** Desciptor for decoding the style information from a plist. */
 const bspl_desc_t wlmaker_config_style_desc[] = {
     BSPL_DESC_ARGB32(
diff --git a/src/task_list.c b/src/task_list.c
index 13adf1e..bbfc69f 100644
--- a/src/task_list.c
+++ b/src/task_list.c
@@ -119,18 +119,9 @@ static void _wlmaker_task_list_handle_window_unmapped(
 
 /* == Data ================================================================= */
 
-const bspl_desc_t wlmaker_task_list_style_desc[] = {
-    BSPL_DESC_CUSTOM(
-        "Fill", true, struct wlmaker_task_list_style, fill, fill,
-        wlmtk_style_decode_fill, NULL, NULL, NULL),
-    BSPL_DESC_DICT(
-        "Font", true, struct wlmaker_task_list_style, font, font,
-        wlmtk_style_font_desc),
-    BSPL_DESC_ARGB32(
-        "TextColor", true, struct wlmaker_task_list_style,
-        text_color, text_color, 0),
-    BSPL_DESC_SENTINEL()
-};
+/* `wlmaker_task_list_style_desc` is defined in config.c: Referencing it
+ * from here would pull the compositor into every user of the config
+ * (eg. wlmdock links the config, and would link XCB and libinput). */
 
 /** Task list positioning: Fixed dimensions, at center of layer. */
 static const wlmtk_panel_positioning_t _wlmaker_task_list_positioning = {
