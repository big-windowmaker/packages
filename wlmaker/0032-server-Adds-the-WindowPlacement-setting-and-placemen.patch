From 2db24874f0a202f3d1697fa2588504a5c8d84ca5 Mon Sep 17 00:00:00 2001
From: ruscher <rruscher@gmail.com>
Date: Mon, 26 Oct 2026 19:08:23 -0300
Subject: [PATCH 32/34] server: Adds the `WindowPlacement` setting, and
 placement hints.

* `WindowPlacement` in the configuration file selects `Center` or `Smart`
  (default) placement for new windows. The default configuration uses
  `Center`, as Window Maker does.
* XDG toplevels with a parent (dialogs) are centered on the parent.
* X11 windows go to the position requested by the user (US position) or
  the program (P position, unless at 0,0); transients are centered on
  their parent.

Documents the setting in doc/config.md.

Signed-off-by: ruscher <rruscher@gmail.com>
---
 doc/config.md      | 18 +++++++++++++++
 etc/Config.plist   |  4 ++++
 src/server.c       | 15 ++++++++++++
 src/xdg_toplevel.c | 13 ++++++++++-
 src/xwl_surface.c  | 57 ++++++++++++++++++++++++++++++++++++++++++++--
 5 files changed, 104 insertions(+), 3 deletions(-)

diff --git a/doc/config.md b/doc/config.md
index 2e94911..0412900 100644
--- a/doc/config.md
+++ b/doc/config.md
@@ -115,6 +115,24 @@ The `LockScreen` action is wired to execute `Command` of `ScreenLock`.
 Example:
 @snippet{trimleft} etc/ExampleConfig.plist ScreenLock
 
+## WindowPlacement {#config_windowplacement}
+
+*Optional*: Where new windows are placed.
+
+* `Center`: Centered in the area usable for windows on the output under the
+  pointer. A window that would exactly cover another one is cascaded. Like
+  Window Maker's `WindowPlacement = center`.
+* `Smart`: Placed in the first free spot, filling the usable area row by row.
+  This is the default, if not set.
+
+The usable area is the output minus the exclusive zones of panels (eg. the
+Clip, `wlmdock`, layer-shell panels). Windows are kept within it, so that the
+title bar is always reachable; windows larger than the area are placed at its
+top-left. Maximized windows use the usable area, too.
+
+X11 windows go to the position the user or the program requested, if any.
+Dialogs (transient windows) are centered on their parent.
+
 ## Autostart {#config_autostart}
 
 An array of strings, each denoting an executable that will be executed once
diff --git a/etc/Config.plist b/etc/Config.plist
index 0d1ee35..bff8640 100644
--- a/etc/Config.plist
+++ b/etc/Config.plist
@@ -125,6 +125,10 @@
         IdleSeconds = 300;
         Command = "/usr/bin/swaylock";
     };
+    // Optional: Where new windows are placed. `Center` centers them in the
+    // usable area of the output under the pointer, `Smart` (the default, if
+    // not set) fills free spots row by row.
+    WindowPlacement = Center;
     // Optional array: Commands to start once wlmaker is running.
     Autostart = (
         // TODO(kaeser@gubbe.ch): Add wlmdock.
diff --git a/src/server.c b/src/server.c
index 2f7df0d..a61dcad 100644
--- a/src/server.c
+++ b/src/server.c
@@ -25,6 +25,7 @@
 #include <libbase/plist.h>
 #include <linux/input-event-codes.h>
 #include <stdlib.h>
+#include <strings.h>
 #define WLR_USE_UNSTABLE
 #include <wlr/backend.h>
 #include <wlr/types/wlr_viewporter.h>
@@ -186,6 +187,20 @@ wlmaker_server_t *wlmaker_server_create(
         wlmaker_server_destroy(server_ptr);
         return NULL;
     }
+    const char *placement_ptr = bspl_dict_get_string_value(
+        server_ptr->config_dict_ptr, "WindowPlacement");
+    if (NULL != placement_ptr) {
+        if (0 == strcasecmp(placement_ptr, "Center")) {
+            wlmtk_desktop_set_window_placement(
+                server_ptr->desktop_ptr, WLMTK_WINDOW_PLACEMENT_CENTER);
+        } else if (0 == strcasecmp(placement_ptr, "Smart")) {
+            wlmtk_desktop_set_window_placement(
+                server_ptr->desktop_ptr, WLMTK_WINDOW_PLACEMENT_SMART);
+        } else {
+            bs_log(BS_WARNING, "Unknown WindowPlacement \"%s\", using Smart.",
+                   placement_ptr);
+        }
+    }
 
     // root element wrapper.
     server_ptr->root_ptr = wlmtk_root_create(
diff --git a/src/xdg_toplevel.c b/src/xdg_toplevel.c
index d694ceb..cd08376 100644
--- a/src/xdg_toplevel.c
+++ b/src/xdg_toplevel.c
@@ -558,7 +558,18 @@ void _wlmaker_xdg_toplevel_try_map(struct wlmaker_xdg_toplevel *wxt_ptr)
 
     wlmtk_workspace_t *workspace_ptr = wlmtk_desktop_get_current_workspace(
         wxt_ptr->server_ptr->desktop_ptr);
-    wlmtk_workspace_map_window(workspace_ptr, wxt_ptr->window_ptr);
+
+    // Transients (eg. dialogs) are placed centered on their parent.
+    wlmtk_window_placement_hint_t hint = {};
+    struct wlr_xdg_toplevel *parent_ptr = wxt_ptr->wlr_xdg_toplevel_ptr->parent;
+    if (NULL != parent_ptr && NULL != parent_ptr->base->data) {
+        struct wlmaker_xdg_toplevel *parent_wxt_ptr = parent_ptr->base->data;
+        if (NULL != wlmtk_window_get_workspace(parent_wxt_ptr->window_ptr)) {
+            hint.parent_ptr = parent_wxt_ptr->window_ptr;
+        }
+    }
+    wlmtk_workspace_map_window_with_hint(
+        workspace_ptr, wxt_ptr->window_ptr, &hint);
 }
 
 /* ------------------------------------------------------------------------- */
diff --git a/src/xwl_surface.c b/src/xwl_surface.c
index 5e63b5a..a52774f 100644
--- a/src/xwl_surface.c
+++ b/src/xwl_surface.c
@@ -99,6 +99,8 @@ struct _wlmaker_xwl_surface_t {
     wlmtk_window_t           *window_ptr;
     /** The window menu, with the same items as for XDG toplevels. */
     wlmaker_tl_menu_t         *tl_menu_ptr;
+    /** Whether the surface is mapped, but waits for its size to map. */
+    bool                      map_pending;
     /** Or, the parent surface. In that case, window_ptr is NULL. */
     wlmaker_xwl_surface_t     *parent_surface_ptr;
 
@@ -115,6 +117,7 @@ static void _xwl_surface_handle_request_configure(
 static void _xwl_surface_handle_request_minimize(
     struct wl_listener *listener_ptr,
     void *data_ptr);
+static void _xwl_surface_map_window(wlmaker_xwl_surface_t *xwl_surface_ptr);
 
 static void _wlmaker_xwl_surface_base_element_destroy(
     wlmtk_element_t *element_ptr);
@@ -706,10 +709,50 @@ void _xwl_surface_handle_surface_map(
 
     if (NULL == xwl_surface_ptr->window_ptr) return;
 
+    // The surface is mapped while committing, before the toolkit surface
+    // learned its size. Place & map the window once the size is known.
+    struct wlr_box size = wlmtk_window_get_size(xwl_surface_ptr->window_ptr);
+    if (0 >= size.width || 0 >= size.height) {
+        xwl_surface_ptr->map_pending = true;
+        return;
+    }
+    _xwl_surface_map_window(xwl_surface_ptr);
+}
+
+/* ------------------------------------------------------------------------- */
+/** Places the window (respecting hints), and maps it to the workspace. */
+void _xwl_surface_map_window(wlmaker_xwl_surface_t *xwl_surface_ptr)
+{
+    xwl_surface_ptr->map_pending = false;
     wlmtk_workspace_t *workspace_ptr =
         wlmtk_desktop_get_current_workspace(
             xwl_surface_ptr->server_ptr->desktop_ptr);
-    wlmtk_workspace_map_window(workspace_ptr, xwl_surface_ptr->window_ptr);
+
+    // Respect positions requested by the user (eg. -geometry +X+Y) or the
+    // program. A program position of (0, 0) is commonly just a default.
+    // Transients (eg. modal dialogs) are centered on their parent.
+    struct wlr_xwayland_surface *xws_ptr =
+        xwl_surface_ptr->wlr_xwayland_surface_ptr;
+    wlmtk_window_placement_hint_t hint = {};
+    if (NULL != xws_ptr->size_hints) {
+        uint32_t flags = xws_ptr->size_hints->flags;
+        if ((flags & XCB_ICCCM_SIZE_HINT_US_POSITION) ||
+            ((flags & XCB_ICCCM_SIZE_HINT_P_POSITION) &&
+             (0 != xws_ptr->x || 0 != xws_ptr->y))) {
+            hint.has_position = true;
+            hint.x = xws_ptr->x;
+            hint.y = xws_ptr->y;
+        }
+    }
+    if (NULL != xws_ptr->parent && NULL != xws_ptr->parent->data) {
+        wlmaker_xwl_surface_t *parent_ptr = xws_ptr->parent->data;
+        if (NULL != parent_ptr->window_ptr &&
+            NULL != wlmtk_window_get_workspace(parent_ptr->window_ptr)) {
+            hint.parent_ptr = parent_ptr->window_ptr;
+        }
+    }
+    wlmtk_workspace_map_window_with_hint(
+        workspace_ptr, xwl_surface_ptr->window_ptr, &hint);
 }
 
 /* ------------------------------------------------------------------------- */
@@ -721,7 +764,9 @@ void _xwl_surface_handle_surface_unmap(
     wlmaker_xwl_surface_t *xwl_surface_ptr = BS_CONTAINER_OF(
         listener_ptr, wlmaker_xwl_surface_t, surface_unmap_listener);
 
-    if (NULL == xwl_surface_ptr->window_ptr) return;
+    xwl_surface_ptr->map_pending = false;
+    if (NULL == xwl_surface_ptr->window_ptr ||
+        NULL == wlmtk_window_get_workspace(xwl_surface_ptr->window_ptr)) return;
 
     wlmtk_workspace_unmap_window(
         wlmtk_window_get_workspace(xwl_surface_ptr->window_ptr),
@@ -743,6 +788,14 @@ void _xwl_surface_handle_surface_commit(
         xwl_surface_ptr->window_ptr,
         xwl_surface_ptr->wlr_xwayland_surface_ptr->surface->current.width,
         xwl_surface_ptr->wlr_xwayland_surface_ptr->surface->current.height);
+
+    if (xwl_surface_ptr->map_pending) {
+        struct wlr_box size = wlmtk_window_get_size(
+            xwl_surface_ptr->window_ptr);
+        if (0 < size.width && 0 < size.height) {
+            _xwl_surface_map_window(xwl_surface_ptr);
+        }
+    }
 }
 
