+    bspl_array_t *a = bspl_dict_get_array(
+        bspl_dict_get_dict(d, dock_ptr->section_ptr), "Launchers");
+    if (NULL != a) a = bspl_array_ref(a);
+    if (NULL != d) bspl_dict_unref(d);
+    if (NULL != a && 0 == bspl_array_size(a)) {
+        bspl_array_unref(a);
+        a = NULL;
