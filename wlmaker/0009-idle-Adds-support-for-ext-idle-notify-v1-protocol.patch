From 4db36e8d0a3a2de4bcb1820af1cf8dda63ca4599 Mon Sep 17 00:00:00 2001
From: ruscher <rruscher@gmail.com>
Date: Mon, 26 Oct 2026 17:23:55 -0300
Subject: [PATCH 09/17] idle: Adds support for ext-idle-notify-v1 protocol.

Creates the wlr_idle_notifier_v1 global in the idle monitor. Activity is
reported from the same input path that resets wlmaker's own idle timer,
also while locked, so that clients can resume (eg. power outputs on).
Idle notifications are inhibited while the idle monitor has inhibits,
ie. from idle-inhibit-unstable-v1 clients or the inhibit action.

Permits idle management daemons such as swayidle to work on wlmaker.

Signed-off-by: ruscher <rruscher@gmail.com>
---
 doc/FEATURES.md  |  2 +-
 doc/protocols.md | 10 ++++++++++
 src/idle.c       | 25 ++++++++++++++++++++++++-
 src/idle.h       |  4 +++-
 4 files changed, 38 insertions(+), 3 deletions(-)

diff --git a/doc/FEATURES.md b/doc/FEATURES.md
index d5e4266..d2909b2 100644
--- a/doc/FEATURES.md
+++ b/doc/FEATURES.md
@@ -211,7 +211,7 @@ TBD: Raise/Lower.
 
 ### `ext-idle-notify-v1`
 
-* [ ] Implement.
+* [x] :white_check_mark: Implemented, honoring idle inhibitors. Verified with `swayidle`.
 
 ### `ext-image-capture-source-v1`
 
diff --git a/doc/protocols.md b/doc/protocols.md
index bbe83ec..8234c00 100644
--- a/doc/protocols.md
+++ b/doc/protocols.md
@@ -6,6 +6,16 @@ This page documents which of the Wayland protocols (beyond the core
 [Wayland protocol](https://wayland.app/protocols/wayland)) are supported
 by wlmaker.
 
+# Idle notify
+
+Lets clients get notified when the user is idle for a given time, and when
+activity resumes. Used by idle management daemons such as
+[swayidle](https://github.com/swaywm/swayidle).
+
+* Status: Supported. Activity is reported from keyboard and pointer input.
+  Idle notifications are inhibited while an idle inhibitor is active.
+* Reference: https://wayland.app/protocols/ext-idle-notify-v1
+
 # Idle inhibit
 
 Permits inhibiting the idle behaviour, such as locking the screen.
diff --git a/src/idle.c b/src/idle.c
index 94e6ee8..0b9230a 100644
--- a/src/idle.c
+++ b/src/idle.c
@@ -30,6 +30,7 @@
 #include <wayland-util.h>
 #define WLR_USE_UNSTABLE
 #include <wlr/types/wlr_idle_inhibit_v1.h>
+#include <wlr/types/wlr_idle_notify_v1.h>
 #undef WLR_USE_UNSTABLE
 
 #include "util/subprocess_monitor.h"
@@ -71,6 +72,8 @@ struct _wlmaker_idle_monitor_t {
 
     /** The wlroots idle inhibit manager. */
     struct wlr_idle_inhibit_manager_v1 *wlr_idle_inhibit_manager_v1_ptr;
+    /** The wlroots idle notifier, for ext-idle-notify-v1. */
+    struct wlr_idle_notifier_v1 *wlr_idle_notifier_v1_ptr;
 
     /** Whether the idle monitor is locked. Prevents timer registry. */
     bool                      locked;
@@ -142,6 +145,15 @@ wlmaker_idle_monitor_t *wlmaker_idle_monitor_create(
         &monitor_ptr->new_inhibitor_listener,
         _wlmaker_idle_monitor_handle_new_inhibitor);
 
+    monitor_ptr->wlr_idle_notifier_v1_ptr =
+        wlr_idle_notifier_v1_create(server_ptr->wl_display_ptr);
+    if (NULL == monitor_ptr->wlr_idle_notifier_v1_ptr) {
+        bs_log(BS_ERROR, "Failed wlr_idle_notifier_v1_create(%p)",
+               server_ptr->wl_display_ptr);
+        wlmaker_idle_monitor_destroy(monitor_ptr);
+        return NULL;
+    }
+
     monitor_ptr->timer_event_source_ptr = wl_event_loop_add_timer(
         monitor_ptr->wl_event_loop_ptr,
         _wlmaker_idle_monitor_timer,
@@ -184,7 +196,7 @@ void wlmaker_idle_monitor_destroy(wlmaker_idle_monitor_t *idle_monitor_ptr)
         idle_monitor_ptr->lock_config_dict_ptr = NULL;
     }
 
-    // Note: The idle inhibit manager does not have a dtor.
+    // Note: The idle inhibit manager and the idle notifier do not have a dtor.
 
     free(idle_monitor_ptr);
 }
@@ -192,6 +204,12 @@ void wlmaker_idle_monitor_destroy(wlmaker_idle_monitor_t *idle_monitor_ptr)
 /* ------------------------------------------------------------------------- */
 void wlmaker_idle_monitor_reset(wlmaker_idle_monitor_t *idle_monitor_ptr)
 {
+    // Notify ext-idle-notify-v1 clients also while locked: They may want to
+    // eg. power on the outputs again.
+    wlr_idle_notifier_v1_notify_activity(
+        idle_monitor_ptr->wlr_idle_notifier_v1_ptr,
+        idle_monitor_ptr->server_ptr->wlr_seat_ptr);
+
     if (idle_monitor_ptr->locked) return;
 
     int rv = wl_event_source_timer_update(
@@ -243,6 +261,8 @@ bool wlmaker_idle_monitor_lock(wlmaker_idle_monitor_t *idle_monitor_ptr)
 void wlmaker_idle_monitor_inhibit(wlmaker_idle_monitor_t *idle_monitor_ptr)
 {
     ++idle_monitor_ptr->inhibits;
+    wlr_idle_notifier_v1_set_inhibited(
+        idle_monitor_ptr->wlr_idle_notifier_v1_ptr, true);
 }
 
 /* ------------------------------------------------------------------------- */
@@ -250,6 +270,9 @@ void wlmaker_idle_monitor_uninhibit(wlmaker_idle_monitor_t *idle_monitor_ptr)
 {
     BS_ASSERT(0 < idle_monitor_ptr->inhibits);
     --idle_monitor_ptr->inhibits;
+    wlr_idle_notifier_v1_set_inhibited(
+        idle_monitor_ptr->wlr_idle_notifier_v1_ptr,
+        0 < idle_monitor_ptr->inhibits);
     _wlmaker_idle_monitor_consider_locking(idle_monitor_ptr);
 }
 
diff --git a/src/idle.h b/src/idle.h
index 828e39a..497b570 100644
--- a/src/idle.h
+++ b/src/idle.h
@@ -52,6 +52,8 @@ void wlmaker_idle_monitor_destroy(wlmaker_idle_monitor_t *idle_monitor_ptr);
 /**
  * Resets the idle monitor: For example, when a key is pressed.
  *
+ * Also reports the activity to ext-idle-notify-v1 clients, even if locked.
+ *
  * @param idle_monitor_ptr
  */
 void wlmaker_idle_monitor_reset(wlmaker_idle_monitor_t *idle_monitor_ptr);
@@ -68,7 +70,7 @@ bool wlmaker_idle_monitor_lock(wlmaker_idle_monitor_t *idle_monitor_ptr);
 /**
  * Inhibits locking: Increases inhibitor counter, which will prevent locking
  * when the idle timer expires. @see wlmaker_idle_monitor_uninhibit for
- * releasing the inhibitor.
+ * releasing the inhibitor. Also inhibits ext-idle-notify-v1 idle events.
  *
  * @param idle_monitor_ptr
  */
