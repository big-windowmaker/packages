     wlmtk_pointer_motion_event_t mev = { .x = 20, .y = 10 };
@@ -1114,7 +1120,7 @@ void test_pointer(bs_test_t *test_ptr)
     BS_TEST_VERIFY_EQ(
         test_ptr,
         item_ptr->super_buffer.wlr_buffer_ptr,
-        item_ptr->disabled_wlr_buffer_ptr);
+        item_ptr->wlr_buffer_ptr);
 
