From e9f1be141d6f910b39a1784fb9c2b6cc74ff43c6 Mon Sep 17 00:00:00 2001
From: ruscher <rruscher@gmail.com>
Date: Tue, 27 Oct 2026 17:24:42 -0300
Subject: [PATCH] dock: Looks up a tile's balloon once per entering it.

The balloons of the Dock's launchers were looked up on each pointer
motion over them: Reading the state, and finding the launchers' icons.
And those of the dock-apps read their command from /proc. Now once, when
the pointer enters the tile; again after leaving it, or after a click.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/icon_manager.c | 7 +++++++
 src/layer_panel.c  | 9 +++++++++
 2 files changed, 16 insertions(+)

diff --git a/src/icon_manager.c b/src/icon_manager.c
index 0df7683..12cadfb 100644
--- a/src/icon_manager.c
+++ b/src/icon_manager.c
@@ -127,6 +127,8 @@ struct _wlmaker_toplevel_icon_t {
     bool                      lifted;
     /** Listener for @ref wlmtk_element_events_t::pointer_leave. */
     struct wl_listener        pointer_leave_listener;
+    /** Whether the balloon is shown, or pending, for the icon. */
+    bool                      balloon_entered;
 };
 
 static wlmaker_icon_manager_t *icon_manager_from_resource(
@@ -965,6 +967,7 @@ bool _wlmaker_toplevel_icon_element_pointer_button(
     if (NULL != server_ptr->dock_fx_ptr) {
         wlmaker_dock_fx_balloon_leave(server_ptr->dock_fx_ptr, NULL);
     }
+    toplevel_icon_ptr->balloon_entered = false;
 
     if (toplevel_icon_ptr->dragging) {
         if (BTN_LEFT == button_event_ptr->button &&
@@ -1101,8 +1104,11 @@ void _wlmaker_toplevel_icon_balloon(
         motion_event_ptr->y >= box.y + box.height ||
         NULL != server_ptr->tile_drag_ptr) {
         wlmaker_dock_fx_balloon_leave(server_ptr->dock_fx_ptr, toplevel_icon_ptr);
+        toplevel_icon_ptr->balloon_entered = false;
         return;
     }
+    if (toplevel_icon_ptr->balloon_entered) return;
+    toplevel_icon_ptr->balloon_entered = true;
     int x, y;
     wlmtk_element_get_absolute_position(element_ptr, &x, &y);
     box.x += x;
@@ -1133,6 +1139,7 @@ void _wlmaker_toplevel_icon_handle_pointer_leave(
     wlmaker_toplevel_icon_t *toplevel_icon_ptr = BS_CONTAINER_OF(
         listener_ptr, wlmaker_toplevel_icon_t, pointer_leave_listener);
     wlmaker_server_t *server_ptr = toplevel_icon_ptr->server_ptr;
+    toplevel_icon_ptr->balloon_entered = false;
     if (NULL == server_ptr || NULL == server_ptr->dock_fx_ptr) return;
     wlmaker_dock_fx_balloon_leave(server_ptr->dock_fx_ptr, toplevel_icon_ptr);
     wlmaker_dockapps_t *d_ptr = wlmaker_clip_dockapps_of(
diff --git a/src/layer_panel.c b/src/layer_panel.c
index 46613be..f06601f 100644
--- a/src/layer_panel.c
+++ b/src/layer_panel.c
@@ -105,6 +105,8 @@ struct _wlmaker_layer_panel_t {
     uint32_t                  last_click_msec;
     /** Tile of the last click. */
     int                       last_click_index;
+    /** Tile the balloon is shown (or pending) for. -1 for none. */
+    int                       balloon_index;
 };
 
 wlmaker_layer_panel_t *_wlmaker_layer_panel_create_from_surface(
@@ -320,6 +322,7 @@ wlmaker_layer_panel_t *_wlmaker_layer_panel_create_from_surface(
         server_ptr->clip_layer_panel_ptr = layer_panel_ptr;
     }
     layer_panel_ptr->press_index = -1;
+    layer_panel_ptr->balloon_index = -1;
     wlmtk_util_connect_listener_signal(
         &wlmtk_panel_element(&layer_panel_ptr->super_panel)->events.pointer_leave,
         &layer_panel_ptr->pointer_leave_listener,
@@ -591,6 +594,7 @@ bool _wlmaker_layer_panel_element_pointer_button(
 
     if (docklike && NULL != server_ptr->dock_fx_ptr) {
         wlmaker_dock_fx_balloon_leave(server_ptr->dock_fx_ptr, NULL);
+        layer_panel_ptr->balloon_index = -1;
     }
 
     // A launcher being dragged: Dropped, when the button is released.
@@ -930,8 +934,12 @@ void _wlmaker_layer_panel_balloon(
                                       &index, &tx, &ty) ||
         (dock && 0 == index)) {
         wlmaker_dock_fx_balloon_leave(server_ptr->dock_fx_ptr, layer_panel_ptr);
+        layer_panel_ptr->balloon_index = -1;
         return;
     }
+    // Still the same tile: Its balloon is already shown, or pending.
+    if (index == layer_panel_ptr->balloon_index) return;
+    layer_panel_ptr->balloon_index = index;
     if (dock) --index;
     bspl_array_t *a = wlmaker_dock_launchers_load(
         server_ptr, dock ? "Dock" : "Clip");
@@ -980,6 +988,7 @@ void _wlmaker_layer_panel_handle_pointer_leave(
         wlmaker_clip_dock_left(layer_panel_ptr->server_ptr,
                                layer_panel_ptr->is_dock);
     }
+    layer_panel_ptr->balloon_index = -1;
     if (NULL == layer_panel_ptr->server_ptr->dock_fx_ptr) return;
     wlmaker_dock_fx_balloon_leave(
         layer_panel_ptr->server_ptr->dock_fx_ptr, layer_panel_ptr);
-- 
