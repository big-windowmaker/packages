 }
 
 /* ------------------------------------------------------------------------- */
@@ -1205,6 +1289,8 @@ bool _wlmaker_toplevel_icon_tile_set_content_size(
 {
     wlmaker_toplevel_icon_t *toplevel_icon_ptr = BS_CONTAINER_OF(
         tile_ptr, wlmaker_toplevel_icon_t, super_tile);
