From 2f6bf50220e4dd1e8bed024385c3c222f90a0830 Mon Sep 17 00:00:00 2001
From: ruscher <rruscher@gmail.com>
Date: Mon, 23 Nov 2026 08:29:53 -0300
Subject: [PATCH 177/178] Menus: Not under the icons of the Clip's grid, which
 are above the windows.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/clip.c         | 49 ++++++++++++++++++++++++++++++++++++++++++++++
 src/clip.h         | 10 ++++++++++
 src/context_menu.c |  6 ++++--
 src/root_menu.c    |  4 ++++
 4 files changed, 67 insertions(+), 2 deletions(-)

diff --git a/src/clip.c b/src/clip.c
index 60b3838..076a968 100644
--- a/src/clip.c
+++ b/src/clip.c
@@ -1144,6 +1144,55 @@ size_t wlmaker_clip_grid_icon_at_point(
     return SIZE_MAX;
 }
 
+/* ------------------------------------------------------------------------- */
+bool wlmaker_clip_grid_avoid(
+    wlmaker_server_t *server_ptr,
+    struct wlr_box *box_ptr,
+    const struct wlr_box *area_ptr)
+{
+    wlmaker_dock_column_t column;
+    if (!wlmaker_clip_column_id(server_ptr, WLMAKER_COLUMN_CLIP, &column) ||
+        0 >= column.pitch) return false;
+    const wlmaker_clip_grid_t *g_ptr = &server_ptr->clip_ptr->grid;
+    bool vertical = wlmaker_dock_place_vertical(column.place);
+    bool far = vertical ? WLR_EDGE_RIGHT == column.place.edge :
+        WLR_EDGE_BOTTOM == column.place.edge;
+    struct wlr_box b = *box_ptr;
+    bool moved = false;
+    // Past each icon it covers, away from the Clip's edge.
+    for (size_t round = 0; round <= g_ptr->n; ++round) {
+        bool hit = false;
+        for (size_t i = 0; i < g_ptr->n; ++i) {
+            int cx, cy;
+            wlmaker_clip_cell_position(column.place, column.x, column.y,
+                                       column.pitch, &g_ptr->cells_ptr[i],
+                                       &cx, &cy);
+            struct wlr_box c = { .x = cx, .y = cy,
+                                 .width = column.size, .height = column.size };
+            struct wlr_box isect;
+            if (!wlr_box_intersection(&isect, &c, &b)) continue;
+            hit = true;
+            int gap = column.pitch - column.size;
+            if (vertical) {
+                b.x = far ? c.x - gap - b.width : c.x + c.width + gap;
+            } else {
+                b.y = far ? c.y - gap - b.height : c.y + c.height + gap;
+            }
+        }
+        if (!hit) break;
+        moved = true;
+    }
+    // Off the area: Better over the icons than off the screen.
+    if (!moved || (NULL != area_ptr &&
+                   (b.x < area_ptr->x || b.y < area_ptr->y ||
+                    b.x + b.width > area_ptr->x + area_ptr->width ||
+                    b.y + b.height > area_ptr->y + area_ptr->height))) {
+        return false;
+    }
+    *box_ptr = b;
+    return true;
+}
+
 /* ------------------------------------------------------------------------- */
 void wlmaker_clip_freeze_grid(wlmaker_server_t *server_ptr)
 {
diff --git a/src/clip.h b/src/clip.h
index f0c2af2..8f4466d 100644
--- a/src/clip.h
+++ b/src/clip.h
@@ -419,6 +419,16 @@ size_t wlmaker_clip_grid_icon_at_point(
     int *tile_x_ptr,
     int *tile_y_ptr);
 
+/**
+ * Moves `box_ptr` (eg. a menu, which is below the docks) off the icons of
+ * the Clip's grid beside its column, away from the Clip's edge.
+ * @return true if moved, staying within `area_ptr` (may be NULL).
+ */
+bool wlmaker_clip_grid_avoid(
+    wlmaker_server_t *server_ptr,
+    struct wlr_box *box_ptr,
+    const struct wlr_box *area_ptr);
+
 /**
  * Stores the cells of the Clip's icons that have none stored yet (a state
  * from before the grid, or a new icon): Before icons are moved, so that the
diff --git a/src/context_menu.c b/src/context_menu.c
index 9a6d426..00e157a 100644
--- a/src/context_menu.c
+++ b/src/context_menu.c
@@ -333,10 +333,12 @@ void wlmaker_context_menu_open(wlmaker_context_menu_t *context_menu_ptr)
             moved.y = row.y - moved.height;
         }
     }
-    if (moved.y != bbox.y) {
+    // Not over the icons of the Clip's grid either (above the windows too).
+    wlmaker_clip_grid_avoid(server_ptr, &moved, &area);
+    if (moved.y != bbox.y || moved.x != bbox.x) {
         wlmtk_workspace_set_window_position(
             workspace_ptr, context_menu_ptr->window_ptr,
-            wx, wy + moved.y - bbox.y);
+            wx + moved.x - bbox.x, wy + moved.y - bbox.y);
     }
     // Keyboard focus: The menu's keys work, and Escape closes it.
     wlmtk_workspace_activate_window(workspace_ptr, context_menu_ptr->window_ptr);
diff --git a/src/root_menu.c b/src/root_menu.c
index f9522f8..9c8286b 100644
--- a/src/root_menu.c
+++ b/src/root_menu.c
@@ -21,6 +21,8 @@
 
 #include "root_menu.h"
 
+#include "clip.h"
+
 #include <inttypes.h>
 #include <libbase/libbase.h>
 #include <libbase/plist.h>
@@ -476,6 +478,8 @@ void wlmaker_root_menu_open(wlmaker_root_menu_t *root_menu_ptr,
         root_menu_ptr->window_ptr);
     struct wlr_box pos = wlmaker_context_menu_confine(
         &area, bbox.x, bbox.y, bbox.width, bbox.height);
+    // Not under the icons of the Clip's grid, which are above the windows.
+    wlmaker_clip_grid_avoid(server_ptr, &pos, &area);
     wlmtk_workspace_set_window_position(
         workspace_ptr, root_menu_ptr->window_ptr,
         x + pos.x - bbox.x, y + pos.y - bbox.y);
