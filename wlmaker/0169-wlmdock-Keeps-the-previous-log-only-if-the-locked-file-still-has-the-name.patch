From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ruscher <rruscher@gmail.com>
Date: Fri, 20 Nov 2026 21:00:28 -0300
Subject: [PATCH] wlmdock: Keeps the previous log only if the locked file still
 has the name.

The lock holds the file, not its name: Two wlmdock of the same kind
starting together could both open the previous log, and the second
renamed the new log of the first (review of big-windowmaker/packages#48).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/wlmdock.c | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/src/wlmdock.c b/src/wlmdock.c
index 3b1e214..ff38db0 100644
--- a/src/wlmdock.c
+++ b/src/wlmdock.c
@@ -38,6 +38,7 @@
 #include <sys/prctl.h>
 #include <sys/signalfd.h>
 #include <sys/socket.h>
+#include <sys/stat.h>
 #include <sys/types.h>
 #include <unistd.h>
 #include <wayland-client-core.h>
@@ -363,7 +364,14 @@ static void _wlmdock_keep_previous_log(const char *dir_ptr, const char *name_ptr
     int fd = open(path, O_WRONLY | O_CLOEXEC);
     if (0 > fd) return;
     struct flock file_lock = { .l_type = F_WRLCK, .l_whence = SEEK_SET };
-    if (0 == fcntl(fd, F_SETLK, &file_lock)) rename(path, old_path);
+    struct stat locked, current;
+    // The lock holds the file, not the name: Another wlmdock starting at
+    // the same time may have renamed it, and logs to a new one by now.
+    if (0 == fcntl(fd, F_SETLK, &file_lock) &&
+        0 == fstat(fd, &locked) && 0 == stat(path, &current) &&
+        locked.st_dev == current.st_dev && locked.st_ino == current.st_ino) {
+        rename(path, old_path);
+    }
     close(fd);
 }
 
