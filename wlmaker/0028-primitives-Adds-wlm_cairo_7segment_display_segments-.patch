From e9e73d9720cc06daa0dbea2f5bed7535a1ae70c0 Mon Sep 17 00:00:00 2001
From: ruscher <rruscher@gmail.com>
Date: Mon, 26 Oct 2026 19:00:01 -0300
Subject: [PATCH 28/30] primitives: Adds wlm_cairo_7segment_display_segments,
 for any segment pattern.

wlm_cairo_7segment_display_digit() draws only the digits 0-9. DockApps
also want to show a blank position (all segments off, as on a VFD) or a
minus sign, eg. for "--" when there is no value.

Adds wlm_cairo_7segment_display_segments(), which draws any bitmask of
the 7 segments, and WLM_CAIRO_7SEGMENT_MINUS. The digit function now
uses it. Adds a test that both draw '8' identically, and for the minus
sign.

Signed-off-by: ruscher <rruscher@gmail.com>
---
 apps/primitives/segment_display.c | 59 ++++++++++++++++++++++++++++++-
 apps/primitives/segment_display.h | 28 +++++++++++++++
 2 files changed, 86 insertions(+), 1 deletion(-)

diff --git a/apps/primitives/segment_display.c b/apps/primitives/segment_display.c
index 0f356ec..d93d6b6 100644
--- a/apps/primitives/segment_display.c
+++ b/apps/primitives/segment_display.c
@@ -109,8 +109,21 @@ void wlm_cairo_7segment_display_digit(
     uint8_t digit)
 {
     BS_ASSERT(digit < UINT8_C(10));
-    uint8_t segments = seven_segment_encoding[digit];
+    wlm_cairo_7segment_display_segments(
+        cairo_ptr, pptr, x, y, color_on, color_off,
+        seven_segment_encoding[digit]);
+}
 
+/* ------------------------------------------------------------------------- */
+void wlm_cairo_7segment_display_segments(
+    cairo_t *cairo_ptr,
+    const wlm_cairo_7segment_param_t *pptr,
+    uint32_t x,
+    uint32_t y,
+    uint32_t color_on,
+    uint32_t color_off,
+    uint8_t segments)
+{
     // Vectors spanning up a segment.
     bs_vector_2f_t longitudinal = { .x = 1.0, .y = 0.0 };
     bs_vector_2f_t lateral = { .x = 0.0, .y = 1.0 };
@@ -237,12 +250,14 @@ void draw_segment(
 static void test_6x8(bs_test_t *test_ptr);
 static void test_7x10(bs_test_t *test_ptr);
 static void test_16x24(bs_test_t *test_ptr);
+static void test_segments(bs_test_t *test_ptr);
 
 /** Test cases */
 static const bs_test_case_t _wlm_cairo_segment_display_test_cases[] = {
     { 1, "6x8", test_6x8 },
     { 1, "7x10", test_7x10 },
     { 1, "16x24", test_16x24 },
+    { 1, "segments", test_segments },
     BS_TEST_CASE_SENTINEL()
 };
 
@@ -330,4 +345,46 @@ void test_16x24(bs_test_t *test_ptr)
     bs_gfxbuf_destroy(gfxbuf_ptr);
 }
 
+/* ------------------------------------------------------------------------- */
+/** Tests that segment patterns draw the same as digits, and the minus sign. */
+void test_segments(bs_test_t *test_ptr)
+{
+    bs_gfxbuf_t *d_ptr = bs_gfxbuf_create(8, 12);
+    bs_gfxbuf_t *s_ptr = bs_gfxbuf_create(8, 12);
+    cairo_t *dc_ptr = NULL, *sc_ptr = NULL;
+    if (NULL == d_ptr || NULL == s_ptr ||
+        NULL == (dc_ptr = cairo_create_from_bs_gfxbuf(d_ptr)) ||
+        NULL == (sc_ptr = cairo_create_from_bs_gfxbuf(s_ptr))) {
+        BS_TEST_FAIL(test_ptr, "Failed to create buffers.");
+    } else {
+        // '8' illuminates all segments.
+        wlm_cairo_7segment_display_digit(
+            dc_ptr, &wlm_cairo_7segment_param_8x12, 0, 12,
+            0xffc0c0ff, 0xff202040, 8);
+        wlm_cairo_7segment_display_segments(
+            sc_ptr, &wlm_cairo_7segment_param_8x12, 0, 12,
+            0xffc0c0ff, 0xff202040, 0x7f);
+        cairo_surface_flush(cairo_get_target(dc_ptr));
+        cairo_surface_flush(cairo_get_target(sc_ptr));
+        BS_TEST_VERIFY_MEMEQ(test_ptr, d_ptr->data_ptr, s_ptr->data_ptr,
+                             8 * 12 * sizeof(uint32_t));
+
+        // The minus sign illuminates just the center: Center row is lit, top
+        // row is not.
+        bs_gfxbuf_clear(s_ptr, 0);
+        wlm_cairo_7segment_display_segments(
+            sc_ptr, &wlm_cairo_7segment_param_8x12, 0, 12,
+            0xffc0c0ff, 0xff202040, WLM_CAIRO_7SEGMENT_MINUS);
+        cairo_surface_flush(cairo_get_target(sc_ptr));
+        BS_TEST_VERIFY_NEQ(
+            test_ptr,
+            *bs_gfxbuf_pixel_at(s_ptr, 4, 1),
+            *bs_gfxbuf_pixel_at(s_ptr, 4, 6));
+    }
+    if (NULL != sc_ptr) cairo_destroy(sc_ptr);
+    if (NULL != dc_ptr) cairo_destroy(dc_ptr);
+    if (NULL != s_ptr) bs_gfxbuf_destroy(s_ptr);
+    if (NULL != d_ptr) bs_gfxbuf_destroy(d_ptr);
+}
+
 /* == End of segment_display.c ============================================= */
diff --git a/apps/primitives/segment_display.h b/apps/primitives/segment_display.h
index b2d06b4..4e3eeff 100644
--- a/apps/primitives/segment_display.h
+++ b/apps/primitives/segment_display.h
@@ -71,6 +71,34 @@ void wlm_cairo_7segment_display_digit(
     uint32_t color_off,
     uint8_t digit);
 
+/** Segment pattern for a minus sign, for @ref wlm_cairo_7segment_display_segments. */
+#define WLM_CAIRO_7SEGMENT_MINUS 0x40
+
+/**
+ * Draws an arbitrary pattern of the 7 segments.
+ *
+ * Bit n of `segments` illuminates segment n, with segment 0 at the top and
+ * continuing clockwise; segment 6 is the center. See
+ * https://en.wikipedia.org/wiki/Seven-segment_display for the sequence.
+ * A value of 0 draws all segments as not illuminated.
+ *
+ * @param cairo_ptr           The `cairo_t` target to draw the digits to.
+ * @param param_ptr           Visualization parameters for the segments.
+ * @param x                   X coordinate of lower left corner.
+ * @param y                   Y coordinate of lower left corner.
+ * @param color_on            An ARGB32 value for an illuminated segment.
+ * @param color_off           An ARGB32 value for a non-illuminated segment.
+ * @param segments            Bitmask of the segments to illuminate.
+ */
+void wlm_cairo_7segment_display_segments(
+    cairo_t *cairo_ptr,
+    const wlm_cairo_7segment_param_t *param_ptr,
+    uint32_t x,
+    uint32_t y,
+    uint32_t color_on,
+    uint32_t color_off,
+    uint8_t segments);
+
 /** Unit test cases. */
 extern const bs_test_set_t wlm_cairo_segment_display_test_set;
 
