+        _wlmaker_corner_init_action, _wlmaker_corner_fini_action),
+    BSPL_DESC_CUSTOM(
         "BottomRightEnter", false, wlmaker_corner_t,
         bottom_right_enter_action, bottom_right_enter_action,
-        WLMAKER_ACTION_NONE, wlmaker_action_desc),
-    BSPL_DESC_ENUM(
