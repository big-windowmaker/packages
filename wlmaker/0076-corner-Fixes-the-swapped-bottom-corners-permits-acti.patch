-        WLMAKER_ACTION_NONE, wlmaker_action_desc),
-    BSPL_DESC_ENUM(
+        _wlmaker_corner_decode_action, NULL,
+        _wlmaker_corner_init_action, _wlmaker_corner_fini_action),
+    BSPL_DESC_CUSTOM(
