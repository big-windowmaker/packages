From ef0fe3b37fd8eec50d7340bd5148dfd839c5a910 Mon Sep 17 00:00:00 2001
From: ruscher <rruscher@gmail.com>
Date: Tue, 27 Oct 2026 15:43:17 -0300
Subject: [PATCH] titlebar: Adds 'Justify' to the title bar style: Left, Center
 or Right.

Window Maker themes align the window title with 'TitleJustify' (left,
center or right); wlmaker always drew it at the left. The title bar style
gets an optional 'Justify' key, 'Left' by default, so existing themes look
the same:

    TitleBar = { ...; Justify = Center; };

A title wider than the title bar keeps starting at the left margin.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 include/toolkit/primitives.h | 21 +++++++++
 include/toolkit/style.h      |  9 ++++
 src/toolkit/primitives.c     | 85 +++++++++++++++++++++++++++++++++++-
 src/toolkit/titlebar.c       | 11 +++++
 src/toolkit/titlebar_title.c |  5 ++-
 5 files changed, 128 insertions(+), 3 deletions(-)

diff --git a/include/toolkit/primitives.h b/include/toolkit/primitives.h
index ac63eb5..49c3be6 100644
--- a/include/toolkit/primitives.h
+++ b/include/toolkit/primitives.h
@@ -148,6 +148,27 @@ void wlmaker_primitives_draw_window_title(
     const char *title_ptr,
     uint32_t color);
 
+/**
+ * Draws the window title into the `cairo_t`, aligned within `width`.
+ *
+ * A title wider than the space keeps to the left, as with
+ * @ref wlmaker_primitives_draw_window_title.
+ *
+ * @param cairo_ptr
+ * @param font_style_ptr      The font style to use.
+ * @param title_ptr           Title string, or NULL.
+ * @param color               As an ARGB 8888 value.
+ * @param width               Width of the title's area, in pixels.
+ * @param justify             Alignment of the title.
+ */
+void wlmaker_primitives_draw_justified_window_title(
+    cairo_t *cairo_ptr,
+    const wlmtk_style_font_t *font_style_ptr,
+    const char *title_ptr,
+    uint32_t color,
+    unsigned width,
+    wlmtk_style_justify_t justify);
+
 /**
  * Draws the text with given parameters into the `cairo_t` at (x, y).
  *
diff --git a/include/toolkit/style.h b/include/toolkit/style.h
index ffb4753..0b6f973 100644
--- a/include/toolkit/style.h
+++ b/include/toolkit/style.h
@@ -101,6 +101,13 @@ typedef enum {
     WLMTK_FONT_WEIGHT_BOLD,
 } wlmtk_style_font_weight_t;
 
+/** Horizontal alignment of a text, eg. of the window title. */
+typedef enum {
+    WLMTK_STYLE_JUSTIFY_LEFT,
+    WLMTK_STYLE_JUSTIFY_CENTER,
+    WLMTK_STYLE_JUSTIFY_RIGHT,
+} wlmtk_style_justify_t;
+
 /** Style of font. */
 typedef struct {
     /** Font face family name. */
@@ -138,6 +145,8 @@ struct wlmtk_titlebar_style {
     struct wlmtk_margin_style margin;
     /** Font style for the titlebar's title. */
     wlmtk_style_font_t       font;
+    /** Alignment of the title. Optional, left by default. */
+    wlmtk_style_justify_t    justify;
 };
 
 /** Translates the font weight from toolkit into cairo enum. */
diff --git a/src/toolkit/primitives.c b/src/toolkit/primitives.c
index 07e50bb..859c2f2 100644
--- a/src/toolkit/primitives.c
+++ b/src/toolkit/primitives.c
@@ -24,6 +24,39 @@
 #include <libbase/libbase.h>
 #include <stddef.h>
 
+/** Space between the title and the ends of the title bar, in pixels. */
+static const int _wlmaker_primitives_title_margin = 6;
+
+/* ------------------------------------------------------------------------- */
+/**
+ * Computes where a title starts, for the alignment.
+ *
+ * @param text_width          Width of the title's text.
+ * @param width               Width of the title's area.
+ * @param justify
+ *
+ * @return The X position. Never left of the margin.
+ */
+static int _wlmaker_primitives_title_x(
+    double text_width,
+    unsigned width,
+    wlmtk_style_justify_t justify)
+{
+    int x = _wlmaker_primitives_title_margin;
+    switch (justify) {
+    case WLMTK_STYLE_JUSTIFY_CENTER:
+        x = ((int)width - (int)(text_width + 0.5)) / 2;
+        break;
+    case WLMTK_STYLE_JUSTIFY_RIGHT:
+        x = (int)width - (int)(text_width + 0.5) -
+            _wlmaker_primitives_title_margin;
+        break;
+    default:
+        break;
+    }
+    return BS_MAX(x, _wlmaker_primitives_title_margin);
+}
+
 /* == Exported methods ===================================================== */
 
 /* ------------------------------------------------------------------------- */
@@ -241,12 +274,43 @@ void wlmaker_primitives_draw_window_title(
 {
     wlmaker_primitives_draw_text(
         cairo_ptr,
-        6, 2 + font_style_ptr->size,
+        _wlmaker_primitives_title_margin, 2 + font_style_ptr->size,
         font_style_ptr,
         color,
         title_ptr ? title_ptr : "Unnamed");
 }
 
+/* ------------------------------------------------------------------------- */
+void wlmaker_primitives_draw_justified_window_title(
+    cairo_t *cairo_ptr,
+    const wlmtk_style_font_t *font_style_ptr,
+    const char *title_ptr,
+    uint32_t color,
+    unsigned width,
+    wlmtk_style_justify_t justify)
+{
+    if (NULL == title_ptr) title_ptr = "Unnamed";
+
+    cairo_text_extents_t extents = {};
+    cairo_save(cairo_ptr);
+    cairo_select_font_face(
+        cairo_ptr,
+        font_style_ptr->face,
+        CAIRO_FONT_SLANT_NORMAL,
+        wlmtk_style_font_weight_cairo_from_wlmtk(font_style_ptr->weight));
+    cairo_set_font_size(cairo_ptr, font_style_ptr->size);
+    cairo_text_extents(cairo_ptr, title_ptr, &extents);
+    cairo_restore(cairo_ptr);
+
+    wlmaker_primitives_draw_text(
+        cairo_ptr,
+        _wlmaker_primitives_title_x(extents.x_advance, width, justify),
+        2 + font_style_ptr->size,
+        font_style_ptr,
+        color,
+        title_ptr);
+}
+
 /* ------------------------------------------------------------------------- */
 void wlmaker_primitives_draw_text(
     cairo_t *cairo_ptr,
@@ -280,6 +344,7 @@ static void test_minimize(bs_test_t *test_ptr);
 static void test_minimize_large(bs_test_t *test_ptr);
 static void test_text(bs_test_t *test_ptr);
 static void test_window_title(bs_test_t *test_ptr);
+static void test_title_x(bs_test_t *test_ptr);
 
 /** Unit tests. */
 /** Test cases */
@@ -293,6 +358,7 @@ static const bs_test_case_t _wlmaker_primitives_test_cases[] = {
     { 0, "minimize_large", test_minimize_large },
     { 0, "text", test_text },
     { 0, "window_title", test_window_title },
+    { 1, "title_x", test_title_x },
     BS_TEST_CASE_SENTINEL()
 };
 
@@ -459,4 +525,21 @@ void test_window_title(bs_test_t *test_ptr)
     bs_gfxbuf_destroy(gfxbuf_ptr);
 }
 
+/* ------------------------------------------------------------------------- */
+/** Tests @ref _wlmaker_primitives_title_x. */
+void test_title_x(bs_test_t *test_ptr)
+{
+    BS_TEST_VERIFY_EQ(
+        test_ptr, 6, _wlmaker_primitives_title_x(40, 100, WLMTK_STYLE_JUSTIFY_LEFT));
+    BS_TEST_VERIFY_EQ(
+        test_ptr, 30, _wlmaker_primitives_title_x(40, 100, WLMTK_STYLE_JUSTIFY_CENTER));
+    BS_TEST_VERIFY_EQ(
+        test_ptr, 54, _wlmaker_primitives_title_x(40, 100, WLMTK_STYLE_JUSTIFY_RIGHT));
+    // Too wide: Starts at the margin, like left-aligned.
+    BS_TEST_VERIFY_EQ(
+        test_ptr, 6, _wlmaker_primitives_title_x(120, 100, WLMTK_STYLE_JUSTIFY_CENTER));
+    BS_TEST_VERIFY_EQ(
+        test_ptr, 6, _wlmaker_primitives_title_x(120, 100, WLMTK_STYLE_JUSTIFY_RIGHT));
+}
+
 /* == End of primitives.c ================================================== */
diff --git a/src/toolkit/titlebar.c b/src/toolkit/titlebar.c
index 964cf61..292ffbe 100644
--- a/src/toolkit/titlebar.c
+++ b/src/toolkit/titlebar.c
@@ -89,6 +89,14 @@ static bool _wlmtk_titlebar_redraw(
 
 /* == Data ================================================================= */
 
+/** Values for the title's alignment ('Justify'), like Window Maker's. */
+static const bspl_enum_desc_t _wlmtk_titlebar_justify_desc[] = {
+    BSPL_ENUM("Left", WLMTK_STYLE_JUSTIFY_LEFT),
+    BSPL_ENUM("Center", WLMTK_STYLE_JUSTIFY_CENTER),
+    BSPL_ENUM("Right", WLMTK_STYLE_JUSTIFY_RIGHT),
+    BSPL_ENUM_SENTINEL()
+};
+
 const bspl_desc_t wlmtk_titlebar_style_desc[] = {
     BSPL_DESC_CUSTOM(
         "FocussedFill", true, struct wlmtk_titlebar_style, focussed_fill,
@@ -113,6 +121,9 @@ const bspl_desc_t wlmtk_titlebar_style_desc[] = {
     BSPL_DESC_DICT(
         "Font", true, struct wlmtk_titlebar_style, font, font,
         wlmtk_style_font_desc),
+    BSPL_DESC_ENUM(
+        "Justify", false, struct wlmtk_titlebar_style, justify, justify,
+        WLMTK_STYLE_JUSTIFY_LEFT, _wlmtk_titlebar_justify_desc),
     BSPL_DESC_SENTINEL()
 };
 
diff --git a/src/toolkit/titlebar_title.c b/src/toolkit/titlebar_title.c
index 7dfb7e8..836ffdf 100644
--- a/src/toolkit/titlebar_title.c
+++ b/src/toolkit/titlebar_title.c
@@ -336,8 +336,9 @@ struct wlr_buffer *title_create_buffer(
     wlmaker_primitives_draw_bezel_at(
         cairo_ptr, 0, 0, width,
         style_ptr->height, style_ptr->bezel_width, true);
-    wlmaker_primitives_draw_window_title(
-        cairo_ptr, &style_ptr->font, title_ptr, text_color);
+    wlmaker_primitives_draw_justified_window_title(
+        cairo_ptr, &style_ptr->font, title_ptr, text_color,
+        width, style_ptr->justify);
     cairo_destroy(cairo_ptr);
 
     return wlr_buffer_ptr;
-- 
2.55.0

