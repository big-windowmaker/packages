  */
 char *wlmaker_state_fname(wlm_util_files_t *files_ptr, const char *fname_ptr);
 
+/**
+ * Loads the default state: What a user starts with, before changing it.
+ *
+ * Takes the first of: `fname_ptr`, if given and existing; the file
+ * configured at build time (`WLMAKER_DEFAULT_STATE_FILE`), if existing;
+ * `State.plist` from the system's configuration directories
+ * (`${XDG_CONFIG_DIRS}/wlmaker`, not the user's); the compiled-in default.
+ *
+ * @param files_ptr
+ * @param fname_ptr           May be NULL.
+ *
+ * @return A dict, or NULL on error. To be unreferenced by the caller.
+ */
+bspl_dict_t *wlmaker_state_load_defaults(
+    wlm_util_files_t *files_ptr,
+    const char *fname_ptr);
+
 /**
  * Stores values into a section of the state: Loads the current state (like
  * @ref wlmaker_state_load), replaces or adds each key of `values_dict_ptr`
diff --git a/src/util/files.c b/src/util/files.c
index ed583e4..15574df 100644
--- a/src/util/files.c
+++ b/src/util/files.c
@@ -106,6 +106,27 @@ char *wlm_util_files_xdg_config_find(
     return NULL;
 }
 
+/* ------------------------------------------------------------------------- */
+char *wlm_util_files_xdg_config_find_system(
+    wlm_util_files_t *files_ptr,
+    const char *fname_ptr,
+    int mode_type)
+{
+    const char * const *dirs_ptr = xdgConfigDirectories(&files_ptr->xdg_handle);
+    if (NULL == dirs_ptr) return NULL;
+
+    for (; NULL != *dirs_ptr; ++dirs_ptr) {
+        char *candidate_path_ptr = bs_strdupf(
+            "%s/%s/%s", *dirs_ptr, files_ptr->dirname_ptr, fname_ptr);
+        if (NULL == candidate_path_ptr) return NULL;
+        if (bs_file_realpath_is(candidate_path_ptr, mode_type)) {
+            return candidate_path_ptr;
+        }
+        free(candidate_path_ptr);
+    }
+    return NULL;
+}
+
 /* ------------------------------------------------------------------------- */
 char *wlm_util_files_xdg_data_find(
     wlm_util_files_t *files_ptr,
diff --git a/src/util/files.h b/src/util/files.h
index 56a64e7..324a0c0 100644
--- a/src/util/files.h
+++ b/src/util/files.h
@@ -77,6 +77,18 @@ char *wlm_util_files_xdg_config_find(
     const char *fname_ptr,
     int mode_type);
 
+/**
+ * Like @ref wlm_util_files_xdg_config_find, but only looks in the system's
+ * directories `${XDG_CONFIG_DIRS}`: Not in the user's `${XDG_CONFIG_HOME}`.
+ * Eg. to find defaults of a file the user may have changed.
+ *
+ * @return Full path name, or NULL if not found. To be free()-ed.
+ */
+char *wlm_util_files_xdg_config_find_system(
+    wlm_util_files_t *files_ptr,
+    const char *fname_ptr,
+    int mode_type);
+
 /**
