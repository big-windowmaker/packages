From eabe17a86f2d4fb31bffe38f65293add3b5132b6 Mon Sep 17 00:00:00 2001
From: ruscher <rruscher@gmail.com>
Date: Thu, 5 Nov 2026 10:22:50 -0300
Subject: [PATCH] =?UTF-8?q?zones:=20o=20seletor=20larga=20o=20teclado=20qu?=
 =?UTF-8?q?ando=20a=20sess=C3=A3o=20=C3=A9=20bloqueada?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

O grab de teclado agora pode recusar uma tecla (ela segue como se não
houvesse grab). Com a sessão bloqueada, o seletor fecha e deixa as teclas
para a tela de bloqueio, em vez de consumir a senha; e não abre bloqueado.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/input/manager.c | 24 +++++++++++++++++++++---
 src/input/manager.h |  3 ++-
 src/zones.c         |  8 +++++++-
 3 files changed, 30 insertions(+), 5 deletions(-)

diff --git a/src/input/manager.c b/src/input/manager.c
index aa5978d..4c3d73a 100644
--- a/src/input/manager.c
+++ b/src/input/manager.c
@@ -491,9 +491,10 @@ bool wlmim_process_key(
     }
     if (NULL != im_ptr->key_grab_callback) {
         // A modal part of the compositor (eg. the zone picker) has the
-        // keyboard: Every press is consumed, and no binding runs.
-        im_ptr->key_grab_callback(keysym, modifiers, im_ptr->key_grab_ud_ptr);
-        return true;
+        // keyboard: The presses it consumes run no binding. One it declines
+        // goes on as usual.
+        if (im_ptr->key_grab_callback(
+                keysym, modifiers, im_ptr->key_grab_ud_ptr)) return true;
     }
     struct _wlmim_process_arg a = { .keysym = keysym, .modifiers = modifiers };
     return bs_dllist_any(&im_ptr->keybindings, _wlmim_process_keybinding, &a);
@@ -909,6 +910,14 @@ bool _wlmim_test_binding_callback(
     return true;
 }
 
+/** Test helper: A grab that consumes the press if `*ud_ptr` says so. */
+static bool _wlmim_test_grab_callback(
+    __UNUSED__ xkb_keysym_t keysym,
+    __UNUSED__ uint32_t modifiers,
+    void *ud_ptr) {
+    return *(bool*)ud_ptr;
+}
+
 /* ------------------------------------------------------------------------- */
 /** Tests key bindings. */
 void _wlmim_test_bind(bs_test_t *test_ptr)
@@ -959,6 +968,15 @@ void _wlmim_test_bind(bs_test_t *test_ptr)
         test_ptr,
         wlmim_process_key(&im, XKB_KEY_B, 0));
 
+    // A grab takes the presses; one it declines goes to the bindings.
+    bool consume = true;
+    wlmim_set_key_grab(&im, _wlmim_test_grab_callback, &consume);
+    BS_TEST_VERIFY_TRUE(test_ptr, wlmim_process_key(&im, XKB_KEY_z, 0));
+    consume = false;
+    BS_TEST_VERIFY_FALSE(test_ptr, wlmim_process_key(&im, XKB_KEY_z, 0));
+    BS_TEST_VERIFY_TRUE(test_ptr, wlmim_process_key(&im, XKB_KEY_b, 0));
+    wlmim_set_key_grab(&im, NULL, NULL);
+
     wlmim_unbind_key(&im, kb2_ptr);
     wlmim_unbind_key(&im, kb1_ptr);
 }
diff --git a/src/input/manager.h b/src/input/manager.h
index 2db10ef..6ba7639 100644
--- a/src/input/manager.h
+++ b/src/input/manager.h
@@ -240,7 +240,8 @@ void wlmim_unbind_key(
  * @param modifiers           See `enum wlr_keyboard_modifiers`.
  * @param ud_ptr
  *
- * @return Ignored: The press is consumed anyway.
+ * @return Whether the press was consumed. False lets it go on as if there
+ *     were no grab (eg. the grab gave up because the session got locked).
  */
 typedef bool (*wlmim_key_grab_callback_t)(
     xkb_keysym_t keysym,
diff --git a/src/zones.c b/src/zones.c
index 7d4f904..6684094 100644
--- a/src/zones.c
+++ b/src/zones.c
@@ -1220,7 +1220,12 @@ void _picker_apply(wlmaker_zones_t *zones_ptr, int idx)
 static bool _picker_key(xkb_keysym_t keysym, uint32_t modifiers, void *ud_ptr)
 {
     wlmaker_zones_t *zones_ptr = ud_ptr;
-    if (!zones_ptr->picker) return true;
+    if (!zones_ptr->picker) return false;
+    // Locked meanwhile: The keys belong to the lock screen (the password).
+    if (wlmtk_desktop_locked(zones_ptr->server_ptr->desktop_ptr)) {
+        _picker_close(zones_ptr);
+        return false;
+    }
     if (XKB_KEY_1 <= keysym && keysym <= XKB_KEY_9) {
         _picker_apply(zones_ptr, (int)(keysym - XKB_KEY_1));
         return true;
@@ -1278,6 +1283,7 @@ static wlmtk_window_t *_active(wlmaker_zones_t *zones_ptr)
 static void _picker_open(wlmaker_zones_t *zones_ptr)
 {
     if (zones_ptr->picker || NULL != zones_ptr->drag_window_ptr) return;
+    if (wlmtk_desktop_locked(zones_ptr->server_ptr->desktop_ptr)) return;
     wlmtk_window_t *window_ptr = _active(zones_ptr);
     if (!_snappable(zones_ptr, window_ptr)) return;
     zones_ptr->picker = true;
