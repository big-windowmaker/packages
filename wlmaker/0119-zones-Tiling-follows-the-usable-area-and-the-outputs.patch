 };
 
 /** State of the layer on the given output. */
@@ -54,6 +58,8 @@ struct _wlmtk_layer_output_t {
     struct wlr_box            usable_area;
     /** Panels. Holds nodes at @ref wlmtk_panel_t::dlnode. */
