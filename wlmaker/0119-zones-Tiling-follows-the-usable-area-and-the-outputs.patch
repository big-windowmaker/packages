From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ruscher <rruscher@gmail.com>
Date: Fri, 6 Nov 2026 10:28:10 -0300
Subject: [PATCH] zones: Tiling follows the usable area and the outputs

The tiling cells were computed when a window came or went, never when the
usable area changed: a Dock, Clip or panel with an exclusive zone that
appeared, moved or went away left the cells under it (or a gap) until the
user asked to apply again; same after an output was plugged, unplugged or
changed mode or scale.

The toolkit raises wlmtk_desktop_events_t::usable_area_changed when the
usable area of an output changes (only then: a panel without exclusive
zone does not), and zones relayouts on it and on the output layout's
change signal (closing the picker and the overlay).

Tests: unit test layer usable_area_signal; wmake-zones' Wayland
functional suite with a layer-shell panel with an exclusive zone (47/47;
without this change the panel case fails). ctest 29/29.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 include/toolkit/desktop.h |  5 +++
 src/toolkit/desktop.c     | 15 +++++++++
 src/toolkit/layer.c       | 71 +++++++++++++++++++++++++++++++++++++++
 src/zones.c               | 34 +++++++++++++++++++
 4 files changed, 125 insertions(+)

diff --git a/include/toolkit/desktop.h b/include/toolkit/desktop.h
index 2ff2dcc..2995e54 100644
--- a/include/toolkit/desktop.h
+++ b/include/toolkit/desktop.h
@@ -79,6 +79,11 @@ typedef struct {
      * size). Data: @ref wlmtk_window_move_event_t.
      */
     struct wl_signal          window_resize_end;
+    /**
+     * The usable area of an output changed (a Dock, Clip or panel with an
+     * exclusive zone moved, appeared or went away). Data: NULL.
+     */
+    struct wl_signal          usable_area_changed;
 } wlmtk_desktop_events_t;
 
 /** Data of the window move signals. Coordinates in layout space. */
diff --git a/src/toolkit/desktop.c b/src/toolkit/desktop.c
index f2f986d..5ba084f 100644
--- a/src/toolkit/desktop.c
+++ b/src/toolkit/desktop.c
@@ -176,6 +176,8 @@ wlmtk_desktop_t *wlmtk_desktop_create(
         &desktop_ptr->container.super_element,
         &_wlmtk_desktop_element_vmt);
 
+    // Before the layers: they hold a pointer to it.
+    wl_signal_init(&desktop_ptr->events.usable_area_changed);
     for (int i = 0; i <= WLMTK_DESKTOP_LAYER_OVERLAY; ++i) {
         wlmtk_layer_t *layer_ptr = wlmtk_layer_create(wlr_output_layout_ptr);
         if (NULL == layer_ptr) {
@@ -679,6 +681,7 @@ void _wlmtk_desktop_element_layout(wlmtk_element_t *element_ptr)
         element_ptr, wlmtk_desktop_t, container.super_element);
 
     // Process each output.
+    bool changed = false;
     struct wlr_output_layout_output *wlr_output_layout_output_ptr;
     wl_list_for_each(
         wlr_output_layout_output_ptr,
@@ -698,6 +701,15 @@ void _wlmtk_desktop_element_layout(wlmtk_element_t *element_ptr)
                 &usable_area);
         }
 
+        // Signals usable_area_changed only when the area changed (a panel
+        // without exclusive zone does not change it).
+        if (NULL != desktop_ptr->current_workspace_ptr) {
+            struct wlr_box old_area = wlmtk_workspace_get_maximize_extents(
+                desktop_ptr->current_workspace_ptr,
+                wlr_output_layout_output_ptr->output);
+            if (!wlr_box_equal(&old_area, &usable_area)) changed = true;
+        }
+
         for (bs_dllist_node_t *node_ptr = desktop_ptr->workspaces.head_ptr;
              node_ptr != NULL;
              node_ptr = bs_dllist_node_iterator_forward(node_ptr)) {
@@ -709,6 +721,9 @@ void _wlmtk_desktop_element_layout(wlmtk_element_t *element_ptr)
         }
     }
     desktop_ptr->orig_super_element_vmt.layout(element_ptr);
+    if (changed) {
+        wl_signal_emit(&desktop_ptr->events.usable_area_changed, NULL);
+    }
 }
 
 /* ------------------------------------------------------------------------- */
diff --git a/src/toolkit/layer.c b/src/toolkit/layer.c
index 2dcca7d..d152604 100644
--- a/src/toolkit/layer.c
+++ b/src/toolkit/layer.c
@@ -97,6 +97,7 @@ wlmtk_layer_t *wlmtk_layer_create(
         return NULL;
     }
 
+    layer_ptr->wlr_output_layout_ptr = wlr_output_layout_ptr;
     layer_ptr->output_tracker_ptr = wlmtk_output_tracker_create(
         wlr_output_layout_ptr,
         layer_ptr,
@@ -358,12 +359,14 @@ void _wlmtk_layer_output_destroy(
 static void test_multi_output(bs_test_t *test_ptr);
 static void test_layout(bs_test_t *test_ptr);
 static void test_full_edge(bs_test_t *test_ptr);
+static void test_usable_area_signal(bs_test_t *test_ptr);
 
 /** Test cases */
 static const bs_test_case_t _wlmtk_layer_test_cases[] = {
     { 1, "multi_output", test_multi_output },
     { 1, "layout", test_layout },
     { 1, "full_edge", test_full_edge },
+    { 1, "usable_area_signal", test_usable_area_signal },
     BS_TEST_CASE_SENTINEL()
 };
 
@@ -638,4 +641,72 @@ void test_full_edge(bs_test_t *test_ptr)
     wl_display_destroy(display_ptr);
 }
 
+/* ------------------------------------------------------------------------- */
+/** Counts emissions of the usable area signal. */
+typedef struct {
+    struct wl_listener        listener;
+    int                       count;
+} _usable_area_counter_t;
+
+static void _usable_area_counter(struct wl_listener *listener_ptr,
+                                 __UNUSED__ void *data_ptr)
+{
+    BS_CONTAINER_OF(listener_ptr, _usable_area_counter_t, listener)->count++;
+}
+
+/** The signal fires when a panel with an exclusive zone comes or goes, not
+ * for a panel that leaves the usable area as it was. */
+void test_usable_area_signal(bs_test_t *test_ptr)
+{
+    struct wl_display *display_ptr = wl_display_create();
+    BS_TEST_VERIFY_NEQ_OR_RETURN(test_ptr, NULL, display_ptr);
+    struct wlr_output_layout *wlr_output_layout_ptr =
+        wlr_output_layout_create(display_ptr);
+    struct wlr_output output = { .width = 1280, .height = 800, .scale = 1 };
+    wlmtk_test_wlr_output_init(&output);
+    wlr_output_layout_add(wlr_output_layout_ptr, &output, 0, 0);
+    wlmtk_layer_t *layer_ptr = wlmtk_layer_create(wlr_output_layout_ptr);
+    BS_TEST_VERIFY_NEQ_OR_RETURN(test_ptr, NULL, layer_ptr);
+    struct wl_signal signal;
+    wl_signal_init(&signal);
+    _usable_area_counter_t counter = { .count = 0 };
+    counter.listener.notify = _usable_area_counter;
+    wl_signal_add(&signal, &counter.listener);
+    wlmtk_layer_set_usable_area_signal(layer_ptr, &signal);
+
+    // A Dock: exclusive on the right. Changes the area: one emission.
+    wlmtk_panel_positioning_t dock_pos = {
+        .desired_width = 64, .desired_height = 64, .exclusive_zone = 64,
+        .anchor = WLR_EDGE_RIGHT | WLR_EDGE_TOP,
+        .exclusive_edge = WLR_EDGE_RIGHT };
+    wlmtk_fake_panel_t *dock_ptr = wlmtk_fake_panel_create(&dock_pos);
+    BS_TEST_VERIFY_NEQ_OR_RETURN(test_ptr, NULL, dock_ptr);
+    wlmtk_element_set_visible(wlmtk_panel_element(&dock_ptr->panel), true);
+    wlmtk_layer_add_panel(layer_ptr, &dock_ptr->panel, &output);
+    BS_TEST_VERIFY_EQ(test_ptr, 1, counter.count);
+
+    // A panel without exclusive zone: same area, no emission.
+    wlmtk_panel_positioning_t pos = dock_pos;
+    pos.exclusive_zone = 0;
+    pos.anchor = WLR_EDGE_LEFT | WLR_EDGE_BOTTOM;
+    wlmtk_fake_panel_t *p_ptr = wlmtk_fake_panel_create(&pos);
+    BS_TEST_VERIFY_NEQ_OR_RETURN(test_ptr, NULL, p_ptr);
+    wlmtk_element_set_visible(wlmtk_panel_element(&p_ptr->panel), true);
+    wlmtk_layer_add_panel(layer_ptr, &p_ptr->panel, &output);
+    BS_TEST_VERIFY_EQ(test_ptr, 1, counter.count);
+
+    // The Dock goes away: the area grows back.
+    wlmtk_layer_remove_panel(layer_ptr, &dock_ptr->panel);
+    BS_TEST_VERIFY_EQ(test_ptr, 2, counter.count);
+
+    wlmtk_layer_remove_panel(layer_ptr, &p_ptr->panel);
+    wlmtk_fake_panel_destroy(p_ptr);
+    wlmtk_fake_panel_destroy(dock_ptr);
+    wl_list_remove(&counter.listener.link);
+    wlmtk_layer_destroy(layer_ptr);
+    wlr_output_layout_remove(wlr_output_layout_ptr, &output);
+    wlr_output_layout_destroy(wlr_output_layout_ptr);
+    wl_display_destroy(display_ptr);
+}
+
 /* == End of layer.c ======================================================= */
diff --git a/src/zones.c b/src/zones.c
index c4bb1cc..8aec078 100644
--- a/src/zones.c
+++ b/src/zones.c
@@ -274,6 +274,10 @@ struct _wlmaker_zones_t {
     struct wl_listener        window_unmapped_listener;
     /** Listener for @ref wlmtk_desktop_events_t::workspace_changed. */
     struct wl_listener        workspace_changed_listener;
+    /** Listener for @ref wlmtk_desktop_events_t::usable_area_changed. */
+    struct wl_listener        usable_area_listener;
+    /** Listener for wlr_output_layout::events.change (hotplug, mode, scale). */
+    struct wl_listener        output_layout_change_listener;
 };
 
 static void _wlmaker_zones_overlay_hide(wlmaker_zones_t *zones_ptr);
@@ -2056,6 +2060,30 @@ static void _wlmaker_zones_handle_window_unmapped(
 }
 
 /** The workspace changed. */
+/**
+ * The usable area changed (the Dock, the Clip or a panel moved, appeared or
+ * went away): the tiling follows it. Before, the cells stayed where they
+ * were, under the Dock or leaving a gap, until "apply again".
+ */
+static void _wlmaker_zones_handle_usable_area(
+    struct wl_listener *listener_ptr, __UNUSED__ void *data_ptr)
+{
+    wlmaker_zones_t *zones_ptr = BS_CONTAINER_OF(
+        listener_ptr, wlmaker_zones_t, usable_area_listener);
+    _wlmaker_zones_tile_mark(zones_ptr);
+}
+
+/** An output was added, removed, moved or changed mode or scale. */
+static void _wlmaker_zones_handle_output_layout_change(
+    struct wl_listener *listener_ptr, __UNUSED__ void *data_ptr)
+{
+    wlmaker_zones_t *zones_ptr = BS_CONTAINER_OF(
+        listener_ptr, wlmaker_zones_t, output_layout_change_listener);
+    _picker_close(zones_ptr);
+    _wlmaker_zones_overlay_hide(zones_ptr);
+    _wlmaker_zones_tile_mark(zones_ptr);
+}
+
 static void _wlmaker_zones_handle_workspace_changed(
     struct wl_listener *listener_ptr, __UNUSED__ void *data_ptr)
 {
@@ -2766,6 +2794,10 @@ wlmaker_zones_t *wlmaker_zones_create(wlmaker_server_t *server_ptr)
         &zones_ptr->window_unmapped_listener, _wlmaker_zones_handle_window_unmapped);
     wlmtk_util_connect_listener_signal(&e->workspace_changed,
         &zones_ptr->workspace_changed_listener, _wlmaker_zones_handle_workspace_changed);
+    wlmtk_util_connect_listener_signal(&e->usable_area_changed,
+        &zones_ptr->usable_area_listener, _wlmaker_zones_handle_usable_area);
+    wlmtk_util_connect_listener_signal(&server_ptr->wlr_output_layout_ptr->events.change,
+        &zones_ptr->output_layout_change_listener, _wlmaker_zones_handle_output_layout_change);
 
     struct wl_event_loop *loop_ptr = wl_display_get_event_loop(server_ptr->wl_display_ptr);
     zones_ptr->tile_timer_ptr = wl_event_loop_add_timer(
@@ -2831,6 +2863,8 @@ void wlmaker_zones_destroy(wlmaker_zones_t *zones_ptr)
     for (size_t i = 0; i < sizeof(timers) / sizeof(timers[0]); ++i) {
         if (NULL != timers[i]) wl_event_source_remove(timers[i]);
     }
+    wlmtk_util_disconnect_listener(&zones_ptr->output_layout_change_listener);
+    wlmtk_util_disconnect_listener(&zones_ptr->usable_area_listener);
     wlmtk_util_disconnect_listener(&zones_ptr->workspace_changed_listener);
     wlmtk_util_disconnect_listener(&zones_ptr->window_unmapped_listener);
     wlmtk_util_disconnect_listener(&zones_ptr->window_mapped_listener);
-- 
