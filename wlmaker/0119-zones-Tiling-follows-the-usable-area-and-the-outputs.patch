     if (!wlmtk_container_init(&desktop_ptr->workspace_window_container)) {
diff --git a/src/toolkit/layer.c b/src/toolkit/layer.c
index a572e58..c55acbe 100644
--- a/src/toolkit/layer.c
+++ b/src/toolkit/layer.c
@@ -44,6 +44,10 @@ struct _wlmtk_layer_t {
     wlmtk_container_t         super_container;
     /** Tracks the outputs. */
     wlmtk_output_tracker_t    *output_tracker_ptr;
+    /** The output layout. */
+    struct wlr_output_layout  *wlr_output_layout_ptr;
