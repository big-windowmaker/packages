+        }
+        if (NULL != window_ptr &&
+            NULL != next_workspace_ptr &&
+            workspace_ptr != next_workspace_ptr) {
+            wlmtk_workspace_unmap_window(workspace_ptr, window_ptr);
+            wlmtk_workspace_map_window(next_workspace_ptr, window_ptr);
+        }
