         wlmtk_desktop_destroy_last_workspace(server_ptr->desktop_ptr);
         break;
 
+    case WLMAKER_ACTION_WORKSPACE_SWITCH_TO:
+        if (_wlmaker_action_workspace_index(arg_ptr, &workspaces)) {
+            wlmtk_desktop_switch_to_workspace_at(
