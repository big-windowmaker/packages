@@ -127,10 +132,12 @@ const bspl_enum_desc_t wlmaker_action_desc[] = {
     BSPL_ENUM("WindowFullscreen", WLMAKER_ACTION_WINDOW_FULLSCREEN),
     BSPL_ENUM("WindowShade", WLMAKER_ACTION_WINDOW_SHADE),
