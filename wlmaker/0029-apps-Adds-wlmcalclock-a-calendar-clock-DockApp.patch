+/* ========================================================================= */
+/**
+ * @file wlm_calendar.h
+ *
+ * Date & time formatting for the calendar clock DockApp (`wlmcalclock`).
+ *
+ * @copyright
+ * Copyright (c) 2026 Philipp Kaeser (kaeser@gubbe.ch)
+ * Copyright 2026 Google LLC
