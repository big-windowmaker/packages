+    if (NULL != xs_ptr->dockapp_icon_ptr) _xwl_surface_dockapp_shape(xs_ptr);
+    if (0 >= --xs_ptr->dockapp_shape_checks) {
+        wlmtk_util_disconnect_listener(&xs_ptr->dockapp_commit_listener);
+    }
+}
