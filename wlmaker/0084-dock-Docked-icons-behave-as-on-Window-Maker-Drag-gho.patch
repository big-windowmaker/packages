+void _wlmaker_clip_reload_launchers(wlmaker_clip_t *clip_ptr)
+{
     wlmaker_server_t *server_ptr = clip_ptr->server_ptr;
     bspl_dict_t *state_dict_ptr = wlmaker_state_load(
         server_ptr->files_ptr, server_ptr->state_fname_ptr);
