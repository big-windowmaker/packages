diff --git a/src/tile_drag.c b/src/tile_drag.c
new file mode 100644
index 0000000..897b503
--- /dev/null
+++ b/src/tile_drag.c
@@ -0,0 +1,674 @@
+/* ========================================================================= */
+/**
+ * @file tile_drag.c
