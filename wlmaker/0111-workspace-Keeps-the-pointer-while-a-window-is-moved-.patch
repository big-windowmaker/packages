From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ruscher <rruscher@gmail.com>
Date: Thu, 5 Nov 2026 09:06:39 -0300
Subject: [PATCH] workspace: Keeps the pointer while a window is moved or
 resized

A fast motion could take the pointer off the window in a single event,
before the window followed: The window container then blurred itself
and the move ended where it was. The workspace now holds a pointer grab
during a move or resize, accepts the motion itself, and ends the move
cleanly if another element takes the grab. Also emits window_resize_end
when an interactive resize ends, for window organizers.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 include/toolkit/desktop.h |  5 +++++
 src/toolkit/desktop.c     |  1 +
 src/toolkit/workspace.c   | 14 ++++++++++++--
 3 files changed, 18 insertions(+), 2 deletions(-)

diff --git a/include/toolkit/desktop.h b/include/toolkit/desktop.h
index 61edbcd..2ff2dcc 100644
--- a/include/toolkit/desktop.h
+++ b/include/toolkit/desktop.h
@@ -74,6 +74,11 @@ typedef struct {
     struct wl_signal          window_move_motion;
     /** See @ref wlmtk_desktop_events_t::window_move_begin. */
     struct wl_signal          window_move_end;
+    /**
+     * An interactive resize ended (the client may still be adopting the
+     * size). Data: @ref wlmtk_window_move_event_t.
+     */
+    struct wl_signal          window_resize_end;
 } wlmtk_desktop_events_t;
 
 /** Data of the window move signals. Coordinates in layout space. */
diff --git a/src/toolkit/desktop.c b/src/toolkit/desktop.c
index 82bd945..f2f986d 100644
--- a/src/toolkit/desktop.c
+++ b/src/toolkit/desktop.c
@@ -259,6 +259,7 @@ wlmtk_desktop_t *wlmtk_desktop_create(
     wl_signal_init(&desktop_ptr->events.window_move_begin);
     wl_signal_init(&desktop_ptr->events.window_move_motion);
     wl_signal_init(&desktop_ptr->events.window_move_end);
+    wl_signal_init(&desktop_ptr->events.window_resize_end);
     return desktop_ptr;
 }
 
diff --git a/src/toolkit/workspace.c b/src/toolkit/workspace.c
index 3762290..8b4d9a7 100644
--- a/src/toolkit/workspace.c
+++ b/src/toolkit/workspace.c
@@ -95,6 +95,8 @@ struct _wlmtk_workspace_t {
     uint32_t                  resize_edges;
     /** Whether the grab is a move (signals @ref wlmtk_desktop_events_t). */
     bool                      moving;
+    /** Whether an interactive resize is going on (for window_resize_end). */
+    bool                      resizing;
 
     /** Top left X coordinate of workspace. */
     int                       x1;
@@ -176,7 +178,9 @@ static struct wlr_box _wlmtk_workspace_usable_area(
     struct wlr_output *wlr_output_ptr);
 
 /** Which window move signal to emit. */
-enum { WLMTK_WS_MOVE_BEGIN, WLMTK_WS_MOVE_MOTION, WLMTK_WS_MOVE_END };
+enum {
+    WLMTK_WS_MOVE_BEGIN, WLMTK_WS_MOVE_MOTION, WLMTK_WS_MOVE_END, WLMTK_WS_RESIZE_END
+};
 static void _wlmtk_workspace_emit_move(wlmtk_workspace_t *workspace_ptr, int which);
 static bool pfsm_move_begin(wlmtk_fsm_t *fsm_ptr, void *ud_ptr);
 static bool pfsm_move_motion(wlmtk_fsm_t *fsm_ptr, void *ud_ptr);
@@ -1262,7 +1266,8 @@ void _wlmtk_workspace_emit_move(wlmtk_workspace_t *workspace_ptr, int which)
     };
     wlmtk_desktop_events_t *e = wlmtk_desktop_events(workspace_ptr->desktop_ptr);
     struct wl_signal *s = which == WLMTK_WS_MOVE_BEGIN ? &e->window_move_begin :
-        which == WLMTK_WS_MOVE_MOTION ? &e->window_move_motion : &e->window_move_end;
+        which == WLMTK_WS_MOVE_MOTION ? &e->window_move_motion :
+        which == WLMTK_WS_RESIZE_END ? &e->window_resize_end : &e->window_move_end;
     wl_signal_emit(s, &ev);
 }
 
@@ -1352,6 +1357,7 @@ bool pfsm_resize_begin(wlmtk_fsm_t *fsm_ptr, void *ud_ptr)
     if (NULL != e->parent_container_ptr) {
         wlmtk_container_pointer_grab(e->parent_container_ptr, e);
     }
+    workspace_ptr->resizing = true;
     return true;
 }
 
@@ -1411,6 +1417,10 @@ bool pfsm_reset(wlmtk_fsm_t *fsm_ptr, __UNUSED__ void *ud_ptr)
         _wlmtk_workspace_emit_move(workspace_ptr, WLMTK_WS_MOVE_END);
         workspace_ptr->moving = false;
     }
+    if (workspace_ptr->resizing) {
+        _wlmtk_workspace_emit_move(workspace_ptr, WLMTK_WS_RESIZE_END);
+        workspace_ptr->resizing = false;
+    }
     workspace_ptr->grabbed_window_ptr = NULL;
     wlmtk_element_t *e = wlmtk_workspace_window_element(workspace_ptr);
     if (NULL != e->parent_container_ptr) {
-- 
