From 24781c5a18577bcdb9317d395c79c961a05c9997 Mon Sep 17 00:00:00 2001
From: ruscher <rruscher@gmail.com>
Date: Fri, 6 Nov 2026 17:11:43 -0300
Subject: [PATCH] zones: Tiling checks the client's minimum size

GTK4/libadwaita clients ask for large minimum sizes (Pamac 760x200, GNOME
Calculator 360x616). Tiling put them into smaller cells anyway and they
overflowed onto their neighbours and past the output.

The toolkit window now keeps the minimum content size the client asks
for (xdg_toplevel min_width/min_height, or the X11 size hints through
XWayland) and tells window organizers the minimum bounding box, with the
decoration. Tiling then, as wmake-zones does on X11:

- a single window that does not fit swaps places with another one when
  both fit then;
- otherwise the one farthest from fitting floats (restored to its box)
  and the layout is recomputed, one window at a time; logged once;
- "windows -d" tells why each window is or is not tiled.

Tested with wmake-zones' Wayland functional suite (51/51, including a
window whose minimum fits no cell) and Pamac, GNOME Calculator and
BigLinux Settings in a nested wlmaker.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 include/toolkit/window.h |  27 +++++
 src/toolkit/window.c     |  31 ++++++
 src/xdg_toplevel.c       |   6 ++
 src/xwl_surface.c        |   6 ++
 src/zones.c              | 206 +++++++++++++++++++++++++++++++++------
 5 files changed, 244 insertions(+), 32 deletions(-)

diff --git a/include/toolkit/window.h b/include/toolkit/window.h
index 6e2bdab..509bfb9 100644
--- a/include/toolkit/window.h
+++ b/include/toolkit/window.h
@@ -196,6 +196,33 @@ void wlmtk_window_request_bounding_box(
     wlmtk_window_t *window_ptr,
     const struct wlr_box *box_ptr);
 
+/**
+ * Stores the minimum content size the client asks for (xdg_toplevel
+ * min_width/min_height, or the X11 WM_NORMAL_HINTS). 0: No minimum.
+ *
+ * @param window_ptr
+ * @param width
+ * @param height
+ */
+void wlmtk_window_set_min_size(
+    wlmtk_window_t *window_ptr,
+    int width,
+    int height);
+
+/**
+ * Minimum size of the bounding box: The client's minimum content size plus
+ * the decoration. For window organizers, to tell whether a window fits a
+ * cell. Each dimension is 0 when the client sets no minimum for it.
+ *
+ * @param window_ptr
+ * @param width_ptr
+ * @param height_ptr
+ */
+void wlmtk_window_get_min_bounding_size(
+    wlmtk_window_t *window_ptr,
+    int *width_ptr,
+    int *height_ptr);
+
 /** Helper: Indicates that the position has changed. */
 void wlmtk_window_position_changed(wlmtk_window_t *window_ptr);
 
diff --git a/src/toolkit/window.c b/src/toolkit/window.c
index 2d7d128..552c986 100644
--- a/src/toolkit/window.c
+++ b/src/toolkit/window.c
@@ -53,6 +53,10 @@
 struct _wlmtk_window_t {
     /** Bordered, wraps around the box. */
     wlmtk_bordered_t          bordered;
+    /** Minimum content width asked by the client; 0: none. */
+    int                       min_width;
+    /** Minimum content height asked by the client; 0: none. */
+    int                       min_height;
     /** Original virtual method table of the window's element superclass. */
     wlmtk_element_vmt_t       orig_super_element_vmt;
 
@@ -430,6 +434,33 @@ void wlmtk_window_request_bounding_box(
     wlmtk_window_request_size(window_ptr, &content);
 }
 
+/* ------------------------------------------------------------------------- */
+void wlmtk_window_set_min_size(
+    wlmtk_window_t *window_ptr,
+    int width,
+    int height)
+{
+    window_ptr->min_width = BS_MAX(0, width);
+    window_ptr->min_height = BS_MAX(0, height);
+}
+
+/* ------------------------------------------------------------------------- */
+void wlmtk_window_get_min_bounding_size(
+    wlmtk_window_t *window_ptr,
+    int *width_ptr,
+    int *height_ptr)
+{
+    // Decorations as in wlmtk_window_request_bounding_box.
+    struct wlr_box wbox = wlmtk_element_get_dimensions_box(
+        wlmtk_bordered_element(&window_ptr->bordered));
+    struct wlr_box cbox = wlmtk_element_get_dimensions_box(
+        window_ptr->content_element_ptr);
+    *width_ptr = 0 < window_ptr->min_width ?
+        window_ptr->min_width + (wbox.width - cbox.width) : 0;
+    *height_ptr = 0 < window_ptr->min_height ?
+        window_ptr->min_height + (wbox.height - cbox.height) : 0;
+}
+
 /* ------------------------------------------------------------------------- */
 void wlmtk_window_position_changed(wlmtk_window_t *window_ptr)
 {
diff --git a/src/xdg_toplevel.c b/src/xdg_toplevel.c
index 07ff972..851dcbb 100644
--- a/src/xdg_toplevel.c
+++ b/src/xdg_toplevel.c
@@ -823,6 +823,12 @@ void _wlmaker_xdg_toplevel_handle_surface_commit(
     }
     wlmtk_window_commit_size(
         wxt_ptr->window_ptr, geo.width - geo.x, geo.height - geo.y);
+    // The client's minimum (GTK4/libadwaita ask for large ones): Tiling
+    // checks it before putting the window into a cell.
+    wlmtk_window_set_min_size(
+        wxt_ptr->window_ptr,
+        wxt_ptr->wlr_xdg_toplevel_ptr->current.min_width,
+        wxt_ptr->wlr_xdg_toplevel_ptr->current.min_height);
 
     if (0 != wxt_ptr->pending.properties) {
         _wlmaker_xdg_toplevel_flush_properties(wxt_ptr);
diff --git a/src/xwl_surface.c b/src/xwl_surface.c
index 2fa44be..e068031 100644
--- a/src/xwl_surface.c
+++ b/src/xwl_surface.c
@@ -777,6 +777,12 @@ void _xwl_surface_map_window(wlmaker_xwl_surface_t *xwl_surface_ptr)
     wlmtk_window_placement_hint_t hint = {};
     if (NULL != xws_ptr->size_hints) {
         uint32_t flags = xws_ptr->size_hints->flags;
+        if (flags & XCB_ICCCM_SIZE_HINT_P_MIN_SIZE) {
+            wlmtk_window_set_min_size(
+                xwl_surface_ptr->window_ptr,
+                xws_ptr->size_hints->min_width,
+                xws_ptr->size_hints->min_height);
+        }
         if ((flags & XCB_ICCCM_SIZE_HINT_US_POSITION) ||
             ((flags & XCB_ICCCM_SIZE_HINT_P_POSITION) &&
              (0 != xws_ptr->x || 0 != xws_ptr->y))) {
diff --git a/src/zones.c b/src/zones.c
index b8784fd..04995e5 100644
--- a/src/zones.c
+++ b/src/zones.c
@@ -111,6 +111,18 @@ typedef struct {
     bool                      rule_float;
     /** Rule: Left alone by zones and tiling. */
     bool                      rule_ignore;
+    /** Did not fit its cell in the last tiling run: floats meanwhile. */
+    bool                      fit_float;
+    /** Same, in the run before (the log line comes once). */
+    bool                      fit_prev;
+    /** Minimum box that did not fit (for "windows -d"). */
+    int                       fit_min_w;
+    /** See @ref zones_window_t::fit_min_w. */
+    int                       fit_min_h;
+    /** The cell it did not fit. */
+    int                       fit_cell_w;
+    /** See @ref zones_window_t::fit_cell_w. */
+    int                       fit_cell_h;
 } zones_window_t;
 
 /** Tiling set: One output on one workspace. */
@@ -1820,6 +1832,64 @@ static void _apply_rules(wlmaker_zones_t *zones_ptr, zones_window_t *w)
     }
 }
 
+/** The window's app ID for the log, "?" when it has none. */
+static const char *_app_id(wlmtk_window_t *window_ptr)
+{
+    const char *a = wlmtk_window_get_app_id(window_ptr);
+    return NULL != a ? a : "?";
+}
+
+/** Cells for the tiling set (output and workspace): `rects` in the order
+ * of `set` (reordered by the BSP leaves). @return how many. */
+static int _tile_compute(zones_tset_t *ts,
+                         const wz_tile_params *p_ptr,
+                         wz_rect area,
+                         zones_window_t **set,
+                         int k,
+                         wz_rect *rects,
+                         wlmtk_window_t *active_ptr)
+{
+    if (WZ_TILE_BSP == p_ptr->algo && NULL != ts) {
+        // Persistent tree: Leaves of windows gone leave; new windows
+        // split the leaf of the active one.
+        long ids[WINDOWS_MAX];
+        wz_rect tmp[WINDOWS_MAX];
+        int m = wz_bsp_compute(&ts->bsp, area, 0, 0, tmp, ids, WINDOWS_MAX);
+        for (int a = 0; a < m; ++a) {
+            bool found = false;
+            for (int j = 0; j < k; ++j) {
+                found |= (long)(uintptr_t)set[j]->window_ptr == ids[a];
+            }
+            if (!found) wz_bsp_remove(&ts->bsp, ids[a]);
+        }
+        for (int j = 0; j < k; ++j) {
+            if (!wz_bsp_has(&ts->bsp, (long)(uintptr_t)set[j]->window_ptr)) {
+                wz_bsp_insert(&ts->bsp, (long)(uintptr_t)set[j]->window_ptr,
+                              (long)(uintptr_t)active_ptr, area);
+            }
+        }
+        int gi = p_ptr->gap_in, go = p_ptr->gap_out;
+        if (p_ptr->smart_gaps && 1 == k) gi = go = 0;
+        m = wz_bsp_compute(&ts->bsp, area, gi, go, tmp, ids, WINDOWS_MAX);
+        zones_window_t *ord[WINDOWS_MAX];
+        int c = 0;
+        for (int a = 0; a < m && c < k; ++a) {
+            for (int j = 0; j < k; ++j) {
+                if ((long)(uintptr_t)set[j]->window_ptr == ids[a]) {
+                    ord[c] = set[j];
+                    rects[c++] = tmp[a];
+                }
+            }
+        }
+        memcpy(set, ord, sizeof(set[0]) * (size_t)c);
+        k = c;
+    } else {
+        int m = wz_tile(p_ptr, area, k, rects, WINDOWS_MAX);
+        k = BS_MAX(0, BS_MIN(k, m));
+    }
+    return k;
+}
+
 /** Tiles the windows of the current workspace, per output. */
 int _wlmaker_zones_tile_run(void *data_ptr)
 {
@@ -1888,43 +1958,79 @@ int _wlmaker_zones_tile_run(void *data_ptr)
             zones_ptr->server_ptr->desktop_ptr, o);
         wz_rect area = { u.x, u.y, u.width, u.height };
         wz_rect rects[WINDOWS_MAX];
-        if (WZ_TILE_BSP == p.algo && NULL != ts) {
-            // Persistent tree: Leaves of windows gone leave; new windows
-            // split the leaf of the active one.
-            long ids[WINDOWS_MAX];
-            wz_rect tmp[WINDOWS_MAX];
-            int m = wz_bsp_compute(&ts->bsp, area, 0, 0, tmp, ids, WINDOWS_MAX);
-            for (int a = 0; a < m; ++a) {
-                bool found = false;
-                for (int j = 0; j < k; ++j) {
-                    found |= (long)(uintptr_t)set[j]->window_ptr == ids[a];
+        for (int j = 0; j < k; ++j) {
+            set[j]->fit_prev = set[j]->fit_float;
+            set[j]->fit_float = false;
+        }
+        // Who does not fit its cell (GTK4/libadwaita ask for large minimum
+        // sizes: 760 wide for Pamac) floats, one at a time, the one
+        // farthest from fitting first; with one window less the cells grow.
+        // A single one that does not fit first swaps places with another
+        // window when both fit then. Same as wmake-zones on X11.
+        for (int pass = 0; pass < 16; ++pass) {
+            k = _tile_compute(ts, &p, area, set, k, rects, active_ptr);
+            int conflicts = 0, worst = -1;
+            long worst_def = 0;
+            for (int j = 0; j < k; ++j) {
+                int mw, mh;
+                wlmtk_window_get_min_bounding_size(set[j]->window_ptr, &mw, &mh);
+                long def = (long)BS_MAX(0, mw - rects[j].w) + BS_MAX(0, mh - rects[j].h);
+                if (0 >= def) continue;
+                conflicts++;
+                if (0 > worst || def > worst_def) {
+                    worst = j;
+                    worst_def = def;
                 }
-                if (!found) wz_bsp_remove(&ts->bsp, ids[a]);
             }
-            for (int j = 0; j < k; ++j) {
-                if (!wz_bsp_has(&ts->bsp, (long)(uintptr_t)set[j]->window_ptr)) {
-                    wz_bsp_insert(&ts->bsp, (long)(uintptr_t)set[j]->window_ptr,
-                                  (long)(uintptr_t)active_ptr, area);
+            if (0 == conflicts) break;
+            bool swapped = false;
+            for (int j = 0; 1 == conflicts && j < k && !swapped; ++j) {
+                if (j == worst) continue;
+                int aw, ah, bw, bh;
+                wlmtk_window_get_min_bounding_size(set[worst]->window_ptr, &aw, &ah);
+                wlmtk_window_get_min_bounding_size(set[j]->window_ptr, &bw, &bh);
+                if (aw > rects[j].w || ah > rects[j].h ||
+                    bw > rects[worst].w || bh > rects[worst].h) continue;
+                long o = set[worst]->order;
+                set[worst]->order = set[j]->order;
+                set[j]->order = o;
+                if (NULL != ts) {
+                    wz_bsp_swap(&ts->bsp, (long)(uintptr_t)set[worst]->window_ptr,
+                                (long)(uintptr_t)set[j]->window_ptr);
                 }
+                zones_window_t *t = set[worst];
+                set[worst] = set[j];
+                set[j] = t;
+                bs_log(BS_INFO, "zones: Tiling: %s swaps places to fit (minimum %dx%d)",
+                       _app_id(set[j]->window_ptr), aw, ah);
+                swapped = true;
             }
-            int gi = p.gap_in, go = p.gap_out;
-            if (p.smart_gaps && 1 == k) gi = go = 0;
-            m = wz_bsp_compute(&ts->bsp, area, gi, go, tmp, ids, WINDOWS_MAX);
-            zones_window_t *ord[WINDOWS_MAX];
-            int c = 0;
-            for (int a = 0; a < m && c < k; ++a) {
-                for (int j = 0; j < k; ++j) {
-                    if ((long)(uintptr_t)set[j]->window_ptr == ids[a]) {
-                        ord[c] = set[j];
-                        rects[c++] = tmp[a];
-                    }
+            if (swapped) continue;
+            zones_window_t *w = set[worst];
+            int mw, mh;
+            wlmtk_window_get_min_bounding_size(w->window_ptr, &mw, &mh);
+            w->fit_float = true;
+            w->fit_min_w = mw;
+            w->fit_min_h = mh;
+            w->fit_cell_w = rects[worst].w;
+            w->fit_cell_h = rects[worst].h;
+            if (!w->fit_prev) {
+                bs_log(BS_INFO, "zones: Tiling: %s does not fit the cell %dx%d "
+                       "(minimum %dx%d), floats", _app_id(w->window_ptr),
+                       rects[worst].w, rects[worst].h, mw, mh);
+            }
+            if (w->tiled) {
+                w->tiled = false;
+                _tsets_forget(zones_ptr, w->window_ptr);
+                memset(&w->expect, 0, sizeof(w->expect));
+                if (w->has_restore) {
+                    wlmtk_window_request_bounding_box(w->window_ptr, &w->restore);
+                    w->has_restore = false;
+                    w->zone = -1;
                 }
             }
-            memcpy(set, ord, sizeof(set[0]) * (size_t)c);
-            k = c;
-        } else {
-            int m = wz_tile(&p, area, k, rects, WINDOWS_MAX);
-            k = BS_MAX(0, BS_MIN(k, m));
+            memmove(&set[worst], &set[worst + 1], sizeof(set[0]) * (size_t)(k - worst - 1));
+            k--;
         }
         for (int j = 0; j < k; ++j) {
             zones_window_t *w = set[j];
@@ -2488,6 +2594,9 @@ void wlmaker_zones_command(wlmaker_zones_t *zones_ptr,
         // output, zone, tiling, box, class and title.
         bool long_form = NULL != arg_ptr &&
             (0 == strcmp(arg_ptr, "-l") || 0 == strcmp(arg_ptr, "long"));
+        // "-d": why each window is (or is not) tiled.
+        bool why_form = NULL != arg_ptr &&
+            (0 == strcmp(arg_ptr, "-d") || 0 == strcmp(arg_ptr, "why"));
         wlmtk_workspace_t *ws_ptr = wlmtk_desktop_get_current_workspace(
             zones_ptr->server_ptr->desktop_ptr);
         bs_dllist_t *list_ptr = wlmtk_workspace_get_windows_dllist(ws_ptr);
@@ -2499,7 +2608,40 @@ void wlmaker_zones_command(wlmaker_zones_t *zones_ptr,
             _field(wlmtk_window_get_app_id(window_ptr), cls, sizeof(cls));
             _field(wlmtk_window_get_instance(window_ptr), ins, sizeof(ins));
             _field(wlmtk_window_get_title(window_ptr), title, sizeof(title));
-            if (long_form) {
+            if (why_form) {
+                char why[160];
+                if (NULL != w && w->tiled) {
+                    snprintf(why, sizeof(why), "mosaico");
+                } else if (NULL != w && w->rule_ignore) {
+                    snprintf(why, sizeof(why), "regra: ignorar");
+                } else if (wlmtk_window_is_dialog(window_ptr)) {
+                    snprintf(why, sizeof(why), "diálogo");
+                } else if (!(wlmtk_window_get_properties(window_ptr) &
+                             WLMTK_WINDOW_PROPERTY_RESIZABLE)) {
+                    snprintf(why, sizeof(why), "tamanho fixo");
+                } else if (wlmtk_window_is_fullscreen(window_ptr)) {
+                    snprintf(why, sizeof(why), "tela cheia");
+                } else if (wlmtk_window_is_minimized(window_ptr)) {
+                    snprintf(why, sizeof(why), "minimizada");
+                } else if (NULL != w && w->user_float) {
+                    snprintf(why, sizeof(why), "flutuante por escolha do usuário");
+                } else if (NULL != w && w->rule_float) {
+                    snprintf(why, sizeof(why), "regra: flutuante");
+                } else if (NULL != w && w->fit_float) {
+                    snprintf(why, sizeof(why), "não cabe: mínimo %dx%d, célula %dx%d",
+                             w->fit_min_w, w->fit_min_h, w->fit_cell_w, w->fit_cell_h);
+                } else {
+                    snprintf(why, sizeof(why), "mosaico desligado ou aguardando");
+                }
+                int mw, mh;
+                wlmtk_window_get_min_bounding_size(window_ptr, &mw, &mh);
+                if ((0 < mw || 0 < mh) && (NULL == w || !w->fit_float)) {
+                    size_t l = strlen(why);
+                    snprintf(why + l, sizeof(why) - l, " (mínimo %dx%d)", mw, mh);
+                }
+                _out(out_ptr, out_len, "%s\ttiled=%d\t%s\t%s\n", cls,
+                     NULL != w ? w->tiled : 0, why, title);
+            } else if (long_form) {
                 struct wlr_output *o = wlr_output_layout_output_at(
                     zones_ptr->server_ptr->wlr_output_layout_ptr,
                     b.x + b.width / 2.0, b.y + b.height / 2.0);
