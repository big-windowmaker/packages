 /**
  * Indicates to generate the menu using a shell command specified in the
@@ -225,6 +235,10 @@ wlmaker_root_menu_t *wlmaker_root_menu_create(
         &wlmtk_menu_events(root_menu_ptr->menu_ptr)->request_close,
