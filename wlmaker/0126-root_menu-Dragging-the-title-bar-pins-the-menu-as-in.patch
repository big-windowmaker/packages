From fbdc86875e73d3d3647c959326005054291fabbd Mon Sep 17 00:00:00 2001
From: ruscher <rruscher@gmail.com>
Date: Sat, 7 Nov 2026 03:19:23 -0300
Subject: [PATCH 126/128] root_menu: Dragging the title bar pins the menu, as
 in Window Maker

A root menu opened by a click took any press outside of it as "close",
the title bar included: It could not be moved nor kept. Now, as in
Window Maker, dragging its title bar pins it: It moves along, gets the
close button, and stays open (after a click elsewhere, and after choosing
an item) until closed.

The menu offers a press outside of it to its listeners first
(wlmtk_menu_events_t::outside_press); the root menu takes the ones on its
title bar.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 include/toolkit/menu.h | 20 ++++++++++++++
 src/action_item.c      |  3 ++-
 src/root_menu.c        | 61 ++++++++++++++++++++++++++++++++++++++++++
 src/root_menu.h        |  6 +++++
 src/toolkit/menu.c     | 11 +++++++-
 5 files changed, 99 insertions(+), 2 deletions(-)

diff --git a/include/toolkit/menu.h b/include/toolkit/menu.h
index e3cbe8c..480a34d 100644
--- a/include/toolkit/menu.h
+++ b/include/toolkit/menu.h
@@ -77,8 +77,28 @@ typedef struct {
     struct wl_signal          request_close;
     /** The dtor has been called. */
     struct wl_signal          destroy;
+    /**
+     * A right-click menu that stays open (opened by a click) got a press
+     * outside of it. The argument is a @ref wlmtk_menu_outside_press_t: A
+     * listener that takes the press (eg. on the menu window's title bar, to
+     * pin the menu, as Window Maker does) sets `claimed`. Else, the menu
+     * closes.
+     */
+    struct wl_signal          outside_press;
 } wlmtk_menu_events_t;
 
+/** Argument of @ref wlmtk_menu_events_t::outside_press. */
+typedef struct {
+    /** The button event. */
+    const wlmtk_button_event_t *button_event_ptr;
+    /** Pointer position, relative to the menu element. */
+    double                    x;
+    /** Pointer position, relative to the menu element. */
+    double                    y;
+    /** Set by a listener that took the press: The menu stays open. */
+    bool                      claimed;
+} wlmtk_menu_outside_press_t;
+
 /**
  * Creates a menu.
  *
