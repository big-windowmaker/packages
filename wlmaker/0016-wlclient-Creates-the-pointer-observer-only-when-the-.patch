+        toplevel_ptr->input_position_observer_ptr,
+        &_wlmcl_tracker_listener,
+        toplevel_ptr);
+    bs_log(BS_INFO, "Created pointer tracker %p for wl_surface %p",
+           toplevel_ptr->input_position_observer_ptr, toplevel_ptr->wl_surface_ptr);
+    return true;
+}
