     wlmcl_icon_t *icon_ptr = logged_calloc(1, sizeof(wlmcl_icon_t));
     if (NULL == icon_ptr) return NULL;
     icon_ptr->wlclient_ptr = wlclient_ptr;
+    icon_ptr->pointer_changed_listener.notify = _wlmcl_icon_handle_pointer_changed;
 
