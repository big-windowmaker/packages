+/*
+ * Big WindowMaker: the command of a running application's icon, as it gets
+ * docked. The application's own command line (WM_COMMAND, which Window
+ * Maker takes from /proc/<pid>/cmdline) often does not launch it again (a
+ * script that renamed itself, relative paths): its .desktop file with
+ * gtk-launch instead, else that command line made launchable. Dockapps keep
+ * theirs. Returns a new string (wfree), or NULL.
+ */
+static char *dockedCommandFor(WAppIcon *icon)
+{
+	WWindow *wwin = icon->icon->owner;
+	char *made, *command = NULL;
+
+	if (!wwin || wwin->flags.is_dockapp)
+		return NULL;
+	made = wAppLaunchCommand(icon->wm_instance ? icon->wm_instance : wwin->wm_instance,
+	                         icon->wm_class ? icon->wm_class : wwin->wm_class,
+	                         wNETWMGetPidForWindow(wwin->client_win));
+	if (made) {
+		command = wstrdup(made);
+		free(made);
+	}
+	return command;
+}
+
+/*
+ * Big WindowMaker: whether the application shows a window (mapped,
+ * miniaturized, shaded or hidden: something unhiding brings back). Telegram
+ * or Steam closed to the tray keep running with no window at all: unhiding
+ * them shows nothing.
+ */
+static Bool appHasWindows(WApplication *wapp)
+{
+	WWindow *wwin;
+
+	if (!wapp || !wapp->main_window_desc)
+		return False;
+	for (wwin = wapp->main_window_desc->screen_ptr->focused_window; wwin; wwin = wwin->prev) {
+		if (wwin->main_window != wapp->main_window || wwin->flags.is_dockapp)
+			continue;
+		if (wwin->flags.mapped || wwin->flags.miniaturized || wwin->flags.shaded ||
+		    wwin->flags.hidden)
+			return True;
+	}
+	return False;
+}
