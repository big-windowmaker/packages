+#ifndef WMAPPCOMMAND_H_
+#define WMAPPCOMMAND_H_
+
+#include <stddef.h>
+#include <sys/types.h>
+
+/*
+ * When the icon of a running application is docked, Window Maker keeps
+ * the application's command line (WM_COMMAND, or /proc/<pid>/cmdline) as
+ * the command of the docked icon. That is often not launchable: a script
+ * that renamed itself ("biglinux-tts main.py"), a program or a file given
+ * relative to the working directory, an Electron or Flatpak helper.
+ *
+ * The command is, in this order:
+ *   - "gtk-launch <id>.desktop" for the application's .desktop file
+ *     (StartupWMClass, the desktop id or the program of Exec matching the
+ *     window's class, instance or executable), when gtk-launch is found;
+ *   - the process's command line, with the program and the arguments that
+ *     name files made absolute (relative to its working directory, or its
+ *     executable when the program is not in the PATH).
+ *
+ * Results are malloc()ed; free() them.
+ */
+
+/* The desktop id (file name, "x.desktop") for the window, or NULL. */
+char *wAppDesktopIdFor(const char *wm_instance, const char *wm_class, const char *exe);
+
+/* The command for the application of the window, or NULL. */
+char *wAppLaunchCommand(const char *wm_instance, const char *wm_class, pid_t pid);
+
+/* The command line of a process, made launchable (see above). `cmdline` is
+ * /proc/<pid>/cmdline (NUL-separated, `len` bytes), `cwd` its working
+ * directory, `exe` its executable, `path` the PATH. Any may be NULL. */
+char *wAppCommandFromProcess(const char *cmdline, size_t len, const char *cwd,
+                             const char *exe, const char *path);
+
+/* "gtk-launch <id>", the id quoted when needed. */
+char *wAppGtkLaunchCommand(const char *desktop_id);
+
+#endif
