diff --git a/test/appcommand_test.c b/test/appcommand_test.c
new file mode 100644
index 00000000..ef209bd0
--- /dev/null
+++ b/test/appcommand_test.c
@@ -0,0 +1,141 @@
+/* appcommand_test.c - tests of the command of docked applications
+ *
+ *  Copyright (c) 2026 Big WindowMaker contributors
+ *
+ *  This program is free software; you can redistribute it and/or modify
+ *  it under the terms of the GNU General Public License as published by
+ *  the Free Software Foundation; either version 2 of the License, or
+ *  (at your option) any later version.
+ *
+ * Run by "make check": the .desktop files of a temporary XDG_DATA_HOME,
+ * and command lines of processes made launchable.
+ */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+/* The module itself, built with the test (no library to link). */
+#include "../src/appcommand.c"
+
+static int failures;
+
+static void expect(const char *what, const char *got, const char *want)
+{
+	if ((got == NULL) != (want == NULL) || (got && strcmp(got, want) != 0)) {
+		fprintf(stderr, "FAIL %s: got [%s], want [%s]\n", what, got ? got : "(null)",
+		        want ? want : "(null)");
+		failures++;
+	} else {
+		printf("ok   %s\n", what);
+	}
+}
+
+static void write_file(const char *dir, const char *name, const char *text)
+{
+	char path[4096];
+	FILE *f;
+
+	snprintf(path, sizeof(path), "%s/%s", dir, name);
+	f = fopen(path, "w");
+	if (!f) {
+		perror(path);
+		exit(1);
+	}
+	fputs(text, f);
+	fclose(f);
+}
+
+int main(void)
+{
+	char home[] = "/tmp/appcommand-test-XXXXXX";
+	char apps[4096], sub[4200], cmd[8192];
+	char *s;
+
+	if (!mkdtemp(home))
+		return 1;
+	snprintf(apps, sizeof(apps), "%s/applications", home);
+	mkdir(apps, 0700);
+	snprintf(sub, sizeof(sub), "%s/kde4", apps);
+	mkdir(sub, 0700);
+	setenv("XDG_DATA_HOME", home, 1);
+	setenv("XDG_DATA_DIRS", "/nonexistent", 1);
+	setenv("HOME", home, 1);
+
+	write_file(apps, "org.telegram.desktop.desktop",
+	           "[Desktop Entry]\nType=Application\nName=Telegram\nExec=Telegram -- %u\n"
+	           "StartupWMClass=TelegramDesktop\n");
+	write_file(apps, "firefox.desktop",
+	           "[Desktop Entry]\nType=Application\nName=Firefox\nExec=/usr/lib/firefox/firefox %u\n");
+	write_file(apps, "org.gnome.Calculator.desktop",
+	           "[Desktop Entry]\nType=Application\nName=Calc\nExec=gnome-calculator\n");
+	write_file(apps, "hidden.desktop",
+	           "[Desktop Entry]\nType=Application\nHidden=true\nStartupWMClass=Hidden\n");
+	write_file(apps, "link.desktop",
+	           "[Desktop Entry]\nType=Link\nURL=x\nStartupWMClass=Link\n");
+	write_file(apps, "tts.desktop",
+	           "[Desktop Entry]\nType=Application\nName=TTS\nExec=env A=1 /usr/bin/biglinux-tts-x --x\n");
+	write_file(sub, "okular.desktop",
+	           "[Desktop Entry]\nType=Application\nName=Okular\nExec=okular\n");
+
+	/* StartupWMClass, case-insensitive; the id keeps its ".desktop". */
+	s = wAppDesktopIdFor("Telegram", "TelegramDesktop", "Telegram");
+	expect("StartupWMClass", s, "org.telegram.desktop.desktop");
+	free(s);
+	s = wAppGtkLaunchCommand("org.telegram.desktop.desktop");
+	expect("gtk-launch with the suffix", s, "gtk-launch org.telegram.desktop.desktop");
+	free(s);
+	/* The desktop id as the class; the last part of a reverse name. */
+	s = wAppDesktopIdFor("Navigator", "firefox", "firefox");
+	expect("desktop id = class", s, "firefox.desktop");
+	free(s);
+	s = wAppDesktopIdFor("calculator", "", NULL);
+	expect("last part of the id", s, "org.gnome.Calculator.desktop");
+	free(s);
+	/* The program of Exec, after env and assignments. */
+	s = wAppDesktopIdFor("x", "y", "biglinux-tts-x");
+	expect("Exec program", s, "tts.desktop");
+	free(s);
+	/* Subdirectories: "kde4-okular.desktop". */
+	s = wAppDesktopIdFor("okular", "okular", "okular");
+	expect("subdirectory id", s, "kde4-okular.desktop");
+	free(s);
+	/* Hidden entries and links are not applications. */
+	s = wAppDesktopIdFor("hidden", "Hidden", NULL);
+	expect("Hidden=true", s, NULL);
+	free(s);
+	s = wAppDesktopIdFor("link", "Link", NULL);
+	expect("Type=Link", s, NULL);
+	free(s);
+
+	/* A script that renamed itself, its file relative: absolute. */
+	write_file(home, "main.py", "#\n");
+	{
+		static const char c[] = "renamed-tts-xyz\0main.py\0--flag\0";
+
+		s = wAppCommandFromProcess(c, sizeof(c) - 1, home, "/usr/bin/python3", "/usr/bin:/bin");
+		snprintf(cmd, sizeof(cmd), "/usr/bin/python3 %s/main.py --flag", home);
+		expect("renamed script", s, cmd);
+		free(s);
+	}
+	/* In the PATH, as it is; special characters quoted for ExpandOptions
+	 * and wtokensplit. */
+	{
+		static const char c[] = "sh\0-c\0echo \"50%\" \\\0";
+
+		s = wAppCommandFromProcess(c, sizeof(c) - 1, NULL, NULL, "/usr/bin:/bin");
+		expect("quoting", s, "sh -c \"echo \\\\\"50\\%\\\\\" \\\\\\\\\"");
+		free(s);
+	}
+	s = wAppCommandFromProcess(NULL, 0, NULL, "/usr/bin/x", NULL);
+	expect("executable only", s, "/usr/bin/x");
+	free(s);
+
+	snprintf(cmd, sizeof(cmd), "rm -rf '%s'", home);
+	if (system(cmd) != 0)
+		failures++;
+	printf("%s\n", failures ? "FAILED" : "PASSED");
+	return failures ? 1 : 0;
+}
