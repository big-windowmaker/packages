+#include "appcommand.h"
+
+#include <dirent.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+/* A growing string. */
+typedef struct {
+	char *s;
+	size_t len, size;
+	int failed;
+} Buf;
+
+static void buf_add(Buf *b, const char *s, size_t len)
+{
+	if (b->failed)
+		return;
+	if (b->len + len + 1 > b->size) {
+		size_t size = 2 * b->size > b->len + len + 64 ? 2 * b->size : b->len + len + 64;
+		char *n = realloc(b->s, size);
+
+		if (!n) {
+			b->failed = 1;
+			return;
+		}
+		b->s = n;
+		b->size = size;
+	}
+	memcpy(b->s + b->len, s, len);
+	b->len += len;
+	b->s[b->len] = 0;
+}
+
+/* An argument, for Window Maker's docked commands: ExpandOptions() reads
+ * them first (\ escapes the next character, % starts an option), then
+ * wtokensplit() splits them (double quotes, \" and \\ in them). Plain
+ * arguments go as they are. */
+static void buf_add_arg(Buf *b, const char *arg)
+{
+	static const char plain[] =
+		"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-./:,+@=";
+	size_t len = strlen(arg);
+	const char *c;
+
+	if (len > 0 && strspn(arg, plain) == len) {
+		buf_add(b, arg, len);
+		return;
+	}
+	buf_add(b, "\"", 1);
+	for (c = arg; *c; c++) {
+		/* wtokensplit: \" and \\, which ExpandOptions must leave. */
+		if (*c == '"' || *c == '\\')
+			buf_add(b, "\\\\", 2);
+		/* ExpandOptions: a literal \ or %. */
+		if (*c == '\\' || *c == '%')
+			buf_add(b, "\\", 1);
+		buf_add(b, c, 1);
+	}
+	buf_add(b, "\"", 1);
+}
+
+static char *strdup_printf2(const char *a, const char *sep, const char *b)
+{
+	size_t la = strlen(a), ls = strlen(sep), lb = strlen(b);
+	char *r = malloc(la + ls + lb + 1);
+
+	if (!r)
+		return NULL;
+	memcpy(r, a, la);
+	memcpy(r + la, sep, ls);
+	memcpy(r + la + ls, b, lb + 1);
+	return r;
+}
+
+/* The path of program `name` in `path`, or NULL. */
+static char *in_path(const char *name, const char *path)
+{
+	const char *p = path;
+
+	if (!path || !*name)
+		return NULL;
+	while (1) {
+		const char *e = strchr(p, ':');
+		size_t l = e ? (size_t)(e - p) : strlen(p);
+
+		if (l > 0 && l < PATH_MAX) {
+			char dir[PATH_MAX];
+			char *c;
+			struct stat st;
+
+			memcpy(dir, p, l);
+			dir[l] = 0;
+			c = strdup_printf2(dir, "/", name);
+			if (c && stat(c, &st) == 0 && S_ISREG(st.st_mode) && access(c, X_OK) == 0)
+				return c;
+			free(c);
+		}
+		if (!e)
+			return NULL;
+		p = e + 1;
+	}
+}
+
+char *wAppCommandFromProcess(const char *cmdline, size_t len, const char *cwd,
+                             const char *exe, const char *path)
+{
+	Buf b = { NULL, 0, 0, 0 };
+	size_t pos = 0, argc = 0;
+
+	while (cmdline && pos < len) {
+		const char *arg = cmdline + pos;
+		size_t l = strnlen(arg, len - pos);
+		char *made = NULL;
+
+		pos += l + 1;
+		if (argc == 0) {
+			if (arg[0] == '/') {
+				if (access(arg, X_OK) != 0 && exe)
+					made = strdup(exe);
+			} else if (strchr(arg, '/')) {
+				/* Relative to its working directory. */
+				if (cwd) {
+					made = strdup_printf2(cwd, "/", arg);
+					if (made && access(made, X_OK) != 0 && exe) {
+						free(made);
+						made = strdup(exe);
+					}
+				} else if (exe) {
+					made = strdup(exe);
+				}
+			} else {
+				/* A name: in the PATH, or its executable (a script
+				 * that renamed itself). */
+				char *found = in_path(arg, path);
+
+				if (found)
+					free(found);
+				else if (exe)
+					made = strdup(exe);
+			}
+		} else if (cwd && arg[0] != '-' && arg[0] != '/' && arg[0] && !strstr(arg, "://")) {
+			/* A file relative to its working directory ("main.py"). */
+			char *p = strdup_printf2(cwd, "/", arg);
+			struct stat st;
+
+			if (p && stat(p, &st) == 0 && S_ISREG(st.st_mode))
+				made = p;
+			else
+				free(p);
+		}
+		if (argc > 0)
+			buf_add(&b, " ", 1);
+		buf_add_arg(&b, made ? made : arg);
+		free(made);
+		argc++;
+	}
+	if (argc == 0 && exe) {
+		buf_add_arg(&b, exe);
+		argc++;
+	}
+	if (b.failed || argc == 0) {
+		free(b.s);
+		return NULL;
+	}
+	return b.s;
+}
+
+char *wAppGtkLaunchCommand(const char *desktop_id)
+{
+	Buf b = { NULL, 0, 0, 0 };
+
+	if (!desktop_id || !*desktop_id)
+		return NULL;
+	buf_add(&b, "gtk-launch ", 11);
+	/* The file name: an id ending in ".desktop" (org.telegram.desktop)
+	 * is not found by gtk-launch without the suffix. */
+	buf_add_arg(&b, desktop_id);
+	if (b.failed) {
+		free(b.s);
+		return NULL;
+	}
+	return b.s;
+}
+
+/* ---- .desktop files ---------------------------------------------------- */
+
+typedef struct {
+	char *id;
+	int score;
+} Match;
+
+static int same(const char *a, const char *b)
+{
+	return a && b && *a && strcasecmp(a, b) == 0;
+}
+
+/* The program of an Exec line: the first word that is not "env" nor an
+ * assignment, without its directory. */
+static char *exec_program(const char *exec)
+{
+	const char *p = exec;
+
+	while (*p) {
+		const char *s, *e;
+		size_t l;
+
+		while (*p == ' ' || *p == '\t')
+			p++;
+		s = p;
+		if (*s == '"') {
+			s++;
+			e = strchr(s, '"');
+			if (!e)
+				return NULL;
+			p = e + 1;
+		} else {
+			e = s;
+			while (*e && *e != ' ' && *e != '\t')
+				e++;
+			p = e;
+		}
+		l = e - s;
+		if (l == 0)
+			return NULL;
+		if ((l == 3 && strncmp(s, "env", 3) == 0) || memchr(s, '=', l))
+			continue;
+		{
+			const char *slash = s;
+			const char *c;
+			char *r;
+
+			for (c = s; c < e; c++)
+				if (*c == '/')
+					slash = c + 1;
+			r = malloc(e - slash + 1);
+			if (!r)
+				return NULL;
+			memcpy(r, slash, e - slash);
+			r[e - slash] = 0;
+			return r;
+		}
+	}
+	return NULL;
+}
+
+/* Scores the desktop file `path` (id `id`) for the window. */
+static int score_file(const char *path, const char *id, const char *wm_instance,
+                      const char *wm_class, const char *exe)
+{
+	FILE *f = fopen(path, "r");
+	char line[4096];
+	int in_entry = 0, app = 0, hidden = 0, nodisplay = 0, score = 0;
+	char base[NAME_MAX * 2 + 2], *dot;
+	const char *last;
+
+	if (!f)
+		return 0;
+	while (fgets(line, sizeof(line), f)) {
+		char *v;
+
+		line[strcspn(line, "\r\n")] = 0;
+		if (line[0] == '[') {
+			in_entry = strcmp(line, "[Desktop Entry]") == 0;
+			continue;
+		}
+		if (!in_entry || !(v = strchr(line, '=')))
+			continue;
+		*v++ = 0;
+		while (*v == ' ')
+			v++;
+		{
+			char *k = line + strlen(line);
+
+			while (k > line && k[-1] == ' ')
+				*--k = 0;
+		}
+		if (strcmp(line, "Type") == 0)
+			app = strcmp(v, "Application") == 0;
+		else if (strcmp(line, "Hidden") == 0)
+			hidden = strcmp(v, "true") == 0;
+		else if (strcmp(line, "NoDisplay") == 0)
+			nodisplay = strcmp(v, "true") == 0;
+		else if (strcmp(line, "StartupWMClass") == 0) {
+			if (same(v, wm_class) || same(v, wm_instance))
+				score = score > 6 ? score : 6;
+		} else if (strcmp(line, "Exec") == 0 && exe) {
+			char *prog = exec_program(v);
+
+			if (prog && (same(prog, exe) || same(prog, wm_instance)))
+				score = score > 2 ? score : 2;
+			free(prog);
+		}
+	}
+	fclose(f);
+	if (!app || hidden)
+		return 0;
+
+	/* The desktop id itself ("firefox" for the class "Firefox"), or the
+	 * last part of a reverse domain name ("org.gnome.Calculator" for the
+	 * instance "calculator"). */
+	snprintf(base, sizeof(base), "%s", id);
+	dot = strstr(base, ".desktop");
+	if (dot && dot[8] == 0)
+		*dot = 0;
+	last = strrchr(base, '.');
+	last = last ? last + 1 : base;
+	if (same(base, wm_class) || same(base, wm_instance))
+		score = score > 4 ? score : 4;
+	else if (same(last, wm_class) || same(last, wm_instance))
+		score = score > 3 ? score : 3;
+	if (score && !nodisplay)
+		score++;
+	return score;
+}
+
+/* Scans <dir> for desktop files (ids of subdirectories joined with '-'). */
+static void scan_dir(const char *dir, const char *prefix, int depth, const char *wm_instance,
+                     const char *wm_class, const char *exe, Match *best)
+{
+	DIR *d = opendir(dir);
+	struct dirent *e;
+
+	if (!d)
+		return;
+	while ((e = readdir(d))) {
+		char path[PATH_MAX], id[NAME_MAX * 2 + 2];
+		struct stat st;
+		size_t l = strlen(e->d_name);
+		int s;
+
+		if (e->d_name[0] == '.')
+			continue;
+		if ((size_t)snprintf(path, sizeof(path), "%s/%s", dir, e->d_name) >= sizeof(path))
+			continue;
+		snprintf(id, sizeof(id), "%s%s", prefix, e->d_name);
+		if (stat(path, &st) != 0)
+			continue;
+		if (S_ISDIR(st.st_mode)) {
+			if (depth < 2) {
+				char sub[NAME_MAX * 2 + 3];
+
+				snprintf(sub, sizeof(sub), "%s-", id);
+				scan_dir(path, sub, depth + 1, wm_instance, wm_class, exe, best);
+			}
+			continue;
+		}
+		if (l < 9 || strcmp(e->d_name + l - 8, ".desktop") != 0)
+			continue;
+		s = score_file(path, id, wm_instance, wm_class, exe);
+		/* Equal scores: the first data directory wins (XDG order). */
+		if (s > best->score) {
+			free(best->id);
+			best->id = strdup(id);
+			best->score = s;
+		}
+	}
+	closedir(d);
+}
+
+char *wAppDesktopIdFor(const char *wm_instance, const char *wm_class, const char *exe)
+{
+	Match best = { NULL, 0 };
+	const char *home = getenv("HOME");
+	const char *data_home = getenv("XDG_DATA_HOME");
+	const char *data_dirs = getenv("XDG_DATA_DIRS");
+	char *dirs, *p, *save = NULL;
+	char buf[PATH_MAX];
+	size_t total;
+
+	if (!data_dirs || !*data_dirs)
+		data_dirs = "/usr/local/share:/usr/share";
+	total = strlen(data_dirs) + 4 * PATH_MAX;
+	dirs = malloc(total);
+	if (!dirs)
+		return NULL;
+	dirs[0] = 0;
+	if (data_home && *data_home)
+		snprintf(buf, sizeof(buf), "%s:", data_home);
+	else if (home)
+		snprintf(buf, sizeof(buf), "%s/.local/share:", home);
+	else
+		buf[0] = 0;
+	strcat(dirs, buf);
+	strcat(dirs, data_dirs);
+	if (home) {
+		snprintf(buf, sizeof(buf), ":%s/.local/share/flatpak/exports/share", home);
+		strcat(dirs, buf);
+	}
+	strcat(dirs, ":/var/lib/flatpak/exports/share");
+
+	for (p = strtok_r(dirs, ":", &save); p; p = strtok_r(NULL, ":", &save)) {
+		char apps[PATH_MAX];
+
+		if ((size_t)snprintf(apps, sizeof(apps), "%s/applications", p) >= sizeof(apps))
+			continue;
+		scan_dir(apps, "", 0, wm_instance, wm_class, exe, &best);
+	}
+	free(dirs);
+	return best.id;
+}
+
+static char *read_link(const char *path)
+{
+	char buf[PATH_MAX];
+	ssize_t l = readlink(path, buf, sizeof(buf) - 1);
+
+	if (l <= 0)
+		return NULL;
+	buf[l] = 0;
+	if (strstr(buf, " (deleted)"))
+		return NULL;
+	return strdup(buf);
+}
+
+char *wAppLaunchCommand(const char *wm_instance, const char *wm_class, pid_t pid)
+{
+	char path[64], *exe = NULL, *cwd = NULL, *result = NULL;
+	const char *exe_base = NULL;
+
+	if (pid > 1) {
+		snprintf(path, sizeof(path), "/proc/%d/exe", (int)pid);
+		exe = read_link(path);
+		snprintf(path, sizeof(path), "/proc/%d/cwd", (int)pid);
+		cwd = read_link(path);
+	}
+	if (exe) {
+		exe_base = strrchr(exe, '/');
+		exe_base = exe_base ? exe_base + 1 : exe;
+	}
+
+	{
+		char *gtk_launch = in_path("gtk-launch", getenv("PATH"));
+
+		if (gtk_launch) {
+			char *id = wAppDesktopIdFor(wm_instance, wm_class, exe_base);
+
+			free(gtk_launch);
+			if (id) {
+				result = wAppGtkLaunchCommand(id);
+				free(id);
+			}
+		}
+	}
+
+	if (!result && pid > 1) {
+		char buf[8192];
+		ssize_t l = 0;
+		int fd;
+
+		snprintf(path, sizeof(path), "/proc/%d/cmdline", (int)pid);
+		fd = open(path, O_RDONLY | O_CLOEXEC);
+		if (fd >= 0) {
+			l = read(fd, buf, sizeof(buf) - 1);
+			close(fd);
+		}
+		if (l > 0) {
+			buf[l] = 0;
+			result = wAppCommandFromProcess(buf, l, cwd, exe, getenv("PATH"));
+		}
+	}
+	free(exe);
+	free(cwd);
+	return result;
+}
