From 375c25fd4d9054b5055d98b9170c2c9c843195a1 Mon Sep 17 00:00:00 2001
From: Rafael Ruscher <rruscher@gmail.com>
Date: Sat, 14 Nov 2026 08:54:05 -0300
Subject: [PATCH] window: the frame of an undecorated window takes the client's
 input shape

A window without a title bar and without a resize bar has a frame that is
just the client. When such a window covers the whole screen and takes
input on parts of it only (an on-screen keyboard or touch gamepad sets an
input shape with its controls), the frame kept the default input region
and swallowed every click over the screen: the Dock, the dockapps and the
desktop stopped working while the overlay was shown.

The client's input shape is now copied to the frame when the window is
managed (a shape set before that sent no event), when it is resized and
when the client changes it (ShapeNotify of kind ShapeInput, which was
ignored). A decorated window keeps the default region, so its bars still
take the clicks. Merging ShapeNotify events no longer drops a pending
input shape event.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/event.c  | 20 +++++++++++++-------
 src/window.c | 29 +++++++++++++++++++++++++++++
 src/window.h |  1 +
 3 files changed, 43 insertions(+), 7 deletions(-)

diff --git a/src/event.c b/src/event.c
index 1b736b47..c04b3460 100644
--- a/src/event.c
+++ b/src/event.c
@@ -1284,14 +1284,20 @@ static void handleShapeNotify(XEvent * event)
 		XShapeEvent xshape;
 	} ev;
 
+	if (shev->kind == ShapeInput) {
+		wwin = wWindowFor(shev->window);
+		if (wwin)
+			wWindowSetInputShape(wwin);
+		return;
+	}
+
 	while (XCheckTypedWindowEvent(dpy, shev->window, event->type, &ev.xevent)) {
-		if (ev.xshape.kind == ShapeBounding) {
-			if (ev.xshape.shaped == shev->shaped) {
-				*shev = ev.xshape;
-			} else {
-				XPutBackEvent(dpy, &ev.xevent);
-				break;
-			}
+		/* Only bounding events are merged: an input shape event is not lost */
+		if (ev.xshape.kind == ShapeBounding && ev.xshape.shaped == shev->shaped) {
+			*shev = ev.xshape;
+		} else {
+			XPutBackEvent(dpy, &ev.xevent);
+			break;
 		}
 	}
 
diff --git a/src/window.c b/src/window.c
index b59682ee..befc54ad 100644
--- a/src/window.c
+++ b/src/window.c
@@ -1309,6 +1309,12 @@ WWindow *wManageWindow(WScreen *scr, Window window)
 	 * related variables (frame_x,frame_y) */
 	wWindowConfigure(wwin, x, y, width, height);
 
+#ifdef USE_XSHAPE
+	/* an input shape set before the window was managed sent no event to us */
+	if (w_global.xext.shape.supported)
+		wWindowSetInputShape(wwin);
+#endif
+
 	/* to make sure the window receives it's new position after reparenting */
 	wWindowSynthConfigureNotify(wwin);
 
@@ -2299,6 +2305,8 @@ void wWindowConfigure(WWindow *wwin, int req_x, int req_y, int req_width, int re
 #ifdef USE_XSHAPE
 	if (w_global.xext.shape.supported && wwin->flags.shaped && resize)
 		wWindowSetShape(wwin);
+	if (w_global.xext.shape.supported && resize)
+		wWindowSetInputShape(wwin);
 #endif
 
 	if (synth_notify)
@@ -2535,6 +2543,8 @@ void wWindowConfigureBorders(WWindow *wwin)
 #ifdef USE_XSHAPE
 		if (w_global.xext.shape.supported && wwin->flags.shaped)
 			wWindowSetShape(wwin);
+		if (w_global.xext.shape.supported)
+			wWindowSetInputShape(wwin);
 #endif
 	}
 }
@@ -2635,6 +2645,25 @@ void wWindowClearShape(WWindow * wwin)
 	XFlush(dpy);
 }
 
+/*
+ * The client's input shape goes to the frame of a window without a title
+ * bar and without a resize bar: there the frame is just the client, and a
+ * full-screen window that takes input on parts of it only (an on-screen
+ * keyboard or gamepad) must leave the rest of the screen clickable. With
+ * the frame's default input region, every click over the whole window was
+ * swallowed. A decorated window keeps the default region, so its bars still
+ * take the clicks.
+ */
+void wWindowSetInputShape(WWindow *wwin)
+{
+	if (HAS_TITLEBAR(wwin) || HAS_RESIZEBAR(wwin))
+		XShapeCombineMask(dpy, wwin->frame->core->window, ShapeInput, 0, 0, None, ShapeSet);
+	else
+		XShapeCombineShape(dpy, wwin->frame->core->window, ShapeInput,
+				   0, wwin->frame->top_width, wwin->client_win, ShapeInput, ShapeSet);
+	XFlush(dpy);
+}
+
 void wWindowSetShape(WWindow * wwin)
 {
 	XRectangle rect[2];
diff --git a/src/window.h b/src/window.h
index 9244cbaa..ada56eb8 100644
--- a/src/window.h
+++ b/src/window.h
@@ -342,6 +342,7 @@ WWindow *wWindowCreate(void);
 
 #ifdef USE_XSHAPE
 void wWindowSetShape(WWindow *wwin);
+void wWindowSetInputShape(WWindow *wwin);
 void wWindowClearShape(WWindow *wwin);
 #endif
 
