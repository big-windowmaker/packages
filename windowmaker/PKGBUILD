prepare() {
  cd wmaker

  # Garante que o pkgver declarado corresponde ao commit fixado.
  local _desc
  _desc="$(git describe --long --tags --abbrev=7 | sed 's/^wmaker-//;s/\([^-]*-g\)/r\1/;s/-/./g')"
  if [[ ${_desc} != "${pkgver}" ]]; then
    echo "pkgver (${pkgver}) não confere com git describe (${_desc})" >&2
    return 1
  fi

  # setstyle prefixava o diretório do tema também em caminhos absolutos
  # (".../X.themed//usr/share/backgrounds/x.jpg"): o papel de parede dos
  # temas não carregava. Enviar ao upstream (wmaker-dev@googlegroups.com).
  patch -Np1 -i "${srcdir}/0001-setstyle-keep-absolute-texture-paths.patch"

  # pt_BR: a confirmação de "Matar" é colada ao título da janela ("<título>
  # will be forcibly closed."), mas a tradução era uma frase solta, sem o
  # espaço: "big-wm-tabbed-dockA aplicação obrigatoriamente será fechada".
  # Enviar ao upstream (wmaker-dev@googlegroups.com).
  patch -Np1 -i "${srcdir}/0002-po-pt_BR-Fix-the-kill-confirmation-message.patch"

  # Identidade do Big WindowMaker no painel Info: nome "Big WindowMaker",
  # o subtítulo (trocado pelo 0012) e a linha "Copyleft 🄯 <ano> Rafael Ruscher"
  # acima dos copyrights do Window Maker, que continuam lá (GPL, seção 2c).
  # Patch próprio do Big WindowMaker: NÃO enviar ao upstream.
  patch -Np1 -i "${srcdir}/0003-info-panel-Big-WindowMaker-branding.patch"

  # pt_BR: o painel Info não tinha nenhuma string traduzida (o catálogo é
  # da 0.60.0) e aparecia em inglês. Enviar ao upstream
  # (wmaker-dev@googlegroups.com).
  patch -Np1 -i "${srcdir}/0004-po-pt_BR-Translate-the-Info-panel.patch"

  # AppIcons com um buraco de um ícone entre eles até reiniciar o Window
  # Maker: o PlaceIcon() marcava os slots ocupados por coordenada absoluta,
  # e num monitor que não começa num múltiplo do tamanho do ícone (o do
  # meio de 3440+3440+2560) ou com um painel embaixo cada ícone ocupava
  # também o slot seguinte. Enviar ao upstream (wmaker-dev@googlegroups.com).
  patch -Np1 -i "${srcdir}/0005-placement-appicons-on-the-yard-grid-of-each-head.patch"

  # Monitor do Dock: submenu "Monitor" no menu do Dock e arrastar para outro
  # monitor; gravado como Dock.Monitor no WMState (nome do conector RandR),
  # com volta automática quando o monitor é reconectado. Enviar ao upstream.
  patch -Np1 -i "${srcdir}/0006-dock-choose-the-monitor-of-the-Dock.patch"

  # Painel Info: créditos "Big WindowMaker Custom" no fim, depois de um
  # divisor, com o símbolo de copyleft desenhado. Patch próprio: NÃO enviar.
  patch -Np1 -i "${srcdir}/0007-info-panel-Big-WindowMaker-Custom-credits-at-the-end.patch"

  # pt_BR dos menus de posição e de monitor do Dock. Enviar ao upstream.
  patch -Np1 -i "${srcdir}/0008-po-pt_BR-Translate-the-Dock-monitor-menu.patch"

  # O Dock "sumia" ao escolher um monitor: ficava na emenda entre dois
  # monitores, embaixo das janelas. Agora vai para a borda da tela livre
  # do Clip, é conferido dentro de um monitor e trazido à frente; e
  # "Restaurar posição do Dock" (menu do Dock, RESET_DOCK no menu raiz e
  # o comando ResetDock do big-wm-dock-reset). Enviar ao upstream.
  patch -Np1 -i "${srcdir}/0009-dock-keep-the-Dock-visible-and-restore-its-position.patch"

  # Lupa (Configurações > Lupa): 30 quadros/s com MIT-SHM e uma imagem por
  # quadro (eram ~4/s, um retângulo por pixel ampliado), roda do mouse
  # para o zoom (1x a 16x, frações), suavizado ou pixel perfeito,
  # redimensionamento livre e acima das outras janelas. Enviar ao upstream.
  patch -Np1 -i "${srcdir}/0010-wmagnify-fast-rendering-mouse-wheel-zoom-smooth-scaling.patch"

  # Salvar sessão: um programa com várias janelas num processo (navegador,
  # gerenciador de arquivos) era salvo e relançado uma vez por janela,
  # abrindo janelas a mais; e um componente marcado DontSaveSession depois
  # de salvo era relançado. Enviar ao upstream.
  patch -Np1 -i "${srcdir}/0011-session-start-a-multi-window-program-once.patch"

  # Subtítulo do painel Info: "Baseado no BigLinux" (o sistema é o Big
  # WindowMaker, baseado no BigLinux), no lugar de "Baseado no Window Maker".
  # Os copyrights do Window Maker continuam no painel. Patch próprio do Big
  # WindowMaker: NÃO enviar ao upstream.
  patch -Np1 -i "${srcdir}/0012-info-panel-subtitle-Based-on-BigLinux.patch"

  # Créditos da edição no fim do painel Info alinhados à esquerda, na coluna
  # do aviso de copyright: "Big WindowMaker Custom" e uma linha "Copyleft 🄯
  # Nome" por autor (o símbolo U+1F12F desenhado em vetor). Patch próprio do
  # Big WindowMaker: NÃO enviar ao upstream.
  patch -Np1 -i "${srcdir}/0013-info-panel-credits-aligned-left-Copyleft-lines.patch"

  # Ícones padronizados com EnforceIconMargin = YES: a imagem cabe em 3/4 do
  # ladrilho (48 de 64) sem deformar, com uma sombra suave como a do
  # clip.tiff; as reduções de ícone (arquivo, WM_HINTS, _NET_WM_ICON) usam a
  # média de área com alfa em vez do vizinho mais próximo (o OBS Studio, que
  # ocupa o quadro inteiro, saía colado às bordas e serrilhado). A redução
  # suave poderia ir ao upstream; a sombra é uma escolha do Big WindowMaker.
  patch -Np1 -i "${srcdir}/0014-icons-standard-margin-smooth-scaling-and-clip-shadow.patch"

  # Um dock/painel que não aceita teclado (WM_HINTS input = False, como o dock
  # com abas) deixa de receber o foco. Antes, ao fechar a última janela (por
  # exemplo o Buscar aplicativos com Esc), o wmaker passava o foco para o dock,
  # que o recusava: o foco do X ficava em None e nenhum atalho funcionava até
  # clicar numa janela. Pode ir ao upstream.
  patch -Np1 -i "${srcdir}/0015-wmspec-a-dock-that-takes-no-input-is-not-focusable.patch"

  # Um dockapp acoplado no Dock ou no Clip inicia com o Window Maker
  # (AutoLaunch ligado ao acoplar; o usuário ainda pode desligar). Antes,
  # wmfsm, wmglobe, wmgtemp, wmcliphist e wmeyes acoplados ficavam parados no
  # login seguinte. Pode ir ao upstream.
  patch -Np1 -i "${srcdir}/0016-dock-a-docked-dockapp-starts-with-Window-Maker.patch"

  # Dicas do Motif mudadas com a janela aberta (o Qt faz isso quando o
  # aplicativo liga ou desliga a própria barra de título, como a "moldura do
  # sistema" do Telegram) passam a valer na hora. Pode ir ao upstream.
  patch -Np1 -i "${srcdir}/0017-motif-follow-MOTIF_WM_HINTS-changed-after-the-window-is-mapped.patch"

  # Dockapp que pega os próprios cliques (o ladrilho do wmake-zones) passa
  # o arrastar e o clique direito como evento sintético, como o Window
  # Maker já previa: o ícone pega o ponteiro ao arrastar, o menu fecha com
  # o próximo clique quando o botão já foi solto, e o ponteiro volta ao
  # fim do menu. Pode ir ao upstream.
  patch -Np1 -i "${srcdir}/0018-dockapps-drag-and-menu-handed-over-as-a-synthetic-pr.patch"

  # _NET_WORKAREA segue as reservas (struts) de painéis e docas mapeados
  # depois do início, como o Dock com abas: programas que se centram na área
  # de trabalho (o instalador, diálogos Qt e GTK) ficavam embaixo dele. Pode
  # ir ao upstream.
  patch -Np1 -i "${srcdir}/0019-screen-_NET_WORKAREA-follows-the-struts.patch"

  # Moldura em todos os programas (IgnoreDecorationChanges só nos tipos
  # decorados, não em jogos sem bordas) e o Dock: comando do .desktop ao
  # acoplar, e duplo clique num programa da bandeja traz a janela.
  patch -Np1 -i "${srcdir}/0020-IgnoreDecorationChanges-only-on-decorated-window-typ.patch"
  patch -Np1 -i "${srcdir}/0021-IgnoreDecorationChanges-not-on-games-in-borderless-f.patch"
  patch -Np1 -i "${srcdir}/0022-dock-a-docked-application-s-command-launches-it-a-cl.patch"
  patch -Np1 -i "${srcdir}/0023-dock-the-docked-command-finds-the-process-of-a-GTK-a.patch"

  # Tradução pt_BR completa e revisada de todos os domínios (WindowMaker,
  # WPrefs, WINGs, WRaster, wmgenmenu) e o comando RESET_DOCK no editor de
  # menus do WPrefs.
  patch -Np1 -i "${srcdir}/0024-i18n-pt_BR-catalogs-for-all-domains-and-RESET_DOCK.patch"

  # --help e os erros de argumento traduzidos (o catálogo era carregado só
  # depois da leitura da linha de comando). Pode ir ao upstream.
  patch -Np1 -i "${srcdir}/0025-wmaker-bind-the-message-catalogs-before-parsing-the-.patch"

  # Lista de janelas: "Sem título" traduzido; no espanhol, a opção --version
  # não era mais traduzida como --versión. Podem ir ao upstream.
  patch -Np1 -i "${srcdir}/0026-po-es-version-option-and-translated-Untitled.patch"
  patch -Np1 -i "${srcdir}/0027-po-pt_BR-Ocultar-and-Remover-a-ultima.patch"

  # 0028: o Clip nunca fica sobre o primeiro ícone do Dock (um monitor a
  # menos o empurrava para lá): vai para o outro lado do monitor do Dock.
  patch -Np1 -i "${srcdir}/0028-dock-the-Clip-never-lands-on-the-Dock-s-first-icon.patch"
  # 0029: uma gaveta restaurada numa vaga ocupada do Dock (outra altura de
  # tela, outra lista do Dock) vai para a vaga livre mais próxima.
  patch -Np1 -i "${srcdir}/0029-dock-a-drawer-restored-on-a-taken-slot-moves-to-the-.patch"

  # O master não define mais X-GDM-SessionRegisters no wmaker.desktop, então o
  # sed que o Arch faz na 0.96.0 não é necessário aqui.

  autoreconf -fiv
}

build() {
  cd wmaker
  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --enable-modelock \
    --enable-wmreplace \
    --enable-xinerama \
    --enable-randr \
    --enable-usermenu \
    --enable-pango \
    --enable-res \
    LINGUAS="`(cd po ; echo *.po | sed 's/.po//g')`"
  make
}

check() {
  cd wmaker
  # Verificações do próprio upstream: documentação das opções de linha de
  # comando, callbacks de defaults e consistência das traduções.
  make check
}

package() {
  cd wmaker
  make DESTDIR="$pkgdir" install
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname/" COPYING.WTFPL

  # A sessão "Window Maker" pura (sem a configuração do Big WindowMaker) sai
  # da tela de login: ao lado de "Big WindowMaker (X11)" ela só confundia.
  local _session="$pkgdir/usr/share/xsessions/wmaker.desktop"
  if [[ -e $_session ]] && ! grep -q '^NoDisplay=' "$_session"; then
    sed -i '0,/^\[Desktop Entry\]$/s//[Desktop Entry]\nNoDisplay=true/' "$_session"
  fi
}
