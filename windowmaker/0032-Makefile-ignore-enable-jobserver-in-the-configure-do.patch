From a4ebc21fbbfc75296c2aeb259ba133d33cbbc170 Mon Sep 17 00:00:00 2001
From: ruscher <rruscher@gmail.com>
Date: Thu, 26 Nov 2026 07:17:11 -0300
Subject: [PATCH] Makefile: ignore --enable-jobserver in the configure
 documentation check

Automake (jobserver.m4, seen in automake 1.20) adds --enable-jobserver to
every configure script, and 'make check' then fails in
configure-documentation:

  Error: program option '--enable-jobserver' is not in the documentation
  './INSTALL-WMAKER'

It is a generic build-system option, like the libtool ones already in
the ignore list.
---
 Makefile.am | 1 +
 1 file changed, 1 insertion(+)

diff --git a/Makefile.am b/Makefile.am
index 640a7d20..d9e07980 100644
--- a/Makefile.am
+++ b/Makefile.am
@@ -147,6 +147,7 @@ configure-documentation:
 		--ignore-prg 'enable-aix-soname # renamed in libtool 2.5.3' \
 		--ignore-prg 'enable-pic # new in libtool 2.5.3' \
 		--ignore-prg 'enable-cxx-stdlib # new in libtool 2.6.0' \
+		--ignore-prg 'enable-jobserver # from automake (jobserver.m4, seen in 1.20)' \
 		--ignore-prg 'with-x # no use, it would not work without X'
 
 .PHONY: configure-documentation
-- 
2.56.1

