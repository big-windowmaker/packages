+++ b/wrlib/po/pt_BR.po
@@ -0,0 +1,184 @@
+# Brazilian Portuguese translation of WRaster (Window Maker).
+# This file is distributed under the same license as the Window Maker package.
+#
+# Big WindowMaker <https://github.com/big-windowmaker>, 2026.
+#
+msgid ""
+msgstr ""
+"Project-Id-Version: WindowMaker 0.96.0\n"
+"Report-Msgid-Bugs-To: wmaker-dev@googlegroups.com\n"
+"POT-Creation-Date: 2026-10-21 08:20-0300\n"
+"PO-Revision-Date: 2026-11-09 06:08-0300\n"
+"Last-Translator: Big WindowMaker <https://github.com/big-windowmaker>\n"
+"Language-Team: Brazilian Portuguese\n"
+"Language: pt_BR\n"
+"MIME-Version: 1.0\n"
+"Content-Type: text/plain; charset=UTF-8\n"
+"Content-Transfer-Encoding: 8bit\n"
+"Plural-Forms: nplurals=2; plural=(n > 1);\n"
+
+#: ../../wrlib/load.c:132
+#, c-format
+msgid "wrlib: out of memory for image cache\n"
+msgstr "wrlib: memória insuficiente para o cache de imagens\n"
+
+#: ../../wrlib/xpixmap.c:159
+#, c-format
+msgid "wrlib: invalid window or pixmap passed to RCreateImageFromDrawable\n"
+msgstr ""
+"wrlib: janela ou pixmap inválido passado para RCreateImageFromDrawable\n"
+
+#: ../../wrlib/context.c:409
+#, c-format
+msgid "wrlib: no standard colormap found for visual 0x%lX\n"
+msgstr "wrlib: nenhum mapa de cores padrão encontrado para o visual 0x%lX\n"
+
+#: ../../wrlib/context.c:457 ../../wrlib/context.c:469
+#, c-format
+msgid "wrlib: invalid value \"%s\" for %s\n"
+msgstr "wrlib: valor inválido \"%s\" para %s\n"
+
+#: ../../wrlib/misc.c:206
+msgid "no error"
+msgstr "nenhum erro"
+
+#: ../../wrlib/misc.c:209
+msgid "could not open file"
+msgstr "não foi possível abrir o arquivo"
+
+#: ../../wrlib/misc.c:212
+msgid "error reading from file"
+msgstr "erro ao ler do arquivo"
+
+#: ../../wrlib/misc.c:215
+msgid "error writing to file"
+msgstr "erro ao gravar no arquivo"
+
+#. Known codes as per libWebP 0.4.1
+#: ../../wrlib/misc.c:218 ../../wrlib/load_webp.c:45
+msgid "out of memory"
+msgstr "memória insuficiente"
+
+#: ../../wrlib/misc.c:221
+msgid "out of color cells"
+msgstr "células de cor esgotadas"
+
+#: ../../wrlib/misc.c:224
+msgid "invalid or corrupted image file"
+msgstr "arquivo de imagem inválido ou corrompido"
+
+#: ../../wrlib/misc.c:227
+msgid "image format is not supported"
+msgstr "formato de imagem não suportado"
+
+#: ../../wrlib/misc.c:230
+msgid "file does not contain requested image index"
+msgstr "o arquivo não contém o índice de imagem solicitado"
+
+#: ../../wrlib/misc.c:233
+msgid "request for an invalid Visual ID"
+msgstr "solicitação de um ID de Visual inválido"
+
+#: ../../wrlib/misc.c:236
+msgid "failed to create X standard colormap"
+msgstr "não foi possível criar o mapa de cores padrão do X"
+
+#: ../../wrlib/misc.c:239
+msgid "internal X error"
+msgstr "erro interno do X"
+
+#: ../../wrlib/misc.c:243
+msgid "internal error"
+msgstr "erro interno"
+
+#: ../../wrlib/xutil.c:114 ../../wrlib/xutil.c:121
+#, c-format
+msgid "wrlib: could not allocate shared memory segment, %s: %s\n"
+msgstr ""
+"wrlib: não foi possível alocar o segmento de memória compartilhada, %s: %s\n"
+
+#: ../../wrlib/xutil.c:124 ../../wrlib/xutil.c:144 ../../wrlib/xutil.c:146
+#, c-format
+msgid "wrlib: error occurred while aborting %s, %s\n"
+msgstr "wrlib: ocorreu um erro ao abortar %s, %s\n"
+
+#: ../../wrlib/xutil.c:140
+#, c-format
+msgid "wrlib: could not attach shared memory segment to XImage\n"
+msgstr ""
+"wrlib: não foi possível anexar o segmento de memória compartilhada à XImage\n"
+
+#: ../../wrlib/xutil.c:168 ../../wrlib/xutil.c:170
+#, c-format
+msgid "wrlib: error occurred while releasing XImage, %s: %s\n"
+msgstr "wrlib: ocorreu um erro ao liberar a XImage, %s: %s\n"
+
+#: ../../wrlib/load_ppm.c:56 ../../wrlib/load_ppm.c:63
+#: ../../wrlib/load_ppm.c:76
+#, c-format
+msgid "wrlib: EOF / read error reading a byte from PPM file \"%s\"\n"
+msgstr ""
+"wrlib: fim de arquivo / erro de leitura ao ler um byte do arquivo PPM "
+"\"%s\"\n"
+
+#: ../../wrlib/load_ppm.c:90
+#, c-format
+msgid ""
