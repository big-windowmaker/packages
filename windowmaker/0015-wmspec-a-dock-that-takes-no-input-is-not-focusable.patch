From b3aa942f0db91e2c92d23cba92c0e761b82f9192 Mon Sep 17 00:00:00 2001
From: ruscher <rruscher@gmail.com>
Date: Wed, 4 Nov 2026 08:08:53 -0300
Subject: [PATCH] wmspec: a dock that takes no input is not focusable

A _NET_WM_WINDOW_TYPE_DOCK window with WM_HINTS input = False (GTK's
gtk_window_set_accept_focus(FALSE), with WM_TAKE_FOCUS) was still a
focus candidate. Closing the last focused window chose it as the next
one; wSetFocusTo() only sent WM_TAKE_FOCUS, the panel ignored it, and the
X focus stayed on None: no key binding of the window manager worked
until a window was clicked. Seen with the Big WindowMaker tabbed dock:
Alt+Space, Escape, then no shortcut worked.

Such docks are now no_focusable, so the focus goes to the no-focus
window as with an empty desktop. Panels that accept input are unchanged.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/wmspec.c | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/src/wmspec.c b/src/wmspec.c
index e0709218..f6390b87 100644
--- a/src/wmspec.c
+++ b/src/wmspec.c
@@ -1373,6 +1373,18 @@ static Bool handleWindowType(WWindow *wwin, Atom type, int *layer)
 		wwin->client_flags.skip_switchpanel = 1;
 		wwin->client_flags.dont_move_off = 1;
 		wwin->flags.net_skip_pager = 1;
+		/*
+		 * A dock or panel that never takes the keyboard (WM_HINTS input =
+		 * False, usually with WM_TAKE_FOCUS, as GTK does for
+		 * gtk_window_set_accept_focus(FALSE)) must not get the focus.
+		 * Otherwise closing the last focused window chose the panel as the
+		 * next focused window; wSetFocusTo() only sent WM_TAKE_FOCUS, the
+		 * panel ignored it and the X focus stayed on None, so every key
+		 * binding of the window manager stopped working until a window was
+		 * clicked. Panels that accept input keep their behaviour.
+		 */
+		if (wwin->wm_hints && (wwin->wm_hints->flags & InputHint) && !wwin->wm_hints->input)
+			wwin->client_flags.no_focusable = 1;
 	} else if (type == net_wm_window_type_toolbar ||
 	           type == net_wm_window_type_menu) {
 		wwin->client_flags.no_resizable = 1;
