# Maintainer: Bruno Goncalves <bigbruno@gmail.com>
#
# TEMPORÁRIO (Big WindowMaker): biglinux-livecd com o suporte à sessão live
# do Window Maker (branch window-maker de big-windowmaker/biglinux-livecd),
# usado só nas ISOs de teste até a mudança entrar no upstream. Remover este
# diretório quando o pacote do biglinux-stable tiver o suporte.
# shellcheck shell=bash disable=SC2034,SC2154

pkgname=biglinux-livecd
pkgver=26.10.26
pkgrel=4
pkgdesc="BigLinux live-session setup and Calamares installer integration"
arch=('any')
url="https://github.com/biglinux/biglinux-livecd"
license=('GPL-3.0-only' 'CC0-1.0')
depends=(
    'binutils'
    'btrfs-progs'
    'calamares'
    'circle-flags'
    'curl'
    'dbus'
    'e2fsprogs'
    'gettext'
    'glib2'
    'gtk4'
    'hicolor-icon-theme'
    'libadwaita'
    'mtools'
    'python'
    'python-babel'
    'python-cairo'
    'python-gobject'
    'qefientrymanager'
    'sudo'
    'util-linux'
    'xdg-user-dirs'
    'xorg-xrandr'
)
optdepends=(
    'speech-dispatcher: spoken feedback in the live-session wizard'
    'openssh: remote access to the live session with the sshenable boot argument'
    'shadow: set the temporary password the sshenable boot argument uses'
)
makedepends=('git')
_commit=465314da162882e6fbacde5d9e2f1c03f38ac54d
source=("biglinux-livecd::git+https://github.com/big-windowmaker/biglinux-livecd.git#commit=${_commit}")
sha256sums=('2479a886e510e20da0dd35e980adefd08c34ecf931c5322b9fe360e6c5dd44e4')
install="${pkgname}.install"

package() {
    cd "${srcdir}/${pkgname}" || return 1

    cp -a biglinux-livecd/usr "${pkgdir}/"
    local catalog locale
    for catalog in biglinux-livecd/locale/*.po; do
        locale=${catalog##*/}
        locale=${locale%.po}
        install -d "${pkgdir}/usr/share/locale/${locale}/LC_MESSAGES"
        msgfmt -c "$catalog" \
            -o "${pkgdir}/usr/share/locale/${locale}/LC_MESSAGES/${pkgname}.mo"
    done
    # All four trees, not just the live wizard: the installer wizard, the
    # shared probes and the Calamares job modules were shipping uncompiled.
    python -m compileall -q -j1 -s "${pkgdir}" -p / \
        "${pkgdir}/usr/share/biglinux/livecd" \
        "${pkgdir}/usr/share/biglinux/calamares" \
        "${pkgdir}/usr/lib/biglinux-livecd" \
        "${pkgdir}/usr/lib/calamares/modules" || return 1
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
