+static void pulseConnect(void) {
+  context = pa_context_new(pa_glib_mainloop_get_api(mainloop), clientName);
+  if(!context) {
+    fprintf(stderr, NAME ": unable to create a PulseAudio context.\n");
+    pulseScheduleReconnect();
+    return;
+  }
+  pa_context_set_state_callback(context, callbackContextState, NULL);
+  if(pa_context_connect(context, NULL, PA_CONTEXT_NOAUTOSPAWN, NULL) < 0) {
+    if(!reportedOffline) {
+      fprintf(stderr, NAME ": audio server unavailable (%s); waiting for it.\n",
+              pa_strerror(pa_context_errno(context)));
+      reportedOffline = true;
+    }
+    pulseDisconnect();
+    pulseScheduleReconnect();
+  }
+}
