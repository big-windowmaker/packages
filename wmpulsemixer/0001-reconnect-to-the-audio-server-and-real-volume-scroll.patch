+static void pulseDisconnect(void) {
+  bool wasConnected = state.connected;
+  if(context) {
+    pa_context_set_state_callback(context, NULL, NULL);
+    pa_context_set_subscribe_callback(context, NULL, NULL);
+    pa_context_disconnect(context);
+    pa_context_unref(context);
+    context = NULL;
+  }
+  menuClose();
+  pulseFreeDevices();
+  free(defaultSinkName);
+  defaultSinkName = NULL;
+  free(defaultSourceName);
+  defaultSourceName = NULL;
+  defaultSinkIndex = -1;
+  defaultSourceIndex = -1;
+  state.connected = false;
+  state.sink.muted = state.source.muted = false;
+  state.sink.volume = state.source.volume = 0;
+  if(wasConnected) g_idle_add(windowRepaintQuietEvent, NULL);
+}
