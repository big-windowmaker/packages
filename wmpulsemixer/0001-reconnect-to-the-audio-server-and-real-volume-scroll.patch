+}
+
+static void pulseScheduleReconnect(void) {
+  if(reconnectId) return;
+  if(options.verbose) printf("Reconnecting in %u s\n", reconnectDelay);
+  reconnectId = g_timeout_add_seconds(reconnectDelay, pulseReconnectEvent, NULL);
+  reconnectDelay = reconnectDelay * 2 > RECONNECT_MAX_SECS ? RECONNECT_MAX_SECS : reconnectDelay * 2;
+}
