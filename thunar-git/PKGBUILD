# Maintainer: Big WindowMaker <https://github.com/big-windowmaker>
# Based on the AUR thunar-git PKGBUILD (twa022; contributors Alad Wenter,
# Limao Luo, Evangelos Foutras, Andrew Simmons), pinned to one commit of the
# master branch so the build is reproducible; update _commit to move on.

_pkgname=thunar
pkgname=thunar-git
_commit=222d036c8a5318981991b138f8ea073c6d276f4a
pkgver=4.21.7+r139+g222d036c8
pkgrel=1
pkgdesc='File manager for Xfce (master branch, pinned commit)'
arch=('x86_64')
license=('GPL-2.0-or-later')
url='https://docs.xfce.org/xfce/thunar/start'
depends=('desktop-file-utils' 'gtk3' 'hicolor-icon-theme' 'libgudev' 'libgexiv2'
         'libnotify' 'libpng' 'libxfce4ui>=4.21.8' 'libxfce4util' 'pcre2'
         'libcanberra' 'polkit' 'vte3' 'xfconf')
makedepends=('git' 'meson' 'glib2-devel' 'xfce4-dev-tools' 'xfce4-panel' 'gobject-introspection')
optdepends=('gvfs: trash support, mounting with udisks, and remote filesystems'
            'xfce4-panel: trash applet'
            'tumbler: for thumbnail previews'
            'thunar-volman: manages removable devices'
            'thunar-archive-plugin: create and deflate archives'
            'thunar-media-tags-plugin: view/edit id3/ogg tags'
            'catfish: file search')
provides=("${_pkgname}=${pkgver%%+*}")
conflicts=("${_pkgname}")
replaces=("${_pkgname}")
source=("${_pkgname}::git+https://gitlab.xfce.org/xfce/${_pkgname}.git#commit=${_commit}")
sha256sums=('SKIP')

pkgver() {
  cd "${_pkgname}"
  git describe --long --tags | sed -r "s:^${_pkgname}.::;s/^v//;s/^xfce-//;s/-([0-9]+)-/+r\1+/;s/-/+/g"
}

build() {
  local meson_options=(
    -D gtk-doc=false
    -D gudev=enabled
    -D gexiv2=enabled
    -D polkit=enabled
    -D terminal=enabled
    -D session-management=disabled
  )
  arch-meson "${_pkgname}" build "${meson_options[@]}"
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"
}
