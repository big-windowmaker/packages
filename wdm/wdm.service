[Unit]
Description=WINGs Display Manager
Documentation=man:wdm(1)
Conflicts=getty@tty7.service plymouth-quit.service
After=systemd-user-sessions.service getty@tty7.service plymouth-quit.service systemd-logind.service
# Sem tela de login depois de 5 falhas em 2 minutos: o tty2 (Ctrl+Alt+F2)
# continua disponível para recuperar o sistema.
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
ExecStart=/usr/bin/wdm -nodaemon
Restart=always
RestartSec=2
IgnoreSIGPIPE=no

[Install]
Alias=display-manager.service
