+/* Last record written by wdm on the reply pipe, or "" (see Greet.c). */
+static void
+ReadReply(char *out, size_t size)
+{
+	char buf[2048];
+	ssize_t n, i, start = 0;
+
+	*out = '\0';
+	if(reply_fd < 0)
+		return;
+	while((n = read(reply_fd, buf, sizeof(buf) - 1)) > 0)
+	{
+		buf[n] = '\0';
+		for(i = 0, start = 0; i < n; i++)
+			if(buf[i] == '\0')
+			{
+				snprintf(out, size, "%s", buf + start);
+				start = i + 1;
+			}
+	}
+}
+
+static void
+LoginFailed(LoginPanel * panel)
+{
+	char reply[1100], msg[1200];
+	const char *text = _(ExitFailStr[OptionCode]);
+
+	ReadReply(reply, sizeof(reply));
+	if(reply[0] == 'P' && reply[1])
+		text = reply + 1;	/* PAM module, already translated */
+	else if(reply[0] == 'L')
+	{
+		int minutes = atoi(reply + 1);
+
+		if(minutes > 0)
+			snprintf(msg, sizeof(msg), _("Account temporarily locked after too many "
+				"wrong passwords. Try again in %d min."), minutes);
+		else
+			snprintf(msg, sizeof(msg), "%s", _("Account locked after too many wrong "
+				"passwords. Ask the administrator to unlock it."));
+		text = msg;
+	}
+
+	if(OptionCode == 0 && LoginName && LoginName[0])
+	{
+		/* keep the user name: straight back to the password */
+		if(LoginPswd)
+			wfree(LoginPswd);
+		LoginPswd = NULL;
+		LoginSwitch = True;
+		init_pwdfield("");
+		WMSetFocusToWidget(panel->entryText);
+	}
+	else
+		InitializeLoginInput(panel);
+	PrintErrMsg(panel, (char *) text);
+}
