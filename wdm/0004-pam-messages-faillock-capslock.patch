+/* Shows "Caps Lock is on" while the lock is active (XKB state). */
+static void
+UpdateCapsLock(LoginPanel * panel)
+{
+	XkbStateRec st;
+	int on;
+
+	if(!panel || XkbGetState(WMScreenDisplay(panel->scr), XkbUseCoreKbd, &st) != Success)
+		return;
+	on = (st.locked_mods & LockMask) != 0;
+	if(on == panel->capsShown)
+		return;
+	panel->capsShown = on;
+	if(panel->capsL)
+	{
+		if(on)
+			WMMapWidget(panel->capsL);
+		else
+			WMUnmapWidget(panel->capsL);
+	}
+	else if(on && !panel->msgFlag)
+		PrintInfoMsg(panel, _("Caps Lock is on"));
+}
+
+static void
+SetupCapsLock(LoginPanel * panel)
+{
+	Display *dpy = WMScreenDisplay(panel->scr);
+	int opcode, error, major = XkbMajorVersion, minor = XkbMinorVersion;
+
+	if(XkbQueryExtension(dpy, &opcode, &xkb_event_base, &error, &major, &minor))
+		XkbSelectEventDetails(dpy, XkbUseCoreKbd, XkbStateNotify,
+				XkbModifierLockMask, XkbModifierLockMask);
+	else
+		xkb_event_base = -1;
+	if(panel->capsL)
+		WMUnmapWidget(panel->capsL);
+	panel->capsShown = False;
+	UpdateCapsLock(panel);
+}
