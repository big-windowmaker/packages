+/*
+ * Messages of the PAM modules (PAM_ERROR_MSG, PAM_TEXT_INFO), e.g. the
+ * "account is locked" of pam_faillock, kept for the login panel.  They
+ * come translated by Linux-PAM in the locale set in main().
+ */
+static char PAM_messages[1024];
+
+const char *VerifyMessages (void)
+{
+	return PAM_messages;
+}
+
+static void PAM_add_message (const char *m)
+{
+	size_t l = strlen (PAM_messages);
+
+	if (!m || !*m)
