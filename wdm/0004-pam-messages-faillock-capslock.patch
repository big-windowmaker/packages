+/* Tells wdmLogin why the attempt failed (see reply_filedes). */
+static void ReportFailure (struct greet_info *greet)
+{
+    char buf[1100];
+    const char *msgs = NULL;
+    struct passwd *pw;
+    int minutes;
+
+    if (reply_filedes[1] < 0)
+        return;
+#ifdef USE_PAM
+    msgs = VerifyMessages();
+#endif
+    if (msgs && *msgs)
+        snprintf(buf, sizeof(buf), "P%s", msgs);
+    else {
+        pw = greet->name ? getpwnam(greet->name) : NULL;
+        minutes = pw ? WDMFaillockMinutesLeft(greet->name, pw->pw_uid == 0,
+                                              NULL, NULL, time(NULL)) : 0;
+        if (minutes == 0)
+            return;
+        snprintf(buf, sizeof(buf), "L%d", minutes < 0 ? 0 : minutes);
+    }
+    if (write(reply_filedes[1], buf, strlen(buf) + 1) < 0)
+        WDMDebug("cannot write to %s: %s\n", wdmLogin, strerror(errno));
+}
+
 static void CloseGreet (int pid)
 {
 
