@@ -41,6 +41,8 @@ from The Open Group.
 
 # include	<stdio.h>
 #include <string.h>
+#include <locale.h>
+#include <stdlib.h>
 #ifdef X_POSIX_C_SOURCE
 #define _POSIX_C_SOURCE X_POSIX_C_SOURCE
 #include <signal.h>
@@ -106,6 +108,41 @@ static int StorePid (void);
 
