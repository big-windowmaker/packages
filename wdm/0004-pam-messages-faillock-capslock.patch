diff --git a/src/libwdm/faillock.c b/src/libwdm/faillock.c
new file mode 100644
index 0000000..5b94daf
--- /dev/null
+++ b/src/libwdm/faillock.c
@@ -0,0 +1,148 @@
+/*
+ * wdm - WINGs display manager
+ * Copyright (C) 2026 Big WindowMaker <https://github.com/big-windowmaker>
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * faillock.c: lock state of pam_faillock, so the login panel can say that
+ * an account is locked instead of "Login failed" when pam_faillock is
+ * silent.  Record format and lock rule follow Linux-PAM's
+ * modules/pam_faillock (faillock.h, check_tally()).
+ */
+
+#include <wdmfaillock.h>
+#include <wdmsessions.h>	/* WDMValidUserName() */
+
+#include <ctype.h>
+#include <fcntl.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#define TALLY_STATUS_VALID 0x1
+
+struct tally {			/* 64 bytes, as written by pam_faillock */
+	char source[52];
+	uint16_t reserved;
+	uint16_t status;
+	uint64_t time;
+};
+
+struct options {
+	char dir[256];
+	long deny;
+	long fail_interval;
+	long unlock_time;
+	long root_unlock_time;
+	int even_deny_root;
+};
+
+static void read_conf(const char *path, struct options *o)
+{
+	char line[512];
+	FILE *f = fopen(path, "r");
+
+	if (!f)
+		return;
+	while (fgets(line, sizeof(line), f)) {
+		char *k = line, *v, *e;
+
+		line[strcspn(line, "#\r\n")] = '\0';
+		while (isspace((unsigned char)*k))
+			k++;
+		if (!*k)
+			continue;
+		v = strchr(k, '=');
+		if (v) {
+			*v++ = '\0';
+			while (isspace((unsigned char)*v))
+				v++;
+		}
+		for (e = k + strlen(k); e > k && isspace((unsigned char)e[-1]); )
+			*--e = '\0';
+		if (v)
+			for (e = v + strlen(v); e > v && isspace((unsigned char)e[-1]); )
+				*--e = '\0';
+		if (strcmp(k, "even_deny_root") == 0)
+			o->even_deny_root = 1;
+		else if (!v || !*v)
+			continue;
+		else if (strcmp(k, "dir") == 0)
+			snprintf(o->dir, sizeof(o->dir), "%s", v);
+		else if (strcmp(k, "deny") == 0)
+			o->deny = strtol(v, NULL, 10);
+		else if (strcmp(k, "fail_interval") == 0)
+			o->fail_interval = strtol(v, NULL, 10);
+		else if (strcmp(k, "unlock_time") == 0)
+			o->unlock_time = strcmp(v, "never") == 0 ? 0 : strtol(v, NULL, 10);
+		else if (strcmp(k, "root_unlock_time") == 0)
+			o->root_unlock_time = strcmp(v, "never") == 0 ? 0 : strtol(v, NULL, 10);
+	}
+	fclose(f);
+}
+
+int WDMFaillockMinutesLeft(const char *user, int isRoot, const char *conf,
+			   const char *dir, time_t now)
+{
+	struct options o;
+	struct tally t;
+	char path[512];
+	uint64_t latest = 0, times[1024];
+	long failures = 0, unlock;
+	int fd, n = 0, i;
+
+	if (!WDMValidUserName(user))
+		return 0;
+	memset(&o, 0, sizeof(o));
+	snprintf(o.dir, sizeof(o.dir), "/var/run/faillock");
+	o.deny = 3;
+	o.fail_interval = 900;
+	o.unlock_time = 600;
+	o.root_unlock_time = -1;
+	read_conf(conf ? conf : WDM_FAILLOCK_CONF, &o);
+	if (o.root_unlock_time < 0)
+		o.root_unlock_time = o.unlock_time;
+	if (dir)
+		snprintf(o.dir, sizeof(o.dir), "%s", dir);
+	if (o.deny <= 0 || (isRoot && !o.even_deny_root))
+		return 0;
+
+	snprintf(path, sizeof(path), "%s/%s", o.dir, user);
+	fd = open(path, O_RDONLY | O_NOFOLLOW | O_CLOEXEC);
+	if (fd < 0)
+		return 0;
+	while (n < 1024 && read(fd, &t, sizeof(t)) == (ssize_t)sizeof(t)) {
+		if (!(t.status & TALLY_STATUS_VALID))
+			continue;
+		times[n++] = t.time;
+		if (t.time > latest)
+			latest = t.time;
+	}
+	close(fd);
+	for (i = 0; i < n; i++)
+		if ((int64_t)(latest - times[i]) < o.fail_interval)
+			failures++;
+	if (failures < o.deny)
+		return 0;
+	unlock = isRoot ? o.root_unlock_time : o.unlock_time;
+	if (unlock == 0)
+		return -1;	/* until "faillock --reset" */
+	if ((int64_t)latest + unlock < (int64_t)now)
+		return 0;	/* unlock time expired */
+	{
+		int64_t left = (int64_t)latest + unlock - (int64_t)now;
+		int minutes = (int)((left + 59) / 60);
+
+		return minutes > 0 ? minutes : 1;
+	}
+}
