+	WDMInfo("PAM: %s\n", m);
+	snprintf (PAM_messages + l, sizeof (PAM_messages) - l, "%s%s",
+		  l ? "\n" : "", m);
+	/* no trailing newline */
+	l = strlen (PAM_messages);
+	while (l > 0 && PAM_messages[l - 1] == '\n')
+		PAM_messages[--l] = '\0';
+}
