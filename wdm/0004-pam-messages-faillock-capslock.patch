+/*
+ * System locale (/etc/locale.conf, which systemd normally passes in LANG):
+ * the messages of the PAM modules (pam_faillock: "account locked") come
+ * translated by Linux-PAM, and LANG is exported to wdmLogin and sessions.
+ */
+static void
+InitLocale (void)
+{
+    static const char *keys[] = { "LANG", "LC_MESSAGES", "LC_CTYPE", NULL };
+    char line[256];
+    FILE *f;
+    int i;
+
+    if (!getenv ("LANG") && (f = fopen ("/etc/locale.conf", "r")) != NULL) {
+	while (fgets (line, sizeof (line), f)) {
+	    char *v = strchr (line, '=');
+
+	    if (!v)
+		continue;
+	    *v++ = '\0';
+	    v[strcspn (v, "\r\n")] = '\0';
+	    if (*v == '"' && v[strlen (v) - 1] == '"' && strlen (v) >= 2) {
+		v[strlen (v) - 1] = '\0';
+		v++;
+	    }
+	    for (i = 0; keys[i]; i++)
+		if (strcmp (line, keys[i]) == 0 && *v && !getenv (keys[i]))
+		    setenv (keys[i], v, 0);
+	}
+	fclose (f);
+    }
+    setlocale (LC_CTYPE, "");
+    setlocale (LC_MESSAGES, "");
+}
+
