#!/bin/sh
# Inicia a sessão X11 escolhida no wdm. Executado como o usuário:
#   Xsession <comando do Exec= do .desktop da sessão>
# A saída vai para ~/.xsession-errors, como no LightDM.

errfile="$HOME/.xsession-errors"
if (umask 077 && : >"$errfile") 2>/dev/null; then
    exec >"$errfile" 2>&1
fi
echo "wdm: sessão X11 iniciada em $(date): $*"

# Perfis de login (mesma ordem do Xsession do LightDM).
for file in /etc/profile "$HOME/.profile" /etc/xprofile "$HOME/.xprofile"; do
    if [ -f "$file" ]; then
        . "$file"
    fi
done

for file in /etc/X11/Xresources "$HOME/.Xresources"; do
    if [ -f "$file" ]; then
        xrdb -merge "$file"
    fi
done
if [ -f "$HOME/.Xkbmap" ]; then
    setxkbmap $(cat "$HOME/.Xkbmap")
fi
if [ -f "$HOME/.Xmodmap" ]; then
    xmodmap "$HOME/.Xmodmap"
fi

# xinitrc.d: o 50-systemd-user.sh passa DISPLAY e XAUTHORITY ao systemd --user.
if [ -d /etc/X11/xinit/xinitrc.d ]; then
    for file in /etc/X11/xinit/xinitrc.d/?*.sh; do
        if [ -x "$file" ]; then
            . "$file"
        fi
    done
fi
unset file errfile

if [ $# -eq 0 ]; then
    # Nenhuma sessão instalada: ~/.xsession, Big WindowMaker ou Window Maker.
    if [ -x "$HOME/.xsession" ]; then
        set -- "$HOME/.xsession"
    elif command -v startbigwm >/dev/null 2>&1; then
        set -- startbigwm
    else
        set -- wmaker
    fi
fi
exec "$@"
