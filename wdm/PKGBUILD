prepare() {
  cd "wdm-${pkgver}"

  # Patches do Debian, na ordem do series.
  local _p
  while read -r _p; do
    [[ -z ${_p} || ${_p} == \#* ]] && continue
    patch -Np1 -i "${srcdir}/debian/patches/${_p}"
  done < "${srcdir}/debian/patches/series"

  for _p in "${srcdir}"/000[0-9]-*.patch; do
    patch -Np1 -i "${_p}"
  done

  autoconf -f
}

build() {
  cd "wdm-${pkgver}"
  # Código K&R: declarações como "char **systemEnv();" não compilam em C23,
  # o padrão do GCC 15.
  CFLAGS+=' -std=gnu17'
  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --mandir=/usr/share/man \
    --localstatedir=/var/lib/wdm \
    --with-wdmdir=/etc/wdm \
    --with-nlsdir=/usr/share/locale \
    --with-gfxdir=/usr/share/wdm/pixmaps \
    --with-fakehome=/var/lib/wdm \
    --with-runlockdir=/run \
    --with-logdir=/var/log \
    --with-defuserpath=/usr/local/sbin:/usr/local/bin:/usr/bin \
    --with-defsystempath=/usr/local/sbin:/usr/local/bin:/usr/bin \
    --enable-pam \
    --with-pamdir=/etc/pam.d \
    --enable-aafont
  make
}

check() {
  cd "wdm-${pkgver}"
  # libwdm: leitura dos .desktop, divisão do Exec, sessão lembrada e
  # WDMUnsetEnv.
  cc ${CFLAGS} -std=gnu17 ${LDFLAGS} -Iinclude $(pkg-config --cflags WINGs) \
    "${srcdir}/test-sessions.c" bin/libwdm.a $(pkg-config --libs WINGs) \
    -o test-sessions
  rm -rf test-tmp
  mkdir test-tmp
  ./test-sessions "${PWD}/test-tmp"
  # Tradução e scripts de sessão.
  msgfmt -c -o /dev/null po/pt_BR.po
  local _s
  for _s in Xsession Wsession Xsetup_0 Xstartup Xreset; do
    sh -n "${srcdir}/${_s}"
  done
}

package() {
  cd "wdm-${pkgver}"
  # Só o wdm e o wdmLogin: o wdmChooser (XDMCP) e as imagens de exemplo do
  # upstream (algumas da NASA, com licença própria) ficam de fora.
  make DESTDIR="${pkgdir}" install-bin install-doc install-nls-yes

  local _f
  for _f in wdm-config wdmLogin-config Xservers Xaccess Xresources; do
    install -Dm644 "${srcdir}/${_f}" "${pkgdir}/etc/wdm/${_f}"
  done
  for _f in Xsetup_0 Xstartup Xreset Xsession Wsession; do
    install -Dm755 "${srcdir}/${_f}" "${pkgdir}/etc/wdm/${_f}"
  done
  install -Dm644 "${srcdir}/wdm.pam" "${pkgdir}/etc/pam.d/wdm"
  install -Dm644 "${srcdir}/wdm.service" "${pkgdir}/usr/lib/systemd/system/wdm.service"
  install -Dm644 "${srcdir}/wdm.tmpfiles" "${pkgdir}/usr/lib/tmpfiles.d/wdm.conf"
  install -Dm644 "${srcdir}/debian/copyright" "${pkgdir}/usr/share/licenses/${pkgname}/copyright"
}
