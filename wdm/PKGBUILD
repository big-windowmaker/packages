# Maintainer: Big WindowMaker <https://github.com/big-windowmaker>
# Baseado no pacote do Debian (wdm 1.28-27, Axel Beckert e Agustín Martín
# Domingo) e no do AUR (wdm 1.28-9, Brian Bidulock).

# WDM, o WINGs Display Manager: derivado do xdm, com a tela de login em
# WINGs (visual NeXT/Window Maker). O upstream (github.com/raorn/wdm) está
# parado desde 2012; quem mantém a 1.28 viva é o Debian, com 11 patches
# (sessão PAM aberta no processo pai, por causa do logind, entre outros).
#
# Fontes: o tarball original da 1.28 e o debian.tar.xz da 1.28-27, pelas URLs
# permanentes do snapshot.debian.org (checksums iguais aos do .dsc do
# Debian). O tarball traz o Makefile.in e o configure gerados, que o git do
# upstream não tem.
#
# Patches próprios, depois dos do Debian (o upstream não recebe mais PRs):
#   0001  build com GCC 15 e pkgconf; versão 1.28 no AC_INIT.
#   0002  daemon: lista de sessões a partir de xsessions e wayland-sessions,
#         ambiente do pam_systemd (XDG_SEAT, XDG_VTNR, tipo e classe da
#         sessão) e sessões Wayland: depois da autenticação o wdm encerra o
#         servidor X e inicia a sessão no mesmo VT, com sessão própria no
#         logind (Type=wayland); ao sair, a tela de login volta.
#   0003  wdmLogin: seletor "Sessão (F2)", atalhos de teclado, sessão
#         lembrada por usuário, aviso de sessão que terminou cedo, papel de
#         parede sem distorção e tradução pt_BR.
#   0004  mensagens dos módulos PAM na tela de login (pam_faillock: "Conta
#         bloqueada…", traduzida pelo Linux-PAM na localidade do sistema);
#         sem mensagem, o wdm calcula o bloqueio a partir do faillock.conf e
#         de /run/faillock; nome mantido depois de senha errada; aviso
#         "Caps Lock ativado"; PAM_RHOST só em telas remotas.
#   0005  lista de usuários (pop-up com "Nome (login)" das contas humanas,
#         último usuário pré-selecionado, setas/Home/End/primeiras letras;
#         "Outro..." abre o campo de texto para LDAP e contas ocultas).
# A configuração (wdm-config, Xservers, Xsession, Wsession, PAM, unidade do
# systemd) fica neste diretório, fora dos patches.
#
# pkgrel começa em 10: o AUR já publicou a 1.28-9, e um wdm do AUR instalado
# não pode parecer mais novo que este.
pkgname=wdm
pkgver=1.28
_debrel=27
_snapshot=20230829T151102Z
pkgrel=14
pkgdesc='WINGs Display Manager: login screen with the NeXT look, X11 and Wayland sessions'
arch=(x86_64)
url='https://github.com/raorn/wdm'
license=('GPL-2.0-or-later AND X11')
depends=(
  glibc
  libx11
  libxau
  libxcrypt
  libxdmcp
  libxinerama
  libxmu
  pam
  sh
  # libWINGs, libWUtil e libwraster do windowmaker do Big WindowMaker: o
  # 0.96.0 do Manjaro exporta LIBWRASTER7 com o mesmo soname, e o wdmLogin
  # compilado contra ele não abre com o nosso (e vice-versa).
  'windowmaker>=0.96.0.r130'
  xorg-server  # o wdm executa o /usr/bin/X do Xservers
  xorg-xrdb    # recursos X da tela de login (Xresources)
)
optdepends=(
  'big-wm-themes: logo e papel de parede do Big WindowMaker na tela de login'
  'numlockx: Num Lock ligado na tela de login'
)
backup=(
  etc/pam.d/wdm
  etc/wdm/Wsession
  etc/wdm/Xaccess
  etc/wdm/Xreset
  etc/wdm/Xresources
  etc/wdm/Xservers
  etc/wdm/Xsession
  etc/wdm/Xsetup_0
  etc/wdm/Xstartup
  etc/wdm/wdm-config
  etc/wdm/wdmLogin-config
)
source=(
  "https://snapshot.debian.org/archive/debian/${_snapshot}/pool/main/w/wdm/wdm_${pkgver}.orig.tar.gz"
  "https://snapshot.debian.org/archive/debian/${_snapshot}/pool/main/w/wdm/wdm_${pkgver}-${_debrel}.debian.tar.xz"
  0001-build-gcc15-pkgconf-version.patch
  0002-desktop-sessions-logind-wayland.patch
  0003-wdmLogin-session-selector-keyboard-pt_BR.patch
  0004-pam-messages-faillock-capslock.patch
  0005-wdmLogin-user-list.patch
  wdm-config
  wdmLogin-config
  Xservers
  Xaccess
  Xresources
  Xsetup_0
  Xstartup
  Xreset
  Xsession
  Wsession
  wdm.pam
  wdm.service
  wdm.tmpfiles
  test-sessions.c
)
