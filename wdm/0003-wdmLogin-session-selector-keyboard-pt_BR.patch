 	{
 		ClearMsgs(panel);
 	}
-	if(event->xkey.keycode == panel->retkey)
-	{
-		PerformLogin(panel, True);
-	}
-	else if(event->xkey.keycode == panel->tabkey)
+	switch(ks)
 	{
+	case XK_Return:
+	case XK_KP_Enter:
+		if(OptionCode != 0)
+			goPressed(NULL, panel);
+		else
+			PerformLogin(panel, True);
+		break;
+	case XK_Tab:
 		PerformLogin(panel, False);
+		break;
+	case XK_Escape:
+		startoverPressed(NULL, panel);
+		break;
+	case XK_F1:
+		helpPressed(NULL, panel);
+		break;
+	case XK_F2:
