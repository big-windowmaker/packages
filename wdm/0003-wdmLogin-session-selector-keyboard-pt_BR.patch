+static void
+HandleSignalPipe(int fd, int mask, void *data)
+{
+	char buf[16];
+	ssize_t n, i;
+
+	n = read(fd, buf, sizeof(buf));
+	for(i = 0; i < n; i++)
+	{
+		if(buf[i] == 'u')
+		{
+			InitializeLoginInput(panel);
+			PrintErrMsg(panel, _(ExitFailStr[OptionCode]));
