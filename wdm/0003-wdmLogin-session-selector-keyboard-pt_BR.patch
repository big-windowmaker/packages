+static int
+CyclePopUp(WMPopUpButton *button, int delta)
+{
+	int n = WMGetPopUpButtonNumberOfItems(button);
+	int i = WMGetPopUpButtonSelectedItem(button);
+
+	if(n <= 0)
+		return 0;
+	if(i < 0)
+		i = 0;
+	i = ((i + delta) % n + n) % n;
+	WMSetPopUpButtonSelectedItem(button, i);
+	return i;
+}
+
+/*
+ * Keyboard: Enter goes on (or runs the selected option), Tab switches
+ * between name and password, Esc starts over, F1 shows the help,
+ * F2/Shift+F2 choose the session, F3/Shift+F3 choose the option.
+ */
 static void
 handleKeyPress(XEvent * event, void *clientData)
 {
 	LoginPanel *panel = (LoginPanel *) clientData;
+	KeySym ks = XLookupKeysym(&event->xkey, 0);
+	int back = (event->xkey.state & ShiftMask) ? -1 : 1;
 
