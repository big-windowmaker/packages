+static int
+FindSessionIndex(const char *key)
+{
+	WDMSession *s;
+
+	if(!sessions || !key)
+		return -1;
+	s = WDMFindSession(sessions, key);
+	return s ? (int)(s - sessions->items) : -1;
+}
+
+static int
+SetupSessions()
+{
+	int i, def = -1;
+
+	if(!xSessionDirs && !waylandSessionDirs)
+		return False;
+	sessions = WDMReadSessions(xSessionDirs, waylandSessionDirs, NULL);
+	if(sessions->count == 0)
+	{
+		WDMError("no desktop sessions found in %s and %s\n",
+			xSessionDirs ? xSessionDirs : "-",
+			waylandSessionDirs ? waylandSessionDirs : "-");
+		WDMFreeSessions(sessions);
+		sessions = NULL;
+		return False;
+	}
+	WmStr = (char **) malloc(sizeof(char *) * (sessions->count + 1));
+	for(i = 0; i < sessions->count; i++)
+		WmStr[i] = sessions->items[i].label;
+	WmStr[i] = NULL;
+
+	def = FindSessionIndex(defaultSession);
+	for(i = 0; def < 0 && i < sessions->count; i++)
+		if(sessions->items[i].type == WDM_SESSION_X11)
+			def = i;
+	WmOptionCode = def < 0 ? 0 : def;
+	return True;
+}
+
+/* after the user name is known: preselect the session used last time */
+static void
+SelectUserSession(const char *user)
+{
+	char *key;
+	int idx;
+
+	if(!sessions || sessionTouched || !sessionStateDir)
+		return;
+	key = WDMLoadUserSession(sessionStateDir, user);
+	idx = FindSessionIndex(key);
+	free(key);
+	if(idx >= 0)
+	{
+		WmOptionCode = idx;
+		WMSetPopUpButtonSelectedItem(panel->wmBtn, idx);
+	}
+}
