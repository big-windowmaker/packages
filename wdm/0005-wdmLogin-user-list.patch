diff --git a/src/libwdm/users.c b/src/libwdm/users.c
new file mode 100644
index 0000000..a8b4fe9
--- /dev/null
+++ b/src/libwdm/users.c
@@ -0,0 +1,295 @@
+/*
+ * wdm - WINGs display manager
+ * Copyright (C) 2026 Big WindowMaker <https://github.com/big-windowmaker>
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * users.c: the accounts listed by wdmLogin, filtered like the user lists
+ * of other display managers (login.defs, /etc/shells, shadow, the
+ * SystemAccount flag of AccountsService).
+ */
+
+#include <wdmusers.h>
+#include <wdmsessions.h>	/* WDMValidUserName() */
+
+#include <ctype.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <pwd.h>
+#include <shadow.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+#include <sys/stat.h>
+#include <time.h>
+#include <unistd.h>
+
+static char *xstrdup(const char *s)
+{
+	char *r = strdup(s ? s : "");
+
+	if (!r)
+		abort();
+	return r;
+}
+
+static void read_login_defs(const char *path, long *uid_min, long *uid_max)
+{
+	char line[512], key[64];
+	long v;
+	FILE *f = fopen(path, "r");
+
+	if (!f)
+		return;
+	while (fgets(line, sizeof(line), f)) {
+		if (sscanf(line, " %63s %ld", key, &v) != 2 || key[0] == '#')
+			continue;
+		if (strcmp(key, "UID_MIN") == 0)
+			*uid_min = v;
+		else if (strcmp(key, "UID_MAX") == 0)
+			*uid_max = v;
+	}
+	fclose(f);
+}
+
+static int valid_shell(const char *shells, const char *shell)
+{
+	char line[512];
+	const char *base;
+	FILE *f;
+	int ok = 0;
+
+	if (!shell || !*shell)
+		shell = "/bin/sh";
+	base = strrchr(shell, '/');
+	base = base ? base + 1 : shell;
+	if (strcmp(base, "nologin") == 0 || strcmp(base, "false") == 0)
+		return 0;
+	f = fopen(shells, "r");
+	if (!f)
+		return 1;	/* no /etc/shells: like getusershell(), any shell */
+	while (!ok && fgets(line, sizeof(line), f)) {
+		line[strcspn(line, " \t\r\n#")] = '\0';
+		ok = line[0] == '/' && strcmp(line, shell) == 0;
+	}
+	fclose(f);
+	return ok;
+}
+
+/* 1 when the shadow entry says the account cannot log in with a password
+ * now: locked ("!...") or expired. */
+static int locked(const WDMUserSources *src, const char *login)
+{
+	struct spwd *sp = NULL;
+	int r = 0;
+
+	if (src->shadow) {
+		FILE *f = fopen(src->shadow, "r");
+
+		if (!f)
+			return 0;
+		while ((sp = fgetspent(f)) != NULL)
+			if (strcmp(sp->sp_namp, login) == 0)
+				break;
+		if (sp)
+			r = (sp->sp_pwdp && sp->sp_pwdp[0] == '!') ||
+			    (sp->sp_expire > 0 && src->today >= sp->sp_expire);
+		fclose(f);
+		return r;
+	}
+	sp = getspnam(login);
+	if (!sp)
+		return 0;	/* not in shadow (NSS, LDAP): let PAM decide */
+	return (sp->sp_pwdp && sp->sp_pwdp[0] == '!') ||
+	       (sp->sp_expire > 0 && src->today >= sp->sp_expire);
+}
+
+static int system_account(const char *dir, const char *login)
+{
+	char path[1024], line[256];
+	FILE *f;
+	int r = 0;
+
+	if (!dir || !*dir)
+		return 0;
+	snprintf(path, sizeof(path), "%s/%s", dir, login);
+	f = fopen(path, "r");
+	if (!f)
+		return 0;
+	while (!r && fgets(line, sizeof(line), f)) {
+		line[strcspn(line, "\r\n")] = '\0';
+		r = strcasecmp(line, "SystemAccount=true") == 0;
+	}
+	fclose(f);
+	return r;
+}
+
+static int cmp_user(const void *a, const void *b)
+{
+	const WDMUser *x = a, *y = b;
+	int r = strcasecmp(x->label, y->label);
+
+	return r ? r : strcmp(x->login, y->login);
+}
+
+static void consider(WDMUserList *l, const WDMUserSources *src, const struct passwd *pw,
+		     long uid_min, long uid_max, int *overflow, int max)
+{
+	WDMUser *u;
+	char *real, *label;
+	size_t n;
+	int i;
+
+	if (!pw || !WDMValidUserName(pw->pw_name) || (long)pw->pw_uid < uid_min ||
+	    (long)pw->pw_uid > uid_max || !valid_shell(src->shells, pw->pw_shell) ||
+	    system_account(src->accountsDir, pw->pw_name) || locked(src, pw->pw_name))
+		return;
+	for (i = 0; i < l->count; i++)
+		if (strcmp(l->items[i].login, pw->pw_name) == 0)
+			return;
+	if (l->count >= max) {
+		*overflow = 1;
+		return;
+	}
+	real = xstrdup(pw->pw_gecos);
+	real[strcspn(real, ",")] = '\0';
+	while ((n = strlen(real)) > 0 && isspace((unsigned char)real[n - 1]))
+		real[n - 1] = '\0';
+	if (*real && strcmp(real, pw->pw_name) != 0) {
+		n = strlen(real) + strlen(pw->pw_name) + 4;
+		label = malloc(n);
+		if (!label)
+			abort();
+		snprintf(label, n, "%s (%s)", real, pw->pw_name);
+	} else
+		label = xstrdup(pw->pw_name);
+	l->items = realloc(l->items, sizeof(WDMUser) * (l->count + 1));
+	if (!l->items)
+		abort();
+	u = &l->items[l->count++];
+	u->login = xstrdup(pw->pw_name);
+	u->realName = real;
+	u->label = label;
+	u->uid = pw->pw_uid;
+}
+
+WDMUserList *WDMReadUsers(const WDMUserSources *src, int max)
+{
+	WDMUserList *l = calloc(1, sizeof(WDMUserList));
+	long uid_min = 1000, uid_max = 60000;
+	struct passwd *pw;
+	int overflow = 0;
+
+	if (!l)
+		abort();
+	read_login_defs(src->loginDefs ? src->loginDefs : "/etc/login.defs", &uid_min, &uid_max);
+	if (src->passwd) {
+		FILE *f = fopen(src->passwd, "r");
+
+		if (f) {
+			while ((pw = fgetpwent(f)) != NULL)
+				consider(l, src, pw, uid_min, uid_max, &overflow, max);
+			fclose(f);
+		}
+	} else {
+		setpwent();
+		while ((pw = getpwent()) != NULL)
+			consider(l, src, pw, uid_min, uid_max, &overflow, max);
+		endpwent();
+	}
+	if (!src->shadow)
+		endspent();
+	if (overflow) {
+		WDMUserList *empty = calloc(1, sizeof(WDMUserList));
+
+		WDMFreeUsers(l);
+		if (!empty)
+			abort();
+		return empty;
+	}
+	if (l->count > 1)
+		qsort(l->items, l->count, sizeof(WDMUser), cmp_user);
+	return l;
+}
+
+void WDMFreeUsers(WDMUserList *list)
+{
+	int i;
+
+	if (!list)
+		return;
+	for (i = 0; i < list->count; i++) {
+		free(list->items[i].login);
+		free(list->items[i].realName);
+		free(list->items[i].label);
+	}
+	free(list->items);
+	free(list);
+}
+
+int WDMFindUser(const WDMUserList *list, const char *login)
+{
+	int i;
+
+	if (!list || !login)
+		return -1;
+	for (i = 0; i < list->count; i++)
+		if (strcmp(list->items[i].login, login) == 0)
+			return i;
+	return -1;
+}
+
+int WDMSaveLastUser(const char *statedir, const char *user)
+{
+	char path[1024], tmp[1100];
+	int fd, len, ok;
+
+	if (!statedir || !*statedir || !WDMValidUserName(user))
+		return 0;
+	if (mkdir(statedir, 0755) != 0 && errno != EEXIST)
+		return 0;
+	snprintf(path, sizeof(path), "%s/.last-user", statedir);
+	snprintf(tmp, sizeof(tmp), "%s.tmp", path);
+	unlink(tmp);
+	fd = open(tmp, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0644);
+	if (fd < 0)
+		return 0;
+	len = strlen(user);
+	ok = write(fd, user, len) == len && write(fd, "\n", 1) == 1;
+	ok = (close(fd) == 0) && ok;
+	if (!ok || rename(tmp, path) != 0) {
+		unlink(tmp);
+		return 0;
+	}
+	return 1;
+}
+
+char *WDMLoadLastUser(const char *statedir)
+{
+	char path[1024], buf[128];
+	int fd;
+	ssize_t n;
+
+	if (!statedir || !*statedir)
+		return NULL;
+	snprintf(path, sizeof(path), "%s/.last-user", statedir);
+	fd = open(path, O_RDONLY | O_NOFOLLOW | O_CLOEXEC);
+	if (fd < 0)
+		return NULL;
+	n = read(fd, buf, sizeof(buf) - 1);
+	close(fd);
+	if (n <= 0)
+		return NULL;
+	buf[n] = '\0';
+	buf[strcspn(buf, "\r\n")] = '\0';
+	return WDMValidUserName(buf) ? xstrdup(buf) : NULL;
+}
