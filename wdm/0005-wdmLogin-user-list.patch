+/* typing the first letters of the login or of the name selects the user */
+static void
+UserTypeAhead(XKeyEvent *ev)
+{
+	char buf[8];
+	KeySym ks;
+	int n, i, l;
+
+	n = XLookupString(ev, buf, sizeof(buf) - 1, &ks, NULL);
+	if(n != 1 || !isprint((unsigned char)buf[0]))
+		return;
+	if(ev->time - typeAheadTime > 1000)
+		typeAhead[0] = '\0';
+	typeAheadTime = ev->time;
+	l = strlen(typeAhead);
+	if(l < (int)sizeof(typeAhead) - 1)
+	{
+		typeAhead[l] = buf[0];
+		typeAhead[l + 1] = '\0';
+	}
+	l = strlen(typeAhead);
+	for(i = 0; i < users->count; i++)
+		if(strncasecmp(users->items[i].login, typeAhead, l) == 0
+		   || strncasecmp(users->items[i].label, typeAhead, l) == 0)
+		{
+			SelectUserIndex(i);
+			return;
+		}
+}
