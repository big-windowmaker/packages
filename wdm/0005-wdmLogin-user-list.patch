--- /dev/null
+++ b/include/wdmusers.h
@@ -0,0 +1,51 @@
+/*
+ * wdm - WINGs display manager
+ * Copyright (C) 2026 Big WindowMaker <https://github.com/big-windowmaker>
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ *
+ * wdmusers.h: accounts offered in the user list of wdmLogin.
+ */
+#ifndef _WDMUSERS_H
+#define _WDMUSERS_H
+
+#include <sys/types.h>
+
+typedef struct WDMUser {
+	char *login;
+	char *realName;		/* GECOS up to the first ',' (may be "") */
+	char *label;		/* "Real Name (login)" or "login" */
+	uid_t uid;
+} WDMUser;
+
+typedef struct WDMUserList {
+	int count;
+	WDMUser *items;
+} WDMUserList;
+
+typedef struct WDMUserSources {
+	const char *passwd;	/* file, or NULL for getpwent() (NSS) */
+	const char *shadow;	/* file, or NULL for getspnam() */
+	const char *loginDefs;	/* /etc/login.defs: UID_MIN, UID_MAX */
+	const char *shells;	/* /etc/shells */
+	const char *accountsDir;/* /var/lib/AccountsService/users */
+	long today;		/* days since the epoch, for expired accounts */
+} WDMUserSources;
+
+/* Human accounts: UID_MIN <= uid <= UID_MAX, a login shell listed in
+ * /etc/shells (not nologin/false), not locked ("!" in shadow) nor
+ * expired, not marked SystemAccount=true by AccountsService.  Sorted by
+ * label; at most "max" entries (0 when there are more: a list that long is
+ * useless, wdmLogin then shows the text field).  Never returns NULL. */
+WDMUserList *WDMReadUsers(const WDMUserSources *src, int max);
+void WDMFreeUsers(WDMUserList *list);
+int WDMFindUser(const WDMUserList *list, const char *login);
+
+/* Last user that logged in (<statedir>/.last-user). */
+int WDMSaveLastUser(const char *statedir, const char *user);
+char *WDMLoadLastUser(const char *statedir);
+
+#endif /* _WDMUSERS_H */
