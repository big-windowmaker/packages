@@ -0,0 +1,70 @@
+/*
+ * wdm - WINGs display manager
+ * Copyright (C) 2026 Big WindowMaker <https://github.com/big-windowmaker>
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ *
+ * wdmsessions.h: desktop session entries (xsessions and wayland-sessions).
+ *
+ * Both wdm (the daemon) and wdmLogin (the greeter) read the session list
+ * with the same code.  The greeter only sends back "<type>/<id>"; the
+ * daemon looks the id up again in its own list and never executes text
+ * received from the greeter.
+ */
+#ifndef _WDMSESSIONS_H
+#define _WDMSESSIONS_H
+
+#define WDM_SESSION_X11     0
+#define WDM_SESSION_WAYLAND 1
+
+typedef struct WDMSession {
+	int type;		/* WDM_SESSION_X11 or WDM_SESSION_WAYLAND */
+	char *id;		/* file name without ".desktop" */
+	char *name;		/* localized Name= */
+	char *label;		/* name shown in the greeter, with (X11)/(Wayland) */
+	char *exec;		/* Exec= (raw) */
+	char *desktopNames;	/* DesktopNames= (raw, ';' separated) or NULL */
+	char *path;		/* full path of the .desktop file */
+} WDMSession;
+
+typedef struct WDMSessionList {
+	int count;
+	WDMSession *items;
+} WDMSessionList;
+
+/* Reads the .desktop files from the ':' separated directory lists.
+ * Hidden/NoDisplay entries, entries without Exec and entries whose TryExec
+ * is not executable are skipped.  When the same id appears more than once
+ * for the same type, the first directory wins.  The list is sorted by
+ * label.  "locale" is used for Name[xx_YY]; NULL means $LC_ALL,
+ * $LC_MESSAGES or $LANG.  Never returns NULL. */
+WDMSessionList *WDMReadSessions(const char *xdirs, const char *wdirs,
+				const char *locale);
+void WDMFreeSessions(WDMSessionList *list);
+
+/* "x11/big-wm" -> entry, or NULL.  Also accepts a bare id when it is
+ * unique in the list. */
+WDMSession *WDMFindSession(WDMSessionList *list, const char *key);
+
+/* Writes "x11/big-wm" style key for the entry into buf. */
+char *WDMSessionKey(const WDMSession *s, char *buf, int size);
+
+/* Splits an Exec= value following the Desktop Entry Specification
+ * (quoting, escapes, %% and removal of field codes).  Returns a NULL
+ * terminated malloc'ed vector, or NULL on syntax error/empty command. */
+char **WDMSplitExec(const char *exec);
+void WDMFreeArgv(char **argv);
+
+/* Valid session id / user name for file names in the state directory. */
+int WDMValidSessionId(const char *id);
+int WDMValidUserName(const char *name);
+
+/* Remembered session of a user: <statedir>/<user>, content "type/id".
+ * WDMSaveUserSession() with key NULL forgets it. */
+int WDMSaveUserSession(const char *statedir, const char *user, const char *key);
+char *WDMLoadUserSession(const char *statedir, const char *user);
+
+#endif /* _WDMSESSIONS_H */
