+/*
+ * Desktop sessions: the greeter sends "x11/<id>" or "wayland/<id>".  The id
+ * is looked up again here, so only Exec lines of installed .desktop files
+ * are ever executed.  X11 sessions run "Xsession <Exec...>", Wayland
+ * sessions run "<wdmWaylandSession> <Exec...>".
+ */
+static int
+ResolveDesktopSession (struct display *d, struct greet_info *greet,
+		       struct verify_info *verify, char ***argvp)
+{
+	WDMSessionList *list;
+	WDMSession *s = NULL;
+	char key[300], **exec, **argv = NULL;
+	int i, canWayland = (d->displayType.location == Local && DisplayVT(d) > 0);
+
+	list = WDMReadSessions(wdmXSessionDirs,
+			       canWayland ? wdmWaylandSessionDirs : "", "C");
+	if (greet->string) {
+		s = WDMFindSession(list, greet->string);
+		if (!s)
+			WDMError("session \"%s\" not available, using the default\n",
+				 greet->string);
+	}
+	if (!s && wdmDefaultSession && *wdmDefaultSession)
+		s = WDMFindSession(list, wdmDefaultSession);
+	for (i = 0; !s && i < list->count; i++)
+		if (list->items[i].type == WDM_SESSION_X11)
+			s = &list->items[i];
+	if (!s && list->count > 0)
+		s = &list->items[0];
+	if (!s || !(exec = WDMSplitExec(s->exec))) {
+		WDMError("no usable desktop session found\n");
+		WDMFreeSessions(list);
+		return 0;
+	}
+	if (s->type == WDM_SESSION_WAYLAND)
+		argv = appendArg(NULL, wdmWaylandSession);
+	else if (d->session && *d->session)
+		argv = parseArgs(NULL, d->session);
+	for (i = 0; exec[i]; i++)
+		argv = appendArg(argv, exec[i]);
+	WDMFreeArgv(exec);
+
+	verify->sessionType = s->type;
+	verify->sessionKey = strdup(WDMSessionKey(s, key, sizeof(key)));
+	if (s->desktopNames && *s->desktopNames) {
+		verify->sessionDesktop = strdup(s->desktopNames);
+		verify->sessionDesktop[strcspn(verify->sessionDesktop, ";")] = '\0';
+	} else
+		verify->sessionDesktop = strdup(s->id);
+	if (!verify->sessionKey || !verify->sessionDesktop) {
+		WDMError("ResolveDesktopSession: out of memory\n");
+		exit (RESERVER_DISPLAY);
+	}
+	WDMInfo("user %s: session %s (%s)\n", greet->name, verify->sessionKey, s->path);
+	WDMFreeSessions(list);
+	*argvp = argv;
+	return 1;
+}
