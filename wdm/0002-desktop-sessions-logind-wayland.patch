+
+static int
+ActivateVT (int vt)
+{
+    char path[32];
+    struct vt_stat st;
+    int fd, i;
+
+    snprintf (path, sizeof (path), "/dev/tty%d", vt);
+    fd = open (path, O_RDWR | O_NOCTTY | O_CLOEXEC);
+    if (fd < 0) {
+	WDMError ("cannot open %s: %s\n", path, strerror (errno));
+	return 0;
+    }
+    /* an X server that died badly may leave the VT in graphics mode */
+    (void) ioctl (fd, KDSETMODE, KD_TEXT);
+    if (ioctl (fd, VT_ACTIVATE, vt) < 0)
+	WDMError ("VT_ACTIVATE %d failed: %s\n", vt, strerror (errno));
+    for (i = 0; i < 50; i++) {
+	if (ioctl (fd, VT_GETSTATE, &st) == 0 && st.v_active == vt)
+	    break;
+	usleep (100000);
+    }
+    close (fd);
+    if (i == 50) {
+	WDMError ("VT %d did not become active\n", vt);
+	return 0;
+    }
+    return 1;
