+    for (i = 0; i < 150; i++) {
+	if (kill (serverPid, 0) != 0 && errno == ESRCH)
+	    break;
+	usleep (100000);
+    }
+    if (i == 150) {
+	WDMError ("X server %d of display %s did not stop\n", serverPid, d->name);
+	return 0;
+    }
+    d->serverPid = -1;
+    return ActivateVT (vt);
+}
+
+static void
+SetTTYOwner (int vt, uid_t uid)
+{
+    char path[32];
+    struct group *gr = getgrnam ("tty");
+
+    snprintf (path, sizeof (path), "/dev/tty%d", vt);
+    if (chown (path, uid, gr ? gr->gr_gid : 0) != 0 || chmod (path, 0620) != 0)
+	WDMError ("cannot set owner of %s: %s\n", path, strerror (errno));
+}
+
+/* notice: number of seconds the session lasted, or "wayland" when the
+ * Wayland session could not be started */
+static void
+LeaveSessionNotice (struct display *d, const char *notice)
+{
+    char path[PATH_MAX], buf[32];
+    const char *p;
+    int fd, len;
+
+    if (!wdmRunDir || !*wdmRunDir)
+	return;
+    if (mkdir (wdmRunDir, 0755) != 0 && errno != EEXIST)
+	return;
+    snprintf (path, sizeof (path), "%s/notice-", wdmRunDir);
+    for (p = d->name; *p && strlen (path) < sizeof (path) - 2; p++) {
+	size_t l = strlen (path);
+	path[l] = isalnum ((unsigned char) *p) ? *p : '_';
+	path[l + 1] = '\0';
+    }
+    unlink (path);
+    fd = open (path, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0644);
+    if (fd < 0)
+	return;
+    len = snprintf (buf, sizeof (buf), "%s\n", notice);
+    if (write (fd, buf, len) != len)
+	unlink (path);
+    close (fd);
+}
