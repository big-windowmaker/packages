+static char **
+appendArg (char **argv, const char *arg)
+{
+	int i = 0;
+	char **n;
+
+	while (argv && argv[i])
+		i++;
+	n = realloc (argv, (i + 2) * sizeof (char *));
+	if (!n || !(n[i] = strdup (arg))) {
+		WDMError("appendArg: out of memory\n");
+		exit (RESERVER_DISPLAY);
+	}
+	n[i + 1] = NULL;
+	return n;
+}
