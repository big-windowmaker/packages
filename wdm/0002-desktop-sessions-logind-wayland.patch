+/*
+ * Wayland hand-off: a display process that authenticated a user for a
+ * Wayland session sends SIGUSR2; the X server of that display is then
+ * stopped without restarting the display (status "handoff").  The display
+ * is restarted normally when that process exits.
+ */
+#define MAX_HANDOFF 8
+static volatile sig_atomic_t handoffCount;
+static volatile pid_t handoffPids[MAX_HANDOFF];
+
+static void
+HandoffNotify (int n, siginfo_t *si, void *ctx)
+{
+    int olderrno = errno;
+
+    if (si && si->si_pid > 0 && si->si_uid == 0 && handoffCount < MAX_HANDOFF)
+	handoffPids[handoffCount++] = si->si_pid;
+    ChildReady = 1;
+    errno = olderrno;
+}
+
+static void
+InstallHandoffHandler (void)
+{
+    struct sigaction sa;
+
+    memset (&sa, 0, sizeof (sa));
+    sa.sa_sigaction = HandoffNotify;
+    sa.sa_flags = SA_SIGINFO | SA_RESTART;
+    sigemptyset (&sa.sa_mask);
+    sigaction (SIGUSR2, &sa, NULL);
+}
+
+static void
+ProcessHandoffs (void)
+{
+    sigset_t mask, omask;
+    pid_t pids[MAX_HANDOFF];
+    int i, n;
+    struct display *d;
+
+    sigemptyset (&mask);
+    sigaddset (&mask, SIGUSR2);
+    sigprocmask (SIG_BLOCK, &mask, &omask);
+    n = handoffCount;
+    for (i = 0; i < n; i++)
+	pids[i] = handoffPids[i];
+    handoffCount = 0;
+    sigprocmask (SIG_SETMASK, &omask, (sigset_t *) NULL);
+
+    for (i = 0; i < n; i++) {
+	d = FindDisplayByPid (pids[i]);
+	if (!d) {
+	    WDMError ("Wayland hand-off request from unknown process %d ignored\n", (int) pids[i]);
+	    continue;
+	}
+	if (d->status != running || d->serverPid < 2 ||
+	    d->displayType.location != Local) {
+	    WDMError ("Wayland hand-off for display %s refused (status %d, server %d)\n",
+		      d->name, (int) d->status, d->serverPid);
+	    continue;
+	}
+	WDMInfo ("display %s: stopping the X server for a Wayland session\n", d->name);
+	d->status = handoff;
+	TerminateProcess (d->serverPid, d->termSignal);
+    }
+}
