+#ifdef USE_PAM
+/* Environment for pam_systemd: seat, VT, session type and class. */
+static void
+SetLogindEnv (pam_handle_t *pamh, struct display *d, struct verify_info *verify)
+{
+    char buf[256];
+    int vt = DisplayVT (d);
+
+    if (verify->sessionType < 0)
+	return;
+    if (d->displayType.location == Local && vt > 0) {
+	pam_putenv (pamh, "XDG_SEAT=seat0");
+	snprintf (buf, sizeof (buf), "XDG_VTNR=%d", vt);
+	pam_putenv (pamh, buf);
+    }
+    pam_putenv (pamh, verify->sessionType == WDM_SESSION_WAYLAND ?
+		"XDG_SESSION_TYPE=wayland" : "XDG_SESSION_TYPE=x11");
+    pam_putenv (pamh, "XDG_SESSION_CLASS=user");
+    snprintf (buf, sizeof (buf), "XDG_SESSION_DESKTOP=%s", verify->sessionDesktop);
+    pam_putenv (pamh, buf);
+    if (verify->sessionType == WDM_SESSION_WAYLAND) {
+	/* a VT session, not an X display */
+	snprintf (buf, sizeof (buf), "tty%d", vt);
+	pam_set_item (pamh, PAM_TTY, buf);
+    }
+}
+#endif
