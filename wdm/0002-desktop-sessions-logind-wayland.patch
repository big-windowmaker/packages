diff --git a/src/libwdm/sessions.c b/src/libwdm/sessions.c
new file mode 100644
index 0000000..cf4391b
--- /dev/null
+++ b/src/libwdm/sessions.c
@@ -0,0 +1,600 @@
+/*
+ * wdm - WINGs display manager
+ * Copyright (C) 2026 Big WindowMaker <https://github.com/big-windowmaker>
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * sessions.c: read the desktop session entries of xsessions and
+ * wayland-sessions (Desktop Entry Specification, the subset display
+ * managers use).
+ */
+
+#include <wdmsessions.h>
+
+#include <ctype.h>
+#include <dirent.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#define LINE_MAX_LEN 4096
+#define TRYEXEC_PATH "/usr/local/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
+
+static char *xstrdup(const char *s)
+{
+	char *r;
+
+	if (!s)
+		return NULL;
+	r = strdup(s);
+	if (!r)
+		abort();
+	return r;
+}
+
+static void *xrealloc(void *p, size_t n)
+{
+	p = realloc(p, n);
+	if (!p)
+		abort();
+	return p;
+}
+
+int WDMValidSessionId(const char *id)
+{
+	const char *p;
+
+	if (!id || !*id || *id == '.' || *id == '-' || strlen(id) > 128)
+		return 0;
+	for (p = id; *p; p++)
+		if (!isalnum((unsigned char)*p) && !strchr("._+@-", *p))
+			return 0;
+	return 1;
+}
+
+int WDMValidUserName(const char *name)
+{
+	const char *p;
+
+	if (!name || !*name || *name == '.' || *name == '-' || strlen(name) > 64)
+		return 0;
+	for (p = name; *p; p++)
+		if (!isalnum((unsigned char)*p) && !strchr("._-", *p)
+		    && !(*p == '$' && p[1] == '\0'))
+			return 0;
+	return 1;
+}
+
+/* string escapes of the Desktop Entry Specification: \s \n \t \r \\ */
+static void unescape_string(char *s)
+{
+	char *r = s, *w = s;
+
+	while (*r) {
+		if (*r == '\\' && r[1]) {
+			r++;
+			switch (*r) {
+			case 's': *w++ = ' '; break;
+			case 'n': *w++ = '\n'; break;
+			case 't': *w++ = '\t'; break;
+			case 'r': *w++ = '\r'; break;
+			case '\\': *w++ = '\\'; break;
+			default: *w++ = '\\'; *w++ = *r; break;
+			}
+			r++;
+		} else
+			*w++ = *r++;
+	}
+	*w = '\0';
+}
+
+static char *trim(char *s)
+{
+	char *e;
+
+	while (*s == ' ' || *s == '\t')
+		s++;
+	e = s + strlen(s);
+	while (e > s && (e[-1] == ' ' || e[-1] == '\t' || e[-1] == '\n' || e[-1] == '\r'))
+		*--e = '\0';
+	return s;
+}
+
+static int parse_bool(const char *v)
+{
+	return v && (strcmp(v, "true") == 0 || strcmp(v, "1") == 0);
+}
+
+/* Locale candidates, most specific first: ll_CC@mod, ll_CC, ll@mod, ll. */
+static int locale_candidates(const char *locale, char cand[4][100])
+{
+	char lang[32] = "", country[32] = "", mod[32] = "";
+	const char *p = locale;
+	int n = 0, i;
+
+	if (!locale || !*locale || strcmp(locale, "C") == 0 || strcmp(locale, "POSIX") == 0)
+		return 0;
+	for (i = 0; *p && *p != '_' && *p != '.' && *p != '@' && i < 31; p++)
+		lang[i++] = *p;
+	lang[i] = '\0';
+	if (*p == '_') {
+		p++;
+		for (i = 0; *p && *p != '.' && *p != '@' && i < 31; p++)
+			country[i++] = *p;
+		country[i] = '\0';
+	}
+	while (*p && *p != '@')
+		p++;
+	if (*p == '@') {
+		p++;
+		for (i = 0; *p && i < 31; p++)
+			mod[i++] = *p;
+		mod[i] = '\0';
+	}
+	if (!*lang)
+		return 0;
+	if (*country && *mod)
+		snprintf(cand[n++], 100, "%s_%s@%s", lang, country, mod);
+	if (*country)
+		snprintf(cand[n++], 100, "%s_%s", lang, country);
+	if (*mod)
+		snprintf(cand[n++], 100, "%s@%s", lang, mod);
+	snprintf(cand[n++], 100, "%s", lang);
+	return n;
+}
+
+static int find_in_path(const char *prog)
+{
+	char buf[1024];
+	const char *p = TRYEXEC_PATH, *e;
+
+	if (strchr(prog, '/'))
+		return access(prog, X_OK) == 0;
+	while (*p) {
+		e = strchr(p, ':');
+		if (!e)
+			e = p + strlen(p);
+		snprintf(buf, sizeof(buf), "%.*s/%s", (int)(e - p), p, prog);
+		if (access(buf, X_OK) == 0)
+			return 1;
+		p = *e ? e + 1 : e;
+	}
+	return 0;
+}
+
+static int contains_ci(const char *hay, const char *needle)
+{
+	size_t n = strlen(needle);
+
+	for (; *hay; hay++)
+		if (strncasecmp(hay, needle, n) == 0)
+			return 1;
+	return 0;
+}
+
+static char *make_label(const char *name, int type)
+{
+	const char *suffix;
+	size_t len;
+	char *label;
+
+	if (type == WDM_SESSION_WAYLAND) {
+		if (contains_ci(name, "wayland"))
+			return xstrdup(name);
+		suffix = " (Wayland)";
+	} else {
+		if (contains_ci(name, "x11") || contains_ci(name, "xorg"))
+			return xstrdup(name);
+		suffix = " (X11)";
+	}
+	len = strlen(name) + strlen(suffix) + 1;
+	label = xrealloc(NULL, len);
+	snprintf(label, len, "%s%s", name, suffix);
+	return label;
+}
+
+/* Parses one .desktop file.  Returns 1 and fills *s when usable. */
+static int read_entry(const char *path, const char *id, int type,
+		      char cand[4][100], int ncand, WDMSession *s)
+{
+	FILE *f;
+	char line[LINE_MAX_LEN];
+	char *names[4] = { NULL, NULL, NULL, NULL };
+	char *name = NULL, *exec = NULL, *tryexec = NULL, *dnames = NULL;
+	int in_group = 0, hidden = 0, ok = 0, i;
+	struct stat st;
+
+	f = fopen(path, "r");
+	if (!f)
+		return 0;
+	if (fstat(fileno(f), &st) != 0 || !S_ISREG(st.st_mode)) {
+		fclose(f);
+		return 0;
+	}
+	while (fgets(line, sizeof(line), f)) {
+		char *key, *val, *eq, *br;
+		size_t l = strlen(line);
+
+		if (l == sizeof(line) - 1 && line[l - 1] != '\n') {
+			int c;	/* overlong line: skip the rest */
+			while ((c = fgetc(f)) != EOF && c != '\n')
+				;
+			continue;
+		}
+		key = trim(line);
+		if (*key == '#' || *key == '\0')
+			continue;
+		if (*key == '[') {
+			in_group = strcmp(key, "[Desktop Entry]") == 0;
+			continue;
+		}
+		if (!in_group)
+			continue;
+		eq = strchr(key, '=');
+		if (!eq)
+			continue;
+		*eq = '\0';
+		val = trim(eq + 1);
+		key = trim(key);
+		br = strchr(key, '[');
+		if (br) {
+			char *end = strchr(br, ']');
+
+			if (strncmp(key, "Name[", 5) != 0 || !end || end[1])
+				continue;
+			*end = '\0';
+			for (i = 0; i < ncand; i++)
+				if (!names[i] && strcmp(br + 1, cand[i]) == 0) {
+					names[i] = xstrdup(val);
+					unescape_string(names[i]);
+				}
+			continue;
+		}
+		if (strcmp(key, "Name") == 0 && !name) {
+			name = xstrdup(val);
+			unescape_string(name);
+		} else if (strcmp(key, "Exec") == 0 && !exec) {
+			exec = xstrdup(val);
+			unescape_string(exec);
+		} else if (strcmp(key, "TryExec") == 0 && !tryexec) {
+			tryexec = xstrdup(val);
+			unescape_string(tryexec);
+		} else if (strcmp(key, "DesktopNames") == 0 && !dnames) {
+			dnames = xstrdup(val);
+		} else if (strcmp(key, "Hidden") == 0 || strcmp(key, "NoDisplay") == 0) {
+			hidden |= parse_bool(val);
+		}
+	}
+	fclose(f);
+
+	if (!hidden && exec && *exec && (!tryexec || !*tryexec || find_in_path(tryexec))) {
+		char **argv = WDMSplitExec(exec);
+
+		if (argv) {
+			WDMFreeArgv(argv);
+			ok = 1;
+		}
+	}
+	if (ok) {
+		const char *shown = NULL;
+
+		for (i = 0; i < ncand && !shown; i++)
+			if (names[i] && *names[i])
+				shown = names[i];
+		if (!shown)
+			shown = (name && *name) ? name : id;
+		s->type = type;
+		s->id = xstrdup(id);
+		s->name = xstrdup(shown);
+		s->label = make_label(shown, type);
+		s->exec = exec;
+		s->desktopNames = dnames;
+		s->path = xstrdup(path);
+		exec = dnames = NULL;
+	}
+	for (i = 0; i < 4; i++)
+		free(names[i]);
+	free(name);
+	free(exec);
+	free(tryexec);
+	free(dnames);
+	return ok;
+}
+
+static int have_session(WDMSessionList *list, int type, const char *id)
+{
+	int i;
+
+	for (i = 0; i < list->count; i++)
+		if (list->items[i].type == type && strcmp(list->items[i].id, id) == 0)
+			return 1;
+	return 0;
+}
+
+static void read_dir(WDMSessionList *list, const char *dir, int type,
+		     char cand[4][100], int ncand)
+{
+	DIR *d;
+	struct dirent *de;
+	char **ids = NULL;
+	int nids = 0, i;
+
+	d = opendir(dir);
+	if (!d)
+		return;
+	while ((de = readdir(d)) != NULL) {
+		size_t l = strlen(de->d_name);
+
+		if (l <= 8 || strcmp(de->d_name + l - 8, ".desktop") != 0)
+			continue;
+		ids = xrealloc(ids, sizeof(char *) * (nids + 1));
+		ids[nids] = xstrdup(de->d_name);
+		ids[nids][l - 8] = '\0';
+		nids++;
+	}
+	closedir(d);
+	for (i = 0; i < nids; i++) {
+		char path[1024];
+		WDMSession s;
+
+		if (WDMValidSessionId(ids[i]) && !have_session(list, type, ids[i])) {
+			snprintf(path, sizeof(path), "%s/%s.desktop", dir, ids[i]);
+			memset(&s, 0, sizeof(s));
+			if (read_entry(path, ids[i], type, cand, ncand, &s)) {
+				list->items = xrealloc(list->items,
+						sizeof(WDMSession) * (list->count + 1));
+				list->items[list->count++] = s;
+			}
+		}
+		free(ids[i]);
+	}
+	free(ids);
+}
+
+static void read_dirs(WDMSessionList *list, const char *dirs, int type,
+		      char cand[4][100], int ncand)
+{
+	char *copy, *p, *tok, *save = NULL;
+
+	if (!dirs || !*dirs)
+		return;
+	copy = xstrdup(dirs);
+	for (p = copy; (tok = strtok_r(p, ":", &save)) != NULL; p = NULL)
+		if (*tok == '/')
+			read_dir(list, tok, type, cand, ncand);
+	free(copy);
+}
+
+static int cmp_session(const void *a, const void *b)
+{
+	const WDMSession *x = a, *y = b;
+	int r = strcasecmp(x->label, y->label);
+
+	if (r)
+		return r;
+	if (x->type != y->type)
+		return x->type - y->type;
+	return strcmp(x->id, y->id);
+}
+
+WDMSessionList *WDMReadSessions(const char *xdirs, const char *wdirs, const char *locale)
+{
+	WDMSessionList *list = xrealloc(NULL, sizeof(WDMSessionList));
+	char cand[4][100];
+	int ncand;
+
+	list->count = 0;
+	list->items = NULL;
+	if (!locale) {
+		locale = getenv("LC_ALL");
+		if (!locale || !*locale)
+			locale = getenv("LC_MESSAGES");
+		if (!locale || !*locale)
+			locale = getenv("LANG");
+	}
+	ncand = locale_candidates(locale, cand);
+	read_dirs(list, xdirs, WDM_SESSION_X11, cand, ncand);
+	read_dirs(list, wdirs, WDM_SESSION_WAYLAND, cand, ncand);
+	if (list->count > 1)
+		qsort(list->items, list->count, sizeof(WDMSession), cmp_session);
+	return list;
+}
+
+void WDMFreeSessions(WDMSessionList *list)
+{
+	int i;
+
+	if (!list)
+		return;
+	for (i = 0; i < list->count; i++) {
+		WDMSession *s = &list->items[i];
+		free(s->id);
+		free(s->name);
+		free(s->label);
+		free(s->exec);
+		free(s->desktopNames);
+		free(s->path);
+	}
+	free(list->items);
+	free(list);
+}
+
+char *WDMSessionKey(const WDMSession *s, char *buf, int size)
+{
+	snprintf(buf, size, "%s/%s", s->type == WDM_SESSION_WAYLAND ? "wayland" : "x11", s->id);
+	return buf;
+}
+
+WDMSession *WDMFindSession(WDMSessionList *list, const char *key)
+{
+	const char *slash, *id;
+	int type = -1, i, found = -1;
+
+	if (!list || !key)
+		return NULL;
+	slash = strchr(key, '/');
+	if (slash) {
+		if ((size_t)(slash - key) == 3 && strncmp(key, "x11", 3) == 0)
+			type = WDM_SESSION_X11;
+		else if ((size_t)(slash - key) == 7 && strncmp(key, "wayland", 7) == 0)
+			type = WDM_SESSION_WAYLAND;
+		else
+			return NULL;
+		id = slash + 1;
+	} else
+		id = key;
+	if (!WDMValidSessionId(id))
+		return NULL;
+	for (i = 0; i < list->count; i++) {
+		if (strcmp(list->items[i].id, id) != 0)
+			continue;
+		if (type >= 0) {
+			if (list->items[i].type == type)
+				return &list->items[i];
+		} else {
+			if (found >= 0)
+				return NULL;	/* ambiguous bare id */
+			found = i;
+		}
+	}
+	return found >= 0 ? &list->items[found] : NULL;
+}
+
+void WDMFreeArgv(char **argv)
+{
+	char **p;
+
+	if (!argv)
+		return;
+	for (p = argv; *p; p++)
+		free(*p);
+	free(argv);
+}
+
+char **WDMSplitExec(const char *exec)
+{
+	char **argv = NULL;
+	int argc = 0;
+	size_t len = strlen(exec);
+	char *buf = xrealloc(NULL, len + 1);
+	const char *p = exec;
+
+	for (;;) {
+		size_t n = 0;
+		int content = 0, quoted = 0;
+
+		while (*p == ' ' || *p == '\t')
+			p++;
+		if (!*p)
+			break;
+		while (*p && (quoted || (*p != ' ' && *p != '\t'))) {
+			if (quoted) {
+				if (*p == '"') {
+					quoted = 0;
+					p++;
+				} else if (*p == '\\' && p[1] && strchr("\"`$\\", p[1])) {
+					buf[n++] = p[1];
+					p += 2;
+				} else
+					buf[n++] = *p++;
+				content = 1;
+			} else if (*p == '"') {
+				quoted = 1;
+				content = 1;
+				p++;
+			} else if (*p == '\\' && p[1]) {
+				buf[n++] = p[1];
+				p += 2;
+				content = 1;
+			} else if (*p == '%' && p[1]) {
+				if (p[1] == '%') {
+					buf[n++] = '%';
+					content = 1;
+				}
+				/* any other field code is dropped */
+				p += 2;
+			} else {
+				buf[n++] = *p++;
+				content = 1;
+			}
+		}
+		if (quoted) {	/* unterminated quote */
+			free(buf);
+			WDMFreeArgv(argv);
+			return NULL;
+		}
+		if (content) {
+			buf[n] = '\0';
+			argv = xrealloc(argv, sizeof(char *) * (argc + 2));
+			argv[argc++] = xstrdup(buf);
+			argv[argc] = NULL;
+		}
+	}
+	free(buf);
+	if (argc == 0 || argv[0][0] == '\0') {
+		WDMFreeArgv(argv);
+		return NULL;
+	}
+	return argv;
+}
+
+int WDMSaveUserSession(const char *statedir, const char *user, const char *key)
+{
+	char path[1024], tmp[1100];
+	int fd, len, ok;
+
+	if (!statedir || !*statedir || !WDMValidUserName(user))
+		return 0;
+	snprintf(path, sizeof(path), "%s/%s", statedir, user);
+	if (!key)	/* forget */
+		return unlink(path) == 0 || errno == ENOENT;
+	if (mkdir(statedir, 0755) != 0 && errno != EEXIST)
+		return 0;
+	snprintf(tmp, sizeof(tmp), "%s.tmp", path);
+	unlink(tmp);
+	fd = open(tmp, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0644);
+	if (fd < 0)
+		return 0;
+	len = strlen(key);
+	ok = write(fd, key, len) == len && write(fd, "\n", 1) == 1;
+	ok = (close(fd) == 0) && ok;
+	if (!ok || rename(tmp, path) != 0) {
+		unlink(tmp);
+		return 0;
+	}
+	return 1;
+}
+
+char *WDMLoadUserSession(const char *statedir, const char *user)
+{
+	char path[1024], buf[256];
+	int fd;
+	ssize_t n;
+
+	if (!statedir || !*statedir || !WDMValidUserName(user))
+		return NULL;
+	snprintf(path, sizeof(path), "%s/%s", statedir, user);
+	fd = open(path, O_RDONLY | O_NOFOLLOW | O_CLOEXEC);
+	if (fd < 0)
+		return NULL;
+	n = read(fd, buf, sizeof(buf) - 1);
+	close(fd);
+	if (n <= 0)
+		return NULL;
+	buf[n] = '\0';
+	buf[strcspn(buf, "\r\n")] = '\0';
+	return *buf ? xstrdup(buf) : NULL;
+}
