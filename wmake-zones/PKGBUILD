# Maintainer: Big WindowMaker <https://github.com/big-windowmaker>
#
# wmake-zones: zonas de encaixe e mosaico automático de janelas para o
# Big WindowMaker, com o visual NeXTSTEP do tema do Window Maker.
#
#   wmake-zones        serviço da sessão X11 (Window Maker) e dockapp do
#                      Dock/Clip; também é o cliente dos comandos nas duas
#                      sessões (status, zones, layout, snap, windows -l...)
#   wmake-zones-prefs  preferências e editor visual de zonas (GTK 3), só
#                      enquanto abertos
#   wmake-zones-wl     dockapp nativo do wlmaker, sem XWayland
#   libwmake-zones-engine.a
#                      núcleo de geometria, mosaico e configuração; o
#                      wlmaker liga nele (patches 0104-0120 do pacote
#                      wlmaker) para ter as mesmas zonas no Wayland
#
# Zonas ligadas por padrão (desde a 0.3), mosaico desligado: as janelas
# flutuam como no Window Maker e só mudam de lugar quando o usuário as
# solta numa zona. Quem desligou continua desligado. Em repouso o serviço
# não acorda (nenhum timer) e ocupa menos de 3 MiB.
#
# WMAKE_ZONES_SOURCE troca a fonte (ex.: git+file:///caminho/wmake-zones
# para compilar um clone local antes do push).
pkgname=wmake-zones
pkgver=0.3.1
pkgrel=1
pkgdesc='Window zones and automatic tiling for Window Maker and wlmaker, with the NeXTSTEP look'
arch=(x86_64)
url='https://github.com/big-windowmaker/wmake-zones'
license=('GPL-2.0-or-later')
depends=(
  cairo
  fontconfig  # nomes de fonte do tema (FcFini na saída)
  glib2       # preferências (GTK 3)
  glibc
  gtk3        # preferências e editor de zonas (só quando abertos)
  hicolor-icon-theme
  libx11
  libxext     # XShape: overlay que não pega o ponteiro
  libxft      # textos do overlay e do dockapp com as fontes do tema
  libxi       # XInput 2.1: eventos brutos do botão durante o arrasto
  libxrandr   # monitores (XRandR 1.5)
  libxrender  # overlay translúcido com um compositor
  wayland     # dockapp nativo do wlmaker
)
makedepends=(
  git
  librsvg           # ícones PNG para o Dock do Window Maker
  meson
  wayland-protocols
)
checkdepends=(
  appstream          # valida os metadados (sem rede)
  imagemagick        # import: captura do ladrilho do dockapp
  python             # cliente "mudo" do teste do socket
  python-gobject     # janelas GTK de teste (vários monitores)
  python-pillow      # o modo na tela do dockapp, conferido pelos pixels
  python-xlib        # confere que o seletor e o menu do dockapp largam o teclado
  windowmaker        # o teste funcional roda o wmaker de verdade num Xvfb
  xdotool
  xorg-server-xephyr # dois monitores (Xinerama) dentro do Xvfb
  xorg-server-xvfb
  xorg-xprop
  xorg-xwininfo      # acha o ladrilho do dockapp e os quadros
  xterm
)
optdepends=(
  'windowmaker: zonas e mosaico na sessão X11'
  'wlmaker: zonas e mosaico na sessão Wayland (wlmaker do Big WindowMaker, patches 0104-0120)'
  'picom: zonas translúcidas (sem compositor, contornos com o destino em listras)'
)
# O núcleo estático (libwmake-zones-engine.a) é usado pelo wlmaker. Sem LTO:
# com lto (padrão do makepkg.conf do Manjaro) os objetos são "slim", só
# bytecode do GCC, e o strip os deixa vazios: o wlmaker não ligava no CI.
options=(staticlibs !lto)
source=("wmake-zones::${WMAKE_ZONES_SOURCE:-git+$url.git#tag=v$pkgver}"
        # Só teste, depois da tag (já no main): o teste do dockapp espera o
        # ladrilho aparecer em vez de 1 s fixo e pula sem o xwininfo.
        0001-tests-dockapp-waits-for-the-tile.patch)
sha256sums=('SKIP'
            '753de49341466478952bffc37c44286f3208f6fc5f7df1091ba7dcab065c86ea')

prepare() {
  # A versão do PKGBUILD precisa ser a do projeto (meson.build).
  local v
  v=$(sed -n "s/^  version: '\(.*\)',$/\1/p" wmake-zones/meson.build)
  if [[ ${v} != "${pkgver}" ]]; then
    echo "meson.build diz ${v}, mas pkgver=${pkgver}" >&2
    return 1
  fi
  # Sem o WMAKE_ZONES_SOURCE (fonte local do main), o patch de teste da tag.
  if ! grep -q 'Numa máquina lenta (CI)' wmake-zones/tests/x11-dockapp.sh; then
    patch -d wmake-zones -Np1 -i "${srcdir}/0001-tests-dockapp-waits-for-the-tile.patch"
  fi
}

build() {
  arch-meson wmake-zones build
  meson compile -C build
}

check() {
  # Núcleo (925 mil verificações), metadados e o teste funcional do X11,
  # que roda num Xvfb próprio com o wmaker; sem as ferramentas ele sai
  # como "skip".
  # A saída TAP (qual verificação falhou) fica no testlog.txt.
  meson test -C build --print-errorlogs || {
    cat build/meson-logs/testlog.txt
    return 1
  }
}

package() {
  meson install -C build --destdir "$pkgdir"
  install -Dm644 wmake-zones/README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  cp -r wmake-zones/docs "$pkgdir/usr/share/doc/$pkgname/"
  rm -rf "$pkgdir/usr/share/doc/$pkgname/docs/screenshots"
}
