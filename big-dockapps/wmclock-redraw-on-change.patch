 		  redrawWindow(&visible);
@@ -1004,6 +1007,7 @@ int main(int argc, char **argv)
 			  COLON_X_OFFSET, COLON_Y_OFFSET,
 			  COLON_WIDTH, COLON_HEIGHT,
 			  xPos[COLON_X_POS], yPos[COLON_Y_POS]);
+		changed = 1;
