@@ -202,6 +202,30 @@
 }
 
 
+/*
+ * The text exactly as the application gave it (UTF8_STRING): no line end
+ * normalization (gtk_clipboard_request_text makes CRLF into LF). Without
+ * valid UTF-8, the usual conversion.
+ */
+static void
+utf8_received(GtkClipboard *cb, GtkSelectionData *data, gpointer user)
+{
+	const guchar	*raw = gtk_selection_data_get_data(data);
+	gint		len = gtk_selection_data_get_length(data);
+	gchar		*text;
+
+	(void) user;
+	if (raw == NULL || len <= 0 || !g_utf8_validate((const gchar *) raw, len, NULL) ||
+	    memchr(raw, '\0', (size_t) len) != NULL) {
+		gtk_clipboard_request_text(cb, my_get_selection_text, NULL);
+		return;
+	}
+	text = g_strndup((const gchar *) raw, (gsize) len);
+	my_get_selection_text(cb, text, NULL);
+	g_free(text);
+}
+
