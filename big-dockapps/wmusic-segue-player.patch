+/* Status of a player without keeping it: used to find the one that is
+ * actually playing. */
+static PlayerctlPlaybackStatus PlayerStatus(PlayerctlPlayerName *name)
+{
+	GError *error = NULL;
+	PlayerctlPlayer *p;
+	PlayerctlPlaybackStatus status = PLAYERCTL_PLAYBACK_STATUS_STOPPED;
+
+	p = playerctl_player_new_from_name(name, &error);
+	if (error == NULL && p)
+		g_object_get(p, "playback-status", &status, NULL);
+	if (p)
+		g_object_unref(p);
+	g_clear_error(&error);
+	return status;
+}
+
+/* The player to follow: the one playing, else a paused one, else the
+ * first. Browsers and players left open but idle (Firefox, a stopped
+ * video player) register with MPRIS too and used to hide the player that
+ * was really playing, because the first one in the list always won. */
+static PlayerctlPlayerName *BestPlayer(GList *players)
+{
+	PlayerctlPlayerName *paused = NULL;
+	GList *l;
+
+	for (l = players; l; l = l->next) {
+		PlayerctlPlaybackStatus status = PlayerStatus(l->data);
+
+		if (status == PLAYERCTL_PLAYBACK_STATUS_PLAYING)
+			return l->data;
+		if (status == PLAYERCTL_PLAYBACK_STATUS_PAUSED && !paused)
+			paused = l->data;
+	}
+	return paused ? paused : (players ? players->data : NULL);
+}
