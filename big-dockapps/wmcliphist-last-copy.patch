 /* content wmcliphist itself published: not a new copy when it comes back */
 static gchar	*published = NULL;
 
+/*
+ * The last copy: what the user copied last (or chose from the history),
+ * NULL when that was not text (an image, files only) or was a secret. Only
+ * this is published again when the application that copied goes away;
+ * never "the first item of the history" (favorites and reloads reorder it).
+ */
+static gchar	*last_copy = NULL;
+
+static void
+remember_last(const gchar *content)
+{
+	gchar	*copy = content != NULL ? g_strdup(content) : NULL;
+
+	g_free(last_copy);
+	last_copy = copy;
+}
+
+/*
+ * The owner went away (the application that copied was closed): publish
+ * the last copy again so that it can still be pasted. Only on X11: on
+ * XWayland the owner is the compositor's bridge, and the session's
+ * clipboard is kept by big-wm-clipboard on the Wayland side.
+ */
+static void
+take_up_last_copy(void)
+{
+	if (auto_take_up && last_copy != NULL && !bigwm_wayland())
+		clipboard_publish(last_copy);
+}
