+char		configfile[EXTRALONG_STRING];
 
 
 
+// run a command through the shell without blocking; GLib reaps the child
+static void run_command(const char *cmd)
+{
+	gchar *argv[] = { "/bin/sh", "-c", (gchar *) cmd, NULL };
+	GError *error = NULL;
+
+	if (!cmd || !*cmd)
+		return;
+	if (!g_spawn_async(NULL, argv, NULL, G_SPAWN_DEFAULT, NULL, NULL, NULL, &error)){
+		fprintf(stderr, "error launching command \"%s\": %s\n", cmd, error->message);
+		g_error_free(error);
+	}
+}
+
+// icon = absolute path, a file name in __CONFPATH, or an icon theme name
+static GtkWidget *load_icon(const char *icon)
+{
+	GdkPixbuf *pixbuf = NULL;
+	GtkWidget *image;
+	char path[EXTRALONG_STRING];
+
+	if (icon[0] == '/'){
+		pixbuf = gdk_pixbuf_new_from_file_at_size(icon, 24, 24, NULL);
+	}else if (strchr(icon, '.')){
+		snprintf(path, sizeof(path), "%s/%s", __CONFPATH, icon);
+		pixbuf = gdk_pixbuf_new_from_file_at_size(path, 24, 24, NULL);
+	}else if (icon[0]){
+		pixbuf = gtk_icon_theme_load_icon(gtk_icon_theme_get_default(),
+				icon, 24, GTK_ICON_LOOKUP_FORCE_SIZE, NULL);
+	}
+	if (!pixbuf)
+		pixbuf = gtk_icon_theme_load_icon(gtk_icon_theme_get_default(),
+				"image-missing", 24, GTK_ICON_LOOKUP_FORCE_SIZE, NULL);
+
+	image = gtk_image_new_from_pixbuf(pixbuf);
+	if (pixbuf)
+		g_object_unref(pixbuf);
+	return image;
+}
