From e02823cf559a939965e87044fb3986c45de01ee4 Mon Sep 17 00:00:00 2001
From: ruscher <rruscher@gmail.com>
Date: Sun, 1 Nov 2026 19:06:04 -0300
Subject: [PATCH] wmcliphist: CLIPBOARD that pastes, UTF-8, owner changes
 instead of polling
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- The history is read from the owner-change signal of GTK (XFixes)
  instead of asking for the selection every 250 ms; the old polling stays
  only for displays without XFixes.
- Text is read and published as UTF-8 with every text target
  (gtk_clipboard_set_text: UTF8_STRING, STRING, TEXT,
  text/plain;charset=utf-8...). wmcliphist asked for STRING only, so it
  never saw what Qt applications copied, and served STRING only, so
  "ação" was pasted as "aÃ§Ã£o".
- Choosing an item publishes it as the content of the selection: with
  "clipboard CLIPBOARD", Ctrl+V pastes exactly the chosen item.
- auto_take_up publishes the last item again only when the application
  that copied goes away (no owner, or an owner with no content, which is
  what Qt leaves when it quits), so a rich copy (an image, HTML) is not
  replaced by plain text while it can still be pasted. "auto_take_up
  yes" was ignored: only "no" was read.
- Privacy: contents marked by password managers
  (x-kde-passwordManagerHint, KeePassXC) are not recorded, contents over
  256 KiB are not kept, and "persist no" keeps the history in memory only.
---
 wmcliphist/clipboard.c  | 131 +++++++++++++++++++++++++++++++++++++---
 wmcliphist/history.c    |  27 +++++----
 wmcliphist/rcconfig.c   |  10 ++-
 wmcliphist/wmcliphist.c |  20 ++----
 wmcliphist/wmcliphist.h |   5 ++
 5 files changed, 154 insertions(+), 39 deletions(-)

diff --git a/wmcliphist/clipboard.c b/wmcliphist/clipboard.c
index 9b1b6ed..09c711c 100644
--- a/wmcliphist/clipboard.c
+++ b/wmcliphist/clipboard.c
@@ -4,6 +4,15 @@
 /* when true, clipboard will be automatically taken up by wmcliphist */
 gint	auto_take_up = 0;
 
+/* "persist no" in ~/.wmcliphistrc: history is never written to disk */
+gint	persist_history = 1;
+
+/* larger contents are not kept (a dump of a file, an image as text) */
+#define MAX_ITEM_BYTES	(256 * 1024)
+
+/* content wmcliphist itself published: not a new copy when it comes back */
+static gchar	*published = NULL;
+
 /* number of items to keep (may be overriden from command line) */
 gint	num_items_to_keep = 10;
 
@@ -62,6 +71,17 @@ my_get_selection_text(GtkClipboard *cb, const gchar *text, gpointer
 	if (text == NULL) {
 		return_void();
 	}
+	if (strlen(text) > MAX_ITEM_BYTES) {
+		return_void();
+	}
+	if (published != NULL && strcmp(text, published) == 0) {
+		/* our own item coming back: already in the history */
+		if (has_old_content > 0)
+			g_free(old_content);
+		old_content = g_strdup(text);
+		has_old_content = 1;
+		return_void();
+	}
 
 	if (g_utf8_collate(text, old_content) != 0 &&
 	    !gtk_check_menu_item_get_active(GTK_CHECK_MENU_ITEM(menu_app_clip_ignore))) {
@@ -82,13 +102,11 @@ my_get_selection_text(GtkClipboard *cb, const gchar *text, gpointer
 		process_item(content, 0, TRUE);
 	}
 
-	/* when clipboard is locked, set selection owener to myself */
-	if (gtk_check_menu_item_get_active(GTK_CHECK_MENU_ITEM(menu_app_clip_ignore)) ||
-	    gtk_check_menu_item_get_active(GTK_CHECK_MENU_ITEM(menu_app_clip_lock))) {
-		if (gtk_selection_owner_set(dock_app,
-					clipboard,
-					GDK_CURRENT_TIME) == 0)
-			selected = NULL;
+	/* when clipboard is locked, give the selected item back */
+	if ((gtk_check_menu_item_get_active(GTK_CHECK_MENU_ITEM(menu_app_clip_ignore)) ||
+	     gtk_check_menu_item_get_active(GTK_CHECK_MENU_ITEM(menu_app_clip_lock))) &&
+	    selected != NULL) {
+		clipboard_publish(selected->content);
 	}
 
 	return_void();
@@ -162,3 +180,102 @@ selection_handle(GtkWidget *widget,
 
 	return_val(TRUE);
 }
+
+
+/*
+ * Publishes content as the selection (UTF-8 text: UTF8_STRING, STRING,
+ * TEXT, text/plain;charset=utf-8...), the way any GTK application copies.
+ * Used when an item is chosen from the history and to keep the last copy
+ * when the application that owned it goes away.
+ */
+void
+clipboard_publish(const gchar *content)
+{
+	if (content == NULL)
+		return;
+	g_free(published);
+	published = g_strdup(content);
+	gtk_clipboard_set_text(gtk_clipboard_get(clipboard), content, -1);
+}
+
+
+/* password managers (KeePassXC) mark secrets with this target */
+static void
+targets_received(GtkClipboard *cb, GdkAtom *atoms, gint n_atoms, gpointer data)
+{
+	gint	i;
+
+	gint	content = 0;
+
+	(void) data;
+	for (i = 0; i < n_atoms; i++) {
+		gchar	*name = gdk_atom_name(atoms[i]);
+		gboolean secret = name != NULL &&
+			strcmp(name, "x-kde-passwordManagerHint") == 0;
+
+		if (name != NULL && strcmp(name, "TARGETS") != 0 &&
+		    strcmp(name, "TIMESTAMP") != 0 && strcmp(name, "MULTIPLE") != 0 &&
+		    strcmp(name, "SAVE_TARGETS") != 0 && strcmp(name, "DELETE") != 0)
+			content++;
+		g_free(name);
+		if (secret)
+			return;
+	}
+	if (content == 0) {
+		/* An owner with nothing to give: what is left when the
+		 * application that copied quits (Qt keeps a placeholder). Same
+		 * as no owner at all. A copy of something else (an image) has
+		 * content targets and is left alone. */
+		if (auto_take_up && history_items != NULL)
+			clipboard_publish(((HISTORY_ITEM *)
+				g_list_first(history_items)->data)->content);
+		return;
+	}
+	gtk_clipboard_request_text(cb, my_get_selection_text, NULL);
+}
+
+
+/*
+ * The owner of the selection changed (XFixes, no polling): read the new
+ * content, or, when the owner went away (the application was closed) and
+ * auto_take_up is on, publish the last item again so it can still be
+ * pasted.
+ */
+static void
+owner_changed(GtkClipboard *cb, GdkEventOwnerChange *event, gpointer data)
+{
+	(void) data;
+	if (event->owner == NULL || event->reason != GDK_OWNER_CHANGE_NEW_OWNER) {
+		if (auto_take_up && history_items != NULL)
+			clipboard_publish(((HISTORY_ITEM *)
+				g_list_first(history_items)->data)->content);
+		return;
+	}
+	gtk_clipboard_request_targets(cb, targets_received, NULL);
+}
+
+
+static gboolean
+poll_selection(gpointer data)
+{
+	(void) data;
+	gtk_clipboard_request_text(gtk_clipboard_get(clipboard),
+			my_get_selection_text, NULL);
+	return TRUE;
+}
+
+
+void
+clipboard_monitor_init(void)
+{
+	GtkClipboard	*cb = gtk_clipboard_get(clipboard);
+
+	if (gdk_display_supports_selection_notification(gdk_display_get_default())) {
+		g_signal_connect(cb, "owner-change", G_CALLBACK(owner_changed), NULL);
+		/* what was already there when wmcliphist started */
+		gtk_clipboard_request_text(cb, my_get_selection_text, NULL);
+	} else {
+		/* no XFixes: read it a few times a second, as before */
+		g_timeout_add(250, poll_selection, NULL);
+	}
+}
diff --git a/wmcliphist/history.c b/wmcliphist/history.c
index 0f3f078..0af33e1 100644
--- a/wmcliphist/history.c
+++ b/wmcliphist/history.c
@@ -47,15 +47,10 @@ process_item(char *content, gint locked, gboolean exec)
 			hist_item = menu_item_add(content, locked,
 					action->submenu);
 
-			/* when auto_take_up is true, set selection owner to myself */
-			if (auto_take_up == 1) {
-				selected = hist_item;
-				if (gtk_selection_owner_set(dock_app,
-							clipboard,
-							GDK_CURRENT_TIME) == 0) {
-					selected = NULL;
-				}
-			}
+			/* auto_take_up: the item is published again only when
+			 * its owner goes away (clipboard.c), so a rich copy
+			 * (image, HTML) is not replaced by plain text */
+			selected = hist_item;
 
 			dump_history_list("added item");
 			break;
@@ -98,10 +93,9 @@ move_item_to_begin(HISTORY_ITEM *item) {
 	history_items = g_list_remove_link(history_items, list_node);
 	history_items = g_list_concat(list_node, history_items);
 	selected = item;
-	if (gtk_selection_owner_set(dock_app,
-				clipboard,
-				GDK_CURRENT_TIME) == 0)
-		selected = NULL;
+	/* the chosen item becomes the content of the selection (CLIPBOARD:
+	 * Ctrl+V pastes it), as UTF-8 text with every text target */
+	clipboard_publish(item->content);
 }
 
 
@@ -189,6 +183,9 @@ history_load(gboolean dump_only)
 
 	begin_func("history_load");
 
+	if (!persist_history)
+		return_val(0);	/* "persist no": nothing read from disk */
+
 	fname = rcconfig_get_name(".data");
 	if (!(f = fopen(fname, "r"))) {
 		errno = E_OPEN;
@@ -268,6 +265,7 @@ history_load(gboolean dump_only)
 int
 history_save()
 {
+
 	char		*fname;
 	gint		version = VERSION;
 	FILE		*f;
@@ -277,6 +275,9 @@ history_save()
 
 	begin_func("history_save");
 
+	if (!persist_history)
+		return_val(0);	/* "persist no": history only in memory */
+
 	fname = g_strdup(rcconfig_get_name(".data.tmp"));
 
 	if (!(f = fopen(fname, "w"))) {
diff --git a/wmcliphist/rcconfig.c b/wmcliphist/rcconfig.c
index 153295c..f7ce8d1 100644
--- a/wmcliphist/rcconfig.c
+++ b/wmcliphist/rcconfig.c
@@ -200,6 +200,9 @@ rcconfig_get(char *fname)
 					} else if (strcmp(direc_buf, "auto_take_up") == 0) {
 						state = STATE_VALUE;
 						buf_index = 0;
+					} else if (strcmp(direc_buf, "persist") == 0) {
+						state = STATE_VALUE;
+						buf_index = 0;
 					} else {
 						error = 8;
 					}
@@ -258,9 +261,10 @@ rcconfig_get(char *fname)
 							exec_hotkey = 0;
 						}
 					} else if (strcmp(direc_buf, "auto_take_up") == 0) {
-						if (strcasecmp(expr_buf, "no") == 0) {
-							auto_take_up = 0;
-						}
+						/* "yes" was ignored: only "no" was read */
+						auto_take_up = strcasecmp(expr_buf, "no") != 0;
+					} else if (strcmp(direc_buf, "persist") == 0) {
+						persist_history = strcasecmp(expr_buf, "no") != 0;
 					} else
 						error = 1;
 				} else if (isgraph(c))
diff --git a/wmcliphist/wmcliphist.c b/wmcliphist/wmcliphist.c
index 5e06e1d..b33795c 100644
--- a/wmcliphist/wmcliphist.c
+++ b/wmcliphist/wmcliphist.c
@@ -372,12 +372,8 @@ main(int argc, char **argv)
 	}
 
 
-	/* run clipboard monitor */
-	g_signal_connect(G_OBJECT(main_window),
-			"selection_received",
-			G_CALLBACK(my_get_xselection),
-			NULL);
-	g_timeout_add(250, time_conv_select, NULL);
+	/* run clipboard monitor (XFixes owner changes; UTF-8 text) */
+	clipboard_monitor_init();
 
 
 	/* run autosave timer */
@@ -385,16 +381,8 @@ main(int argc, char **argv)
 		g_timeout_add(autosave_period * 1000, history_autosave, NULL);
 
 
-	/* setup everything for supplying selection to other apps */
-	gtk_selection_add_target(dock_app,
-			clipboard,
-			GDK_SELECTION_TYPE_STRING,
-			1);
-
-	g_signal_connect(G_OBJECT(dock_app),
-			"selection_get",
-			G_CALLBACK(selection_handle),
-			NULL);
+	/* the selection is supplied through gtk_clipboard_set_text()
+	 * (clipboard_publish), with every text target, not only STRING */
 
 	/* connect signal for menu popup */
 	g_signal_connect(G_OBJECT(dock_app),
diff --git a/wmcliphist/wmcliphist.h b/wmcliphist/wmcliphist.h
index 684d250..82ca885 100644
--- a/wmcliphist/wmcliphist.h
+++ b/wmcliphist/wmcliphist.h
@@ -51,6 +51,11 @@ extern gint		num_items_to_keep;
 
 /* when true, clipboard will be automatically taken up by wmcliphist */
 extern gint		auto_take_up;
+extern gint		persist_history;
+void
+clipboard_monitor_init(void);
+void
+clipboard_publish(const gchar *content);
 
 /* number of items kept */
 extern gint		num_items;
