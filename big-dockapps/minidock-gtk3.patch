+/* GTK3 dockapp window, based on wmpasman by Brad Jorsch (as used by
+ * wmshutdown): GDK rewrites WM_HINTS when the window is mapped, so the
+ * icon window hint is set while the main window is reparented away from
+ * the root window. */
+static GtkWidget *create_dock_icon_window(GtkWidget *mw, int size)
+{
+	GdkDisplay *display = gdk_display_get_default();
+	GtkWidget *iconwin = gtk_window_new(GTK_WINDOW_POPUP);
+	Display *d;
+	Window mainwin, iw, w, p, dummy1, *dummy2;
+	unsigned int dummy3;
+	XWMHints *wm_hints;
+
+	gtk_window_set_wmclass(GTK_WINDOW(mw), g_get_prgname(), "DockApp");
+	gtk_widget_set_size_request(iconwin, size, size);
+	gtk_widget_realize(mw);
+	gtk_widget_realize(iconwin);
+
+	d = GDK_DISPLAY_XDISPLAY(display);
+	mainwin = GDK_WINDOW_XID(gtk_widget_get_window(mw));
+	iw = GDK_WINDOW_XID(gtk_widget_get_window(iconwin));
+	XQueryTree(d, mainwin, &dummy1, &p, &dummy2, &dummy3);
+	if (dummy2)
+		XFree(dummy2);
+	w = XCreateSimpleWindow(d, p, 0, 0, 1, 1, 0, 0, 0);
+	XReparentWindow(d, mainwin, w, 0, 0);
+	gtk_widget_show(mw);
+	gtk_widget_show(iconwin);
+	wm_hints = XGetWMHints(d, mainwin);
+	if (!wm_hints)
+		wm_hints = XAllocWMHints();
+	wm_hints->flags |= IconWindowHint;
+	wm_hints->icon_window = iw;
+	XSetWMHints(d, mainwin, wm_hints);
+	XFree(wm_hints);
+	XReparentWindow(d, mainwin, p, 0, 0);
+	XDestroyWindow(d, w);
+
+	return iconwin;
+}
+
+/* icon = absolute path to an image file, or a name from the icon theme */
+static void set_icon(struct minidock *data)
+{
+	GtkIconTheme *icon_theme = gtk_icon_theme_get_default();
+	GdkPixbuf *pixbuf = NULL;
+
+	if (data->icon[0] == '/')
+		pixbuf = gdk_pixbuf_new_from_file_at_size(data->icon, 24, 24, NULL);
+	else if (data->icon[0])
+		pixbuf = gtk_icon_theme_load_icon(icon_theme, data->icon, 24,
+				GTK_ICON_LOOKUP_FORCE_SIZE, NULL);
+	if (!pixbuf)
+		pixbuf = gtk_icon_theme_load_icon(icon_theme, "image-missing", 24,
+				GTK_ICON_LOOKUP_FORCE_SIZE, NULL);
+
+	gtk_image_set_from_pixbuf(GTK_IMAGE(data->image), pixbuf);
+	if (pixbuf)
+		g_object_unref(pixbuf);
+}
