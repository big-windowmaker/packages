package_minidock() {
  pkgdesc='Window Maker dockapp with 4 configurable launcher buttons'
  url="${_zenwalk}/"
  license=('GPL-2.0-only')
  depends=(gdk-pixbuf2 glib2 glibc gtk3 libx11)
  optdepends=('big-wm-session: comandos padrão (big-wm-open)')
  backup=(etc/minidock/default.cf)

  cd "minidock-${_minidock_ver}"
  make DESTDIR="${pkgdir}" install
  # Comandos e ícones padrão do Big WindowMaker. Cada usuário recebe uma
  # cópia em ~/.minidock.cf na primeira execução.
  install -Dm644 "${srcdir}/minidock.cf" "${pkgdir}/etc/minidock/default.cf"
}

package_minicontrol() {
  pkgdesc='Window Maker dockapp with a clock, a WPrefs button and a shutdown button'
  url="${_zenwalk}/"
  license=('GPL-2.0-only')
  depends=(gdk-pixbuf2 glib2 glibc gtk3 libx11)
  optdepends=('windowmaker: WPrefs')

  cd minicontrol
  make DESTDIR="${pkgdir}" install
  # WPrefs no PATH e desligar/reiniciar via logind (systemctl), sem root.
  install -Dm644 "${srcdir}/minicontrol.cf" "${pkgdir}/usr/share/minicontrol/minicontrol.cf"
  install -Dm644 -t "${pkgdir}/usr/share/doc/minicontrol" README
}

package_wmapmload() {
  pkgdesc='Window Maker dockapp to monitor the battery (reads /sys/class/power_supply)'
  url='http://tnemeth.free.fr/projets/dockapps.html'
  license=('GPL-2.0-or-later')
  depends=(glibc libx11 libxext libxpm)

  cd "wmapmload-${_wmapmload_ver}"
  make DESTDIR="${pkgdir}" install
}

package_mountapp() {
  pkgdesc='Window Maker dockapp to mount and unmount the user mount points of /etc/fstab'
  url='https://sourceforge.net/projects/mountapp/'
  license=('GPL-2.0-or-later')
  # O configurador gráfico (mount.conf) era GTK 1.2 e não é compilado; a
  # configuração fica em ~/GNUstep/Defaults/mount.app. Usa mount/umount/eject
  # do util-linux (grupo base).
  depends=(glibc libx11 libxext libxpm windowmaker)
  optdepends=(
    'xorg-fonts-75dpi: fonte Helvetica original do mostrador (sem ela usa "fixed")'
    'xorg-xmessage: mensagens explicativas quando a montagem falha'
  )

  cd "mountapp-${_mountapp_ver}"
  make DESTDIR="${pkgdir}" install
  install -Dm644 -t "${pkgdir}/usr/share/doc/mountapp" README README.smb
}
