# Maintainer: Big WindowMaker <https://github.com/big-windowmaker>
# Partes baseadas nos PKGBUILDs do AUR de cada dockapp.

# Pacote "split" que compila, de uma vez, os dockapps do conjunto curado do Big
# WindowMaker que não existem nos repositórios Manjaro/BigLinux (relatório
# analysis/02-x11-wmaker-dockapps.md, seção 4.4). Os nomes dos pacotes são os
# mesmos do AUR.
#
# Fontes:
#   - git window-maker/dockapps fixado em _commit: libdockapp, wmcpuload,
#     wmbattery, wmusic, wmshutdown, wmmoonclock, wmcube, wmnet, wmclock,
#     wmmemload, pclock e wmwifi;
#   - wmudmount e wmsystemtray não estão no repositório dockapps: usam os
#     tarballs oficiais das releases no SourceForge, com checksum;
#   - minidock e minicontrol (Jean-Philippe Guillemin, Zenwalk), wmapmload
#     (Thomas Nemeth) e mountapp (Steve Borho, SourceForge): tarballs das
#     últimas releases, sem manutenção upstream. Os patches deste diretório
#     os adaptam ao GCC 15+, ao GTK 3 e ao sysfs (ver o cabeçalho de cada um).
#
# Versão: o makepkg não permite pkgver diferente por pacote num split, então
# todos usam a data do commit fixado (AAAAMMDD), que é maior que as versões do
# AUR. Versões upstream incluídas neste snapshot:
#   libdockapp 0.7.3, wmcpuload 1.1.1, wmbattery 2.56, wmusic 2.1.1,
#   wmshutdown 1.6, wmmoonclock 1.30, wmcube 1.0.2, wmudmount 3.0,
#   wmnet 1.7, wmclock 1.0.16, wmmemload 0.1.8, wmsystemtray 1.4,
#   pclock 0.13.1, wmwifi 0.6, minidock 1.9, minicontrol 0.2,
#   wmapmload 0.3.4, mountapp 3.0.
# Se algum dockapp sair deste split no futuro, o pacote separado vai precisar
# de epoch=1 para não "voltar" de versão.
#
# Para atualizar: troque _commit e pkgver (data do commit) e regenere os
# checksums com ci/update-sums.sh (ver README).
pkgbase=big-dockapps
pkgname=(
  libdockapp
  wmcpuload
  wmbattery
  wmusic
  wmshutdown
  wmmoonclock
  wmcube
  wmudmount
  wmnet
  wmclock
  wmmemload
  wmsystemtray
  pclock
  wmwifi
  minidock
  minicontrol
  wmapmload
  mountapp
)
_commit=251e851a9d59d8bd0263ba1eebe08196f98f6d0b
_wmudmount_ver=3.0
_wmsystemtray_ver=1.4
_minidock_ver=1.9
_minicontrol_ver=0.2
_wmapmload_ver=0.3.4
_mountapp_ver=3.0
# "x86_64" aqui é só o nome do diretório no servidor da Zenwalk (os tarballs
# são código-fonte); o namcap avisa por causa dele.
_zenwalk=https://download.zenwalk.org/x86_64/people/jp/dockapps
pkgver=20260412
pkgrel=2
pkgdesc='Curated Window Maker dockapps for Big WindowMaker'
arch=(x86_64)
url='https://www.dockapps.net/'
license=('GPL-2.0-or-later')
makedepends=(
  # comuns (num split, o namcap exige que as depends de todos os pacotes
  # também estejam em makedepends)
  cairo
  git
  hicolor-icon-theme
  libx11
  libxext
  libxpm
  # libdockapp (macros m4 do X.Org e mkfontdir exigidos pelo configure)
  xorg-font-util
  xorg-mkfontscale
  # wmnet e wmsystemtray (fontes bitmap)
  xorg-fonts-misc
  # wmsystemtray
  libxfixes
  libxmu
  # wmbattery
  upower
  # wmusic
  gdk-pixbuf2
  playerctl
  # wmshutdown, wmudmount, minidock e minicontrol
  glib2
  gtk3
  # wmudmount
  gcr
  libnotify
  libsecret
  udisks2
  # mountapp (libWUtil)
  windowmaker
)
source=(
  "dockapps::git+https://github.com/window-maker/dockapps.git#commit=${_commit}"
  "https://downloads.sourceforge.net/project/wmudmount/wmudmount/wmudmount-${_wmudmount_ver}.tar.gz"
  "https://downloads.sourceforge.net/wmsystemtray/wmsystemtray-${_wmsystemtray_ver}.tar.gz"
  "${_zenwalk}/minidock-${_minidock_ver}.tar.gz"
  "${_zenwalk}/minicontrol-${_minicontrol_ver}.tar.gz"
  # Sem HTTPS no servidor do autor; a integridade vem do sha256.
  "http://tnemeth.free.fr/projets/programmes/wmapmload-${_wmapmload_ver}.tar.gz"
  "https://downloads.sourceforge.net/project/mountapp/mountapp/${_mountapp_ver}/mountapp-${_mountapp_ver}.tar.gz"
  wmwifi-no-interface.patch
  wmapmload-sysfs.patch
  mountapp-modern-build.patch
  minidock-gtk3.patch
  minicontrol-gtk3.patch
  minidock.cf
  minicontrol.cf
)
