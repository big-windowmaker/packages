package_pclock() {
  pkgdesc='Window Maker dockapp showing a simple analog clock'
  url='https://www.dockapps.net/pclock'
  license=('GPL-2.0-or-later')
  depends=(glibc libx11 libxext libxpm)

  cd dockapps/pclock
  install -Dm755 src/pclock "${pkgdir}/usr/bin/pclock"
  # Mostradores alternativos: pclock -B /usr/share/pclock/<nome>.xpm
  install -Dm644 -t "${pkgdir}/usr/share/pclock" XPM/*.xpm
  install -Dm644 -t "${pkgdir}/usr/share/doc/pclock" CHANGES CREDITS README TODO
}

