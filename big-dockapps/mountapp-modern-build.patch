mountapp: compila o mount.app com GCC 15+ e a libWUtil atual

- não compila o mount.conf (configurador em GTK 1.2, que não existe mais);
- procura WMGetFromPLString na libWUtil e não faz "read" interativo;
- bool vem de <stdbool.h> (bool é palavra-chave em C23);
- WMWritePropListToFile perdeu o terceiro argumento;
- comparação de string com strcmp e fim de dois casos de UB (++x em x = ...);
- se a fonte Helvetica do X não existir, usa "fixed" em vez de sair;
- corrige o teste da cor da legenda (gcc1 -> gcc2).

Upstream: mountapp 3.0 (SourceForge), sem manutenção; sem PR.

diff --git a/configure.in b/configure.in
index e9eaa3d..b5c122f 100644
--- a/configure.in
+++ b/configure.in
@@ -101,26 +101,14 @@ dnl =====================================================
 dnl        Check for libWINGs (replaces libPropList)
 dnl =====================================================
 
-AC_CHECK_LIB(WINGs, WMGetFromPLString,
-    [LIBPL_LIBS=-lWINGs LIBPL_INC_PATH="" missing=no],
-    [missing=yes])
-
-if test "$missing" = yes; then
-    echo "********** WARNING *************"
-    echo "libWINGs is not installed in your system."
-    echo "You need to build it before building mount.app (if you already"
-    echo "did that, remove config.cache and rerun configure)."
-    echo "Please read the INSTALL file for detailed instructions."
-    read foo
-fi
+dnl As funções de PropList (WMGetFromPLString etc.) ficam na libWUtil.
+AC_CHECK_LIB(WUtil, WMGetFromPLString,
+    [LIBPL_LIBS=-lWUtil LIBPL_INC_PATH=""],
+    [AC_MSG_ERROR([libWUtil (Window Maker) is required to build mount.app])])
 
 AC_SUBST(LIBPL_LIBS)
 AC_SUBST(LIBPL_INC_PATH)
 
-GTK_LIBS=`gtk-config --libs`
-GTK_CFLAGS=`gtk-config --cflags`
-AC_SUBST(GTK_LIBS)
-AC_SUBST(GTK_CFLAGS)
 
 if test "${prefix}" = "NONE"; then
 	prefix=/usr/local
