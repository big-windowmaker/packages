+/* libcpufreq had cpufreq_cpu_exists(); its successor libcpupower does not.
+ * Same contract: 0 when the CPU has a cpufreq directory in sysfs. */
+static int cpufreq_cpu_exists(unsigned int cpu)
+{
+   char path[64];
+   snprintf(path, sizeof(path), "/sys/devices/system/cpu/cpu%u/cpufreq", cpu);
+   return access(path, F_OK) == 0 ? 0 : -1;
+}
