--- a/wmnet/wmnet.c
+++ b/wmnet/wmnet.c
@@ -393,7 +393,9 @@ void setup_wmnet(int argc, char **argv) {
 	}
 
 	/* usleep() in between polls to /proc/net/ip_acct */
-	if (delayTime <= 0) delayTime = 25000;
+	/* 10 reads per second: the arrows still blink with the traffic and an idle
+	 * wmnet stays close to 0% CPU (it was 40 reads per second) */
+	if (delayTime <= 0) delayTime = 100000;
 
 	/* Setup the X windows, GC's, initial states, etc */
 	setupX();
