# Big WindowMaker: OneStepBack-Dark no GTK 2 (gtk-2.0/gtkrc). No GTK 2 o
# black_color só é usado como cor de texto; o relevo vem do motor, a partir
# do fundo.
s/^lighter_color:#eeeeee$/lighter_color:#2e2e2e/
s/^base_color:#aaaaaa$/base_color:#3c3c3c/
s/^darker_color:#888888$/darker_color:#686868/
s/^black_color:#000000$/black_color:#e0e0e0/
s/^gtk-color-scheme = "button_selected_bg_color:#707070$/gtk-color-scheme = "button_selected_bg_color:#2a2a2a/
s/^menuitem_selected_bg_color:#\(eeeeee\|ffffff\)$/menuitem_selected_bg_color:#a8a8a8/
