diff --git a/Netscape4/chrome/bookmarkpanel.css b/Netscape4/chrome/bookmarkpanel.css
index 9aea371..61d179b 100644
--- a/Netscape4/chrome/bookmarkpanel.css
+++ b/Netscape4/chrome/bookmarkpanel.css
@@ -1,3 +1,7 @@
+/* Firefox 158: the html| selectors below need this namespace (it was
+ * missing, so those rules were dropped). */
+@namespace html url("http://www.w3.org/1999/xhtml");
+
 /* Bookmark panel ui */
 
 #editBookmarkPanel {
@@ -144,3 +148,43 @@ menupopup,
 
 
 
+
+/* Firefox 158: the panel inputs and the footer buttons (.footer-button in a
+ * moz-button-group) replaced #editBookmarkPanelRows/BottomButtons. */
+#editBookmarkPanel input,
+#editBookmarkPanel menulist {
+  border-radius: 0px !important;
+  border: 1px solid var(--border_bg) !important;
+  outline: none !important;
+  box-shadow: none !important;
+  background-color: var(--input_bg) !important;
+  color: var(--input_fg) !important;
+}
+
+#editBookmarkPanel menulist {
+  background-color: var(--button_bg) !important;
+}
+
+#editBookmarkPanel .footer-button,
+#editBookmarkPanel .panel-button {
+  min-height: 24px !important;
+  background: var(--button_bg) !important;
+  color: var(--button_fg) !important;
+  font-weight: normal !important;
+  outline: none !important;
+  border-radius: 0px !important;
+  padding: 2px 8px !important;
+  border: 3px solid !important;
+  border-image: url("image/toolbarbutton.png") 3 !important;
+}
+
+#editBookmarkPanel .footer-button:hover:active,
+#editBookmarkPanel .panel-button:hover:active {
+  border-image: url("image/toolbarbutton_pressed.png") 3 !important;
+}
+
+#editBookmarkPanel .footer-button:focus-visible,
+#editBookmarkPanel .footer-button[default] {
+  outline: 1px dotted var(--border_bg) !important;
+  outline-offset: -5px !important;
+}
