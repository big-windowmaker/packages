diff --git a/Netscape4/chrome/menus.css b/Netscape4/chrome/menus.css
new file mode 100644
index 0000000..adff48b
--- /dev/null
+++ b/Netscape4/chrome/menus.css
@@ -0,0 +1,68 @@
+/* Menus and context menus (new in the Firefox 158 port).
+ * Firefox takes the menu colors from the system (Menu, -moz-menuhover) and
+ * follows the dark mode; give them the flat light Netscape look instead. */
+
+menupopup,
+panel[type="arrow"],
+#widget-overflow,
+#appMenu-popup,
+#unified-extensions-panel {
+  color-scheme: light !important;
+  --panel-background-color: var(--menu_bg) !important;
+  --panel-text-color: var(--menu_fg) !important;
+  --panel-border-color: var(--border_bg) !important;
+  --panel-border-radius: 0px !important;
+  --panel-box-shadow: none !important;
+  --panel-padding-block: 2px !important;
+  --menuitem-border-radius: 0px !important;
+  --menuitem-padding-block: 3px !important;
+  --panel-separator-color: var(--shadow_color) !important;
+  --arrowpanel-background: var(--menu_bg) !important;
+  --arrowpanel-color: var(--menu_fg) !important;
+  --arrowpanel-border-color: var(--border_bg) !important;
+  --arrowpanel-border-radius: 0px !important;
+  --panel-item-hover-bgcolor: var(--selected_bg) !important;
+  --panel-item-active-bgcolor: var(--selected_bg) !important;
+  --button-background-color-hover: var(--selected_bg) !important;
+  --background-color-list-item-hover: var(--selected_bg) !important;
+}
+
+menupopup::part(content) {
+  box-shadow: 1px 1px 0px var(--shadow_color), inset 1px 1px var(--light_color) !important;
+}
+
+menupopup menuitem,
+menupopup menu {
+  color: var(--menu_fg) !important;
+  border-radius: 0px !important;
+}
+
+menupopup :is(menuitem, menu)[_moz-menuactive]:not([disabled]) {
+  background-color: var(--selected_bg) !important;
+  color: var(--selected_fg) !important;
+}
+
+menupopup :is(menuitem, menu)[disabled] {
+  color: var(--disabled_fg) !important;
+  text-shadow: 1px 1px var(--light_color) !important;
+}
+
+menupopup :is(menuitem, menu)[_moz-menuactive][disabled] {
+  background-color: transparent !important;
+}
+
+menuseparator::before {
+  border-top-color: var(--shadow_color) !important;
+  border-bottom: 1px solid var(--light_color) !important;
+}
+
+/* Tooltips */
+tooltip {
+  color-scheme: light !important;
+  appearance: none !important;
+  background: #ffffe1 !important;
+  color: #000000 !important;
+  border: 1px solid #000000 !important;
+  border-radius: 0px !important;
+  box-shadow: none !important;
+}
